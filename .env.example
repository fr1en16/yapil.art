# ==========================================
# Yapil CRM — Supabase Configuration
# ==========================================

# URL вашего проекта Supabase (Project Settings -> API -> Project URL)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Публичный анонимный ключ (Project Settings -> API -> Project API keys -> anon / public)
PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# (Опционально) Сервисный ключ (service_role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# Telegram Bot Notifications (Опционально)
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# Sanity CMS — кейсы и «Всячина», Studio на /admin
# ==========================================
PUBLIC_SANITY_PROJECT_ID=j2cx2dtx
PUBLIC_SANITY_DATASET=production
# Write-токен для scripts/migrate-to-sanity.mjs (создать в sanity.io/manage → API → Tokens).
# В рантайме сайта и в Studio не используется, нужен только для одноразовой миграции контента.
SANITY_API_TOKEN=your_sanity_write_token

# ==========================================
# Vercel Web Analytics — /anal
# ==========================================
# Создайте access token: https://vercel.com/account/settings/tokens
VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
# На Vercel VERCEL_PROJECT_ID подставляется автоматически. Локально укажите ID вручную.
VERCEL_ANALYTICS_PROJECT_ID=prj_your_project_id
# Нужен только для проекта, принадлежащего команде.
VERCEL_ANALYTICS_TEAM_ID=team_your_team_id
# Basic Auth для закрытой страницы /anal.
ANALYTICS_USERNAME=yapil
ANALYTICS_PASSWORD=use_a_long_random_password
