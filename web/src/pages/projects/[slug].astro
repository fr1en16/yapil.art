---
import WebLayout from '../../layouts/WebLayout.astro';
import { projects } from '../../data/site';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item=>item.slug===project.slug)+1)%projects.length];
---
<WebLayout title={`${project.name} — сайт от Yapil`} description={project.summary} image={project.image}>
  <article class="inner-page">
    <div class="inner-hero"><a class="breadcrumb" href="/#works">← Все проекты</a><h1>{project.name}</h1><p>{project.format} · {project.year}<br />{project.summary}</p></div>
    <img class="case-hero-image" src={project.image} alt={project.imageAlt} width="1600" height="1200" fetchpriority="high" />
    <section class="case-overview"><h2>Задача</h2><p>{project.task}</p></section>
    <section class="case-overview"><h2>Что сделали</h2><p>{project.work}</p></section>
    {project.gallery.length>0&&<div class="case-gallery">{project.gallery.map(image=><img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}</div>}
    <section class="case-overview"><h2>Результат</h2><div><p>{project.result}</p><a class="text-link" style="margin-top:28px" href={`https://yapil.art/case/${project.slug}`}>Полный кейс на Yapil <span aria-hidden="true">↗</span></a></div></section>
    <div class="case-more"><a class="text-link" href={`/projects/${next.slug}`}>Следующий проект: {next.name} <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact">Обсудить похожую задачу <span aria-hidden="true">↗</span></a></div>
  </article>
</WebLayout>
