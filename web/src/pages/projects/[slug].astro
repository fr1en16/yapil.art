---
import WebLayout from '../../layouts/WebLayout.astro';
import { projects } from '../../data/site';
import '../../styles/inner.css';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item=>item.slug===project.slug)+1)%projects.length];
---
<WebLayout title={`${project.name} — сайт от Yapil`} description={project.summary} image={project.image}>
  <article class="case-page">
    <header class="case-cover-hero" aria-labelledby="case-title">
      <div class="case-cover" data-parallax><img src={project.image} alt={project.imageAlt} width="1440" height="1152" fetchpriority="high" decoding="async" /></div>
      <a class="breadcrumb" href="/#works">← Все проекты</a>
      <div class="case-heading" data-stagger><h1 id="case-title" data-reveal>{project.name}</h1><p data-reveal>{project.summary}</p></div>
      <a class="case-scroll" href="#case-task" aria-label="О задаче проекта"><span aria-hidden="true">↓</span></a>
    </header>
    <div class="case-facts" data-stagger><p data-reveal>{project.format}</p><p data-reveal>{project.year}</p><a class="text-link" href={`https://yapil.art/case/${project.slug}`} data-reveal>Полный кейс на Yapil <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact" data-reveal>Обсудить похожую задачу <span aria-hidden="true">↗</span></a></div>
    <section class="case-story case-task" id="case-task" aria-labelledby="task-title"><h2 id="task-title" data-reveal>Задача</h2><div class="story-copy" data-reveal><p>{project.task}</p></div></section>
    <section class="case-story case-work" aria-labelledby="work-title"><h2 id="work-title" data-reveal>Что сделали</h2><div class="story-copy" data-reveal><p>{project.work}</p></div></section>
    {project.gallery.length>0&&<div class="case-gallery-editorial">{project.gallery.map((image,i)=><figure class:list={['case-gallery-frame', { 'is-secondary': i > 0 }]} data-reveal="image"><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></figure>)}</div>}
    <section class="case-story case-result inner-surface" aria-labelledby="result-title" data-theme="light"><h2 id="result-title" data-reveal>Результат</h2><div class="story-copy" data-reveal><p>{project.result}</p><a class="text-link" href={`https://yapil.art/case/${project.slug}`}>Полный кейс на Yapil <span aria-hidden="true">↗</span></a></div></section>
    <section class="case-next inner-surface" aria-label="Следующий проект" data-theme="light"><a class="next-project" href={`/projects/${next.slug}`} data-reveal><div class="next-project-image"><img src={next.image} alt={next.imageAlt} width="900" height="675" loading="lazy" decoding="async" /></div><div class="next-project-copy"><h2>{next.name}</h2><p>{next.summary}</p><span class="text-link">Смотреть проект <span aria-hidden="true">↗</span></span></div></a></section>
    <section class="case-cta" aria-labelledby="case-cta-title"><h2 id="case-cta-title" data-reveal>Что должен<br>делать ваш сайт?</h2><div data-reveal><p>Расскажите о задаче. Вместе определим формат, объём работ и первый шаг.</p><a class="button" href="/contact"><span class="button-symbol" aria-hidden="true">↗</span><span>Обсудить похожую задачу</span></a></div></section>
  </article>
</WebLayout>
