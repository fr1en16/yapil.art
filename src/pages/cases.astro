---
import Base from '../layouts/Base.astro';
import CaseGrid from '../components/CaseGrid.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';

const casesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Кейсы и портфолио дизайн-студии Yapil',
      description: 'Портфолио проектов дизайн-студии Yapil: разработка сайтов, фирменный стиль, айдентика, упаковка и полиграфия для Puma, Cadillac, Dodo Pizza, Lukoil, УАЗ и др.',
      url: 'https://yapil.art/cases',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Главная',
          item: 'https://yapil.art',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Кейсы',
          item: 'https://yapil.art/cases',
        },
      ],
    },
  ],
};
---

<Base
  title="Кейсы и портфолио проектов"
  description="Портфолио проектов дизайн-студии Yapil: разработка сайтов, брендинг, упаковка и полиграфия для бизнеса. 8+ лет опыта, более 24 реализованных проектов."
  jsonLd={casesJsonLd}
>
  <CaseGrid pageHeading />
  <Contacts theme="light" title="Хотите обсудить проект?" sourceDetails="Страница Все кейсы" gradientToDark />
  <Footer slot="footer" />
</Base>
