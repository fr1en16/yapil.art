---
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProduxPortfolio from '../components/ProduxPortfolio.astro';
import VsyachinaInfinite from '../components/VsyachinaInfinite.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import AboutCompact from '../components/AboutCompact.astro';
import Founder from '../components/Founder.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';

const homePageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://yapil.art/#website',
      name: 'Яков Пилипюк',
      url: 'https://yapil.art',
      inLanguage: 'ru',
      publisher: {
        '@id': 'https://yapil.art/#person',
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://yapil.art/#person',
      name: 'Яков Пилипюк',
      alternateName: 'Yapil',
      url: 'https://yapil.art',
      image: 'https://media.yapil.art/me.d04a3d1afc9c1316.webp?v=2',
      jobTitle: 'Дизайнер',
      description: 'Я — дизайнер Яков Пилипюк: разрабатываю сайты, создаю айдентику, делаю брендинг, полиграфию, презентации и веду дизайн-сопровождение для бизнеса.',
      email: 'hi@yapil.art',
      telephone: '+77067436197',
      sameAs: [
        'https://t.me/yakov_pil',
        'https://wa.me/77067436197',
      ],
      knowsAbout: [
        'Веб-дизайн',
        'Разработка сайтов на Astro и React',
        'Айдентика',
        'Брендинг',
        'Полиграфия',
        'Дизайн упаковки',
        'SMM',
        'Дизайн презентаций',
        'Pitch Deck',
        'Дизайн-сопровождение',
      ],
      areaServed: ['KZ', 'UZ', 'RU', 'Worldwide'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Разработка сайтов под ключ',
              description: 'Проектирую структуру, рисую интерфейсы и быстро разрабатываю на Astro/React с оценкой PageSpeed 95+.',
              url: 'https://yapil.art/services/websites',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Айдентика и фирменный стиль',
              description: 'Логотипы, шрифтовые пары, фирменные цвета, гайдлайны и правила применения бренда.',
              url: 'https://yapil.art/services/identity',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Полиграфия и упаковка',
              description: 'Каталоги, меню, мерч, дизайн упаковки и допечатная подготовка макетов.',
              url: 'https://yapil.art/services/print',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Дизайн презентаций и Pitch Deck',
              description: 'Инвестиционные, партнерские и продающие презентации со структурой и визуализацией данных.',
              url: 'https://yapil.art/services/presentations',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Дизайн-сопровождение',
              description: 'Регулярная поддержка визуальных коммуникаций бренда по подписке без найма в штат.',
              url: 'https://yapil.art/services/support',
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Какие услуги вы предоставляете?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Я создаю сайты под ключ (Astro, React, Tailwind), разрабатываю айдентику и фирменный стиль, верстаю полиграфию и упаковку, проектирую инвест-презентации и веду абонентское дизайн-сопровождение.',
          },
        },
        {
          '@type': 'Question',
          name: 'Сколько времени занимает разработка проекта?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Сроки зависят от масштаба задачи: лендинги и презентации — от 1 до 3 недель; корпоративные сайты и айдентика — от 3 до 6 недель; комплексные системы — по согласованному спринт-плану.',
          },
        },
        {
          '@type': 'Question',
          name: 'Работаете ли вы официально по договору?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Да, работаю официально с заключением договора, поэтапной оплатой, актами выполненных работ и передачей всех исключительных прав на исходные материалы.',
          },
        },
      ],
    },
  ],
};
---

<Base
  title="Яков Пилипюк — дизайнер сайтов и айдентики | Yapil"
  description="Я Яков Пилипюк, дизайнер: разрабатываю сайты, создаю айдентику, брендинг и полиграфию для бизнеса — от первой концепции до релиза и печати."
  jsonLd={homePageJsonLd}
>
  <Hero
    title="Дизайн, который<br />работает на бизнес"
    description="Создаю сайты и айдентику, которые выделяют компанию среди конкурентов и приносят заявки."
  />
  <AboutCompact personal />
  <Services personal />
  <ProduxPortfolio />
  <VsyachinaInfinite />
  <ReviewsSlider />
  <Founder />
  <Contacts
    title="Нашли задачу,<br />похожую на вашу?"
    lead="Расскажите о задаче или заполните форму — отвечу в течение 2 часов и подготовлю предложение."
    successText="Спасибо за обращение. Изучу вашу задачу и отвечу в течение 2 часов."
    source="contacts_form"
    sourceDetails="Форма контактов на главной странице"
  />
  <Footer slot="footer" personal />
</Base>
