---
import OfferingDetailTemplate from '../../components/proposal/OfferingDetailTemplate.astro';
import { solutionsData, type SolutionData } from '../../data/solutionsData';

export function getStaticPaths() {
  return Object.values(solutionsData).map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

interface Props { solution: SolutionData; }
const { solution } = Astro.props;
const url = new URL(`/solutions/${solution.slug}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: solution.name, serviceType: solution.seo.h1, description: solution.seo.description, provider: { '@type': 'ProfessionalService', name: 'Yapil', url: 'https://yapil.art', telephone: '+77067436197', email: 'hi@yapil.art' }, areaServed: ['KZ', 'UZ', 'RU', 'Worldwide'], url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
      { '@type': 'ListItem', position: 2, name: 'Отраслевые решения', item: 'https://yapil.art/solutions' },
      { '@type': 'ListItem', position: 3, name: solution.name, item: url },
    ] },
    { '@type': 'FAQPage', mainEntity: solution.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
  ],
};
---

<OfferingDetailTemplate
  title={solution.seo.title}
  description={solution.seo.description}
  {jsonLd}
  section="solutions"
  slug={solution.slug}
  name={solution.name}
  heroH1={solution.heroH1}
  heroLead={solution.heroLead}
  metrics={solution.metrics}
  firstTitle={solution.challengesTitle}
  firstCards={solution.challenges.map((item) => ({ title: item.title, text: item.desc }))}
  secondTitle={solution.deliverablesTitle}
  secondCards={solution.deliverables}
  casesTitle={solution.casesTitle}
  caseSlugs={solution.caseSlugs}
  faqTitle={solution.faqTitle}
  faq={solution.faq}
  ctaTitle={solution.ctaTitle}
  ctaLead={solution.ctaLead}
/>
