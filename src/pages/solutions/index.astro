---
import OfferingIndexTemplate from '../../components/proposal/OfferingIndexTemplate.astro';
import { solutionsList } from '../../data/solutionsData';

const title = 'Отраслевые решения Yapil: сайты и брендинг для бизнеса';
const description = 'Сайты, айдентика и презентации с учётом специфики отрасли: рестораны, fashion, автобизнес, B2B, девелопмент, бьюти и онлайн-курсы.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Отраслевые решения дизайн-студии Yapil', description, url: 'https://yapil.art/solutions', provider: { '@type': 'ProfessionalService', name: 'Yapil', url: 'https://yapil.art' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
      { '@type': 'ListItem', position: 2, name: 'Отраслевые решения', item: 'https://yapil.art/solutions' },
    ] },
  ],
};
---

<OfferingIndexTemplate
  {title}
  {description}
  {jsonLd}
  section="solutions"
  heading="Отраслевые решения"
  lead="Упаковываем бизнес с учётом специфики, чеков и клиентского пути в вашей нише. Без типовых шаблонов — с опорой на реальный опыт и кейсы."
  items={solutionsList}
  catalogTitle="Решения по нишам"
  contactsTitle="Не нашли свою нишу?"
  contactsLead="Расскажите о задаче — изучим рынок, предложим проверенные решения и рассчитаем смету."
  source="contacts_form"
/>
