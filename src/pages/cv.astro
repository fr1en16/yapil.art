---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import ProduxPortfolio from '../components/ProduxPortfolio.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';

const skills = [
  ['Веб-дизайн', 'Web design'],
  ['Айдентика', 'Brand identity'],
  ['Брендинг', 'Branding'],
  ['Полиграфия', 'Print design'],
  ['Упаковка', 'Packaging'],
  ['Презентации', 'Presentations'],
  ['Дизайн-сопровождение', 'Design support'],
];

const cvJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Яков Пилипюк',
  alternateName: 'Yakov Pilipuk',
  url: 'https://yapil.art/cv',
  image: 'https://media.yapil.art/me.d04a3d1afc9c1316.webp?v=2',
  jobTitle: 'Multidisciplinary Designer',
  email: 'hi@yapil.art',
  knowsAbout: skills.map(([ru]) => ru),
};
---

<Base
  title="Яков Пилипюк — мультидисциплинарный дизайнер | CV"
  description="CV Якова Пилипюка: проекты, навыки, отзывы и форматы работы от $25 в час. Yakov Pilipuk’s CV: selected work, skills, testimonials and hourly rates."
  theme="light"
  navOverlay={true}
  jsonLd={cvJsonLd}
>
  <article class="cv" data-cv-lang="ru">
    <section class="cv-cover" aria-labelledby="cv-title">
      <div class="cv-cover-grid" aria-hidden="true"></div>
      <div class="container cv-cover-inner">
        <div class="cv-kicker">
          <span data-lang="ru">CV / 2026</span>
          <span data-lang="en">CV / 2026</span>
          <div class="language-switch" role="group" aria-label="Language / Язык">
            <button type="button" data-language="ru" aria-pressed="true">RU</button>
            <span aria-hidden="true">/</span>
            <button type="button" data-language="en" aria-pressed="false">EN</button>
          </div>
        </div>

        <div class="cv-title-wrap">
          <h1 id="cv-title">
            <span data-lang="ru">Яков Пилипюк</span>
            <span data-lang="en">Yakov Pilipuk</span>
          </h1>
        </div>

        <div class="cv-cover-bottom">
          <p class="cv-lead" data-lang="ru">Мультидисциплинарный дизайнер: от смысла и визуальной системы до готового цифрового или печатного продукта.</p>
          <p class="cv-lead" data-lang="en">Multidisciplinary designer working from strategy and visual systems through to finished digital and print products.</p>
          <dl class="cv-meta">
            <div><dt data-lang="ru">Ставка</dt><dt data-lang="en">Rate</dt><dd>$25 / h</dd></div>
            <div><dt data-lang="ru">Часовой пояс</dt><dt data-lang="en">Time zone</dt><dd>UTC+5</dd></div>
            <div><dt data-lang="ru">Формат</dt><dt data-lang="en">Format</dt><dd data-lang="ru">Удалённо</dd><dd data-lang="en">Remote</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <div class="cv-body">
      <section class="cv-section about" id="about">
        <header class="section-heading">
          <p class="section-number">01</p>
          <div>
            <h2 data-lang="ru">Обо мне</h2>
            <h2 data-lang="en">About</h2>
            <p class="section-intro" data-lang="ru">Восемь лет превращаю идеи в форму: сайты, айдентику, полиграфию, упаковку и презентации. Сам веду проект от структуры и концепции до разработки или подготовки к печати.</p>
            <p class="section-intro" data-lang="en">For eight years, I have turned ideas into websites, identities, print, packaging, and presentations. I lead projects from structure and concept through development or print production.</p>
          </div>
        </header>
        <div class="about-layout">
          <figure class="portrait">
            <img src="https://media.yapil.art/cover.6ccf4105e430af78.webp" alt="Яков Пилипюк / Yakov Pilipuk" width="640" height="800" loading="lazy" />
          </figure>
          <div class="about-note">
            <p data-lang="ru">Работаю с бизнесом, студиями и независимыми командами. Ценю ясные процессы, содержательную коммуникацию и решения, которые можно уверенно запустить.</p>
            <p data-lang="en">I work with businesses, studios, and independent teams. I value clear processes, thoughtful communication, and solutions that are ready to launch with confidence.</p>
            <a href="mailto:hi@yapil.art">hi@yapil.art</a>
          </div>
        </div>
      </section>
    </div>

    <ProduxPortfolio
      theme="light"
      seamless
      title="Избранные проекты"
      projectSlugs={['onmacabim', 'compass', 'rv', 'shanding', 'yatut', 'boya']}
    />

    <div class="cv-body">

      <section class="cv-section" id="skills">
        <header class="section-heading">
          <p class="section-number">03</p>
          <div><h2 data-lang="ru">Навыки</h2><h2 data-lang="en">Skills</h2></div>
        </header>
        <ol class="skills-list">
          {skills.map(([ru, en], index) => (
            <li><span>0{index + 1}</span><strong data-lang="ru">{ru}</strong><strong data-lang="en">{en}</strong></li>
          ))}
        </ol>
      </section>

      <section class="cv-section rates-section" id="rates">
        <header class="section-heading">
          <p class="section-number">04</p>
          <div>
            <h2 data-lang="ru">Ставка<br />и пакеты</h2>
            <h2 data-lang="en">Rate<br />and packages</h2>
            <p class="section-intro" data-lang="ru">Для разовых и регулярных задач. Пакет на 40 часов включает скидку $100.</p>
            <p class="section-intro" data-lang="en">For one-off and ongoing work. The 40-hour package includes a $100 discount.</p>
          </div>
        </header>
        <div class="rate-highlight">
          <div><p data-lang="ru">Почасовая ставка</p><p data-lang="en">Hourly rate</p><span data-lang="ru">Оплата по фактически затраченному времени</span><span data-lang="en">Billed for the time actually spent</span></div>
          <strong>$25 <small>/ h</small></strong>
        </div>
        <div class="package-list" role="table" aria-label="Hourly packages">
          <div class="package-row" role="row"><span>10 h</span><p data-lang="ru">10 часов</p><p data-lang="en">10 hours</p><strong>$250</strong></div>
          <div class="package-row" role="row"><span>20 h</span><p data-lang="ru">20 часов</p><p data-lang="en">20 hours</p><strong>$500</strong></div>
          <div class="package-row package-row--accent" role="row"><span>40 h</span><p data-lang="ru">40 часов · экономия $100</p><p data-lang="en">40 hours · save $100</p><strong>$900</strong></div>
        </div>
      </section>
    </div>

    <ReviewsSlider theme="light" />

    <div class="cv-body">

      <section class="cv-closing" id="brief">
        <p data-lang="ru">Есть задача?</p><p data-lang="en">Have a project?</p>
        <h2 data-lang="ru">Заполните<br />бриф</h2><h2 data-lang="en">Fill out<br />the brief</h2>
        <a class="brief-link" href="/brief"><span data-lang="ru">Выбрать услугу</span><span data-lang="en">Choose a service</span><span aria-hidden="true">→</span></a>
      </section>
    </div>
  </article>
  <Footer slot="footer" theme="light" personal />
</Base>

<script>
  const cv = document.querySelector<HTMLElement>('[data-cv-lang]');
  const languageButtons = document.querySelectorAll<HTMLButtonElement>('[data-language]');

  const setLanguage = (language: 'ru' | 'en') => {
    if (!cv) return;
    cv.dataset.cvLang = language;
    document.documentElement.lang = language;
    languageButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.language === language));
    });
  };

  languageButtons.forEach((button) => {
    button.addEventListener('click', () => setLanguage(button.dataset.language === 'en' ? 'en' : 'ru'));
  });
</script>

<style>
  :global(body.theme-light) { background: #f5f1e9; }
  :global(body.theme-light .site-footer.theme-light) { background: #f5f1e9; }

  .cv {
    --paper: #f5f1e9;
    --ink: #171717;
    --muted: #6d6963;
    --line: rgba(23, 23, 23, 0.18);
    color: var(--ink);
  }

  .cv [data-lang='en'] { display: none; }
  .cv[data-cv-lang='en'] [data-lang='ru'] { display: none; }
  .cv[data-cv-lang='en'] [data-lang='en'] { display: revert; }

  .cv-cover { position: relative; min-height: 100svh; overflow: hidden; color: #fff8f2; }
  .cv-cover-grid { position: absolute; inset: 0; opacity: .34; background-image: linear-gradient(rgba(255,255,255,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px); background-size: 25% 25%; mask-image: linear-gradient(to bottom,#000 0%,transparent 92%); }
  .cv-cover-inner { position: relative; z-index: 1; display: grid; grid-template-rows: auto 1fr auto; min-height: 100svh; padding-block: 7.5rem 2rem; }
  .cv-kicker { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,.5); font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .language-switch { display: flex; align-items: center; gap: .45rem; }
  .language-switch button { padding: .35rem .2rem; border: 0; color: inherit; background: transparent; font: inherit; opacity: .45; cursor: pointer; }
  .language-switch button[aria-pressed='true'] { opacity: 1; text-decoration: underline; text-underline-offset: .3em; }
  .cv-title-wrap { align-self: center; display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); padding-block: clamp(4rem,12vh,8rem); }
  .cv-cover h1 { grid-column: 1 / 13; margin: 0; font-family: var(--font-display); font-size: clamp(2.5rem,8.4vw,8.2rem); font-weight: 400; line-height: .86; letter-spacing: -.055em; text-transform: uppercase; }
  .cv-cover h1 span { display: block; white-space: nowrap; }
  .cv[data-cv-lang='en'] .cv-cover h1 span[data-lang='en'] { display: block; }
  .cv-cover-bottom { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); align-items: end; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.5); }
  .cv-lead { grid-column: 1 / 8; max-width: 42rem; margin: 0; font-size: clamp(1.15rem,2vw,1.75rem); line-height: 1.08; letter-spacing: -.035em; }
  .cv-meta { grid-column: 9 / 13; margin: 0; }
  .cv-meta div { display: flex; justify-content: space-between; gap: 2rem; padding: .35rem 0; border-bottom: 1px solid rgba(255,255,255,.25); }
  .cv-meta dt,.cv-meta dd { margin: 0; font-size: .8rem; }
  .cv-meta dt { opacity: .65; }

  .cv-body { position: relative; isolation: isolate; width: min(calc(100% - var(--container-inline-space)),var(--container-max)); margin-inline: auto; background: var(--paper); }
  .cv-body::before { content: ''; position: absolute; z-index: -1; inset-block: 0; left: 50%; width: 100vw; background: var(--paper); transform: translateX(-50%); }
  .cv-section { padding: clamp(5rem,9vw,9rem) 0; border-bottom: 1px solid var(--line); scroll-margin-top: 5rem; }
  .section-heading { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); margin-bottom: clamp(3.5rem,7vw,7rem); }
  .section-number { grid-column: 1; margin: 0; color: #fd4b32; font-size: .75rem; letter-spacing: .04em; }
  .section-heading > div { grid-column: 2 / 12; }
  .section-heading h2,.cv-closing h2 { margin: 0; font-family: var(--font-display); font-size: clamp(3rem,7.3vw,7.5rem); font-weight: 400; line-height: .9; letter-spacing: -.045em; }
  .section-intro { max-width: 46rem; margin: clamp(2rem,4vw,3.5rem) 0 0; font-size: clamp(1.15rem,1.85vw,1.65rem); line-height: 1.18; letter-spacing: -.035em; }

  .about-layout { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); align-items: end; }
  .portrait { grid-column: 2 / 6; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: #e3ddd5; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.15); }
  .about-note { grid-column: 8 / 12; padding-bottom: 1rem; }
  .about-note p { margin: 0 0 2rem; color: var(--muted); font-size: clamp(1rem,1.5vw,1.3rem); line-height: 1.4; }
  .about-note a { color: inherit; text-decoration-color: #fd4b32; text-underline-offset: .3em; }

  .skills-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .skills-list li { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); align-items: center; min-height: 7rem; border-bottom: 1px solid var(--line); }
  .skills-list span { grid-column: 1; color: #fd4b32; font-size: .75rem; }
  .skills-list strong { grid-column: 2 / 13; font-family: var(--font-display); font-size: clamp(1.45rem,2.4vw,2.1rem); font-weight: 400; }

  .rate-highlight { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); align-items: end; padding: clamp(1.5rem,3vw,2.5rem); color: #fff; background: #fd4b32; }
  .rate-highlight > div { grid-column: 1 / 7; }
  .rate-highlight > strong { grid-column: 7 / 13; text-align: right; font-size: clamp(2.5rem,6vw,5.5rem); line-height: .85; letter-spacing: -.06em; }
  .rate-highlight p { margin: 0 0 .35rem; font-size: clamp(1.25rem,2.2vw,2rem); font-weight: 600; letter-spacing: -.04em; }
  .rate-highlight span { font-size: .85rem; opacity: .75; }
  .rate-highlight small { font-size: .3em; letter-spacing: 0; }
  .package-list { margin-top: 1rem; border-top: 1px solid var(--ink); }
  .package-row { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); column-gap: var(--grid-gap); align-items: center; min-height: 7rem; padding-inline: 1.5rem; border-bottom: 1px solid var(--line); }
  .package-row > span { grid-column: 1 / 3; color: var(--muted); font-size: .8rem; }
  .package-row > p { grid-column: 3 / 9; margin: 0; font-size: clamp(1.15rem,2vw,1.65rem); }
  .package-row > strong { grid-column: 9 / 13; text-align: right; font-size: clamp(1.5rem,3vw,2.7rem); }
  .package-row--accent strong { color: #fd4b32; }

  .cv-closing { padding: clamp(6rem,12vw,12rem) 0; }
  .cv-closing > p { margin: 0 0 2rem; color: #fd4b32; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .brief-link { display: flex; justify-content: space-between; align-items: center; margin-top: clamp(3rem,7vw,7rem); padding: 1.5rem 0; border-block: 1px solid var(--ink); color: inherit; font-size: clamp(1.1rem,2vw,1.5rem); text-decoration: none; transition: padding 220ms ease,color 220ms ease,background 220ms ease; }
  .brief-link:hover,.brief-link:focus-visible { padding-inline: 1.5rem; color: #fff; background: #fd4b32; outline-offset: 4px; }

  @media (max-width: 56rem) {
    .cv-cover-inner { padding-top: 6.5rem; }
    .cv-cover-bottom { display: flex; flex-direction: column; align-items: stretch; gap: 2.5rem; }
    .cv-meta { width: 100%; }
    .cv-body { width: min(calc(100% - 2rem),100rem); }
    .portrait { grid-column: 1 / 6; }
    .about-note { grid-column: 7 / 13; }
  }

  @media (max-width: 40rem) {
    .cv-cover h1 { font-size: clamp(2.5rem,12vw,4rem); }
    .cv-title-wrap { display: block; }
    .cv-cover-bottom { gap: 1.5rem; }
    .section-heading { display: block; }
    .section-number { margin-bottom: 2rem; }
    .about-layout { display: block; }
    .portrait { width: min(80%,22rem); margin-bottom: 2.5rem; }
    .skills-list li { grid-template-columns: 2.75rem minmax(0,1fr); min-height: 5.5rem; }
    .skills-list span { grid-column: 1; }
    .skills-list strong { grid-column: 2; }
    .rate-highlight { display: flex; flex-direction: column; align-items: stretch; gap: 3rem; }
    .rate-highlight > strong { text-align: left; }
    .package-row { grid-template-columns: 4rem 1fr auto; padding-block: 1.25rem; }
    .package-row > span { grid-column: 1; }
    .package-row > p { grid-column: 2; }
    .package-row > strong { grid-column: 3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brief-link { transition: none; }
  }
</style>
