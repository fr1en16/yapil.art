---
const image1 = { src: "https://media.yapil.art/assets/shanding-3d/1.6d596ee5dd3704d0.webp" };
const image2 = { src: "https://media.yapil.art/assets/shanding-3d/2.fba38dda0745eb70.webp" };
const image3 = { src: "https://media.yapil.art/assets/shanding-3d/3.cf0d6dce33f4b3e9.webp" };
const image4 = { src: "https://media.yapil.art/assets/shanding-3d/4.c881eb792f6cc050.webp" };
const image5 = { src: "https://media.yapil.art/assets/shanding-3d/5.8a3176ebcb653b2d.webp" };
const image6 = { src: "https://media.yapil.art/assets/shanding-3d/6.bf9d847d5fdcfbab.webp" };
const image7 = { src: "https://media.yapil.art/assets/shanding-3d/7.3c3ab9e1b395d0d9.webp" };
const image8 = { src: "https://media.yapil.art/assets/shanding-3d/8.3a0910189b5776a1.webp" };
const image9 = { src: "https://media.yapil.art/assets/shanding-3d/9.a13ddea98866a1c2.webp" };
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>3D-превью стенда Shanding</title>
    <meta
      name="description"
      content="Интерактивное 3D-превью оформления выставочного стенда Shanding."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Golos+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="viewport" data-viewport>
      <div class="artboard-shell" data-shell>
        <div class="artboard" data-artboard>
          <div class="stand" data-stand>
            <div class="wall-depth wall-depth--back"></div>
            <div class="wall wall--back">
              <div class="panels">
                <div class="panel"><img src={image4.src} alt="" draggable="false" /></div>
                <div class="panel"><img src={image5.src} alt="" draggable="false" /></div>
                <div class="panel panel--wide"><img src={image6.src} alt="" draggable="false" /></div>
              </div>
            </div>

            <div class="wall-depth wall-depth--side"></div>
            <div class="wall wall--side">
              <div class="panels">
                <div class="panel"><img src={image1.src} alt="" draggable="false" /></div>
                <div class="panel"><img src={image2.src} alt="" draggable="false" /></div>
                <div class="panel panel--wide"><img src={image3.src} alt="" draggable="false" /></div>
              </div>
            </div>

            <div class="wall-depth wall-depth--right"></div>
            <div class="wall wall--right">
              <div class="panels">
                <div class="panel"><img src={image7.src} alt="" draggable="false" /></div>
                <div class="panel"><img src={image9.src} alt="" draggable="false" /></div>
                <div class="panel panel--wide"><img src={image8.src} alt="" draggable="false" /></div>
              </div>
            </div>

            <div class="floor floor--light">
              <svg viewBox="0 0 28 22" aria-hidden="true"><polygon points="16,2 6,20 26,20"></polygon><polygon points="9,4 1,20 17,20"></polygon></svg>
            </div>
            <div class="floor floor--dark">
              <svg viewBox="0 0 28 22" aria-hidden="true"><polygon points="16,2 6,20 26,20"></polygon><polygon points="9,4 1,20 17,20"></polygon></svg>
            </div>
            <div class="edge edge--back"></div>
            <div class="edge edge--side"></div>
          </div>
        </div>
      </div>
      <button class="move-stick" type="button" data-move-stick aria-label="Стик движения">
        <span class="move-stick__knob" aria-hidden="true"></span>
      </button>
      <aside class="controls-hint" data-controls-hint aria-label="Управление камерой">
        <span class="controls-hint__desktop">
          <span><kbd>Клик</kbd> обзор 360°</span>
          <span><kbd>WASD</kbd> движение</span>
          <span><kbd>Shift</kbd> бег</span>
          <span><kbd>C</kbd> присесть</span>
          <span><kbd>Esc</kbd> освободить курсор</span>
        </span>
        <span class="controls-hint__mobile">
          <span>Стик — движение</span>
          <span>Свайп — обзор</span>
        </span>
      </aside>
      <div class="camera-edge-blur" aria-hidden="true"></div>
    </main>

    <script>
      const ARTBOARD_WIDTH = 1500;
      const ARTBOARD_HEIGHT = 1020;
      const INITIAL_ROTATION = { x: 0, y: 0 };
      const CAMERA_Z = 190;
      const WALK_SPEED = 112;
      const RUN_MULTIPLIER = 1.75;
      const CROUCH_MULTIPLIER = 0.55;
      const CROUCH_OFFSET = -72;
      const CAMERA_LIMITS = {
        x: 225,
        zMin: -220,
        zMax: 205,
      };

      const viewport = document.querySelector<HTMLElement>('[data-viewport]');
      const shell = document.querySelector<HTMLElement>('[data-shell]');
      const artboard = document.querySelector<HTMLElement>('[data-artboard]');
      const stand = document.querySelector<HTMLElement>('[data-stand]');
      const moveStick = document.querySelector<HTMLButtonElement>('[data-move-stick]');
      const controlsHint = document.querySelector<HTMLElement>('[data-controls-hint]');

      if (viewport && shell && artboard && stand) {
        let rotation = { ...INITIAL_ROTATION };
        let targetRotation = { ...INITIAL_ROTATION };
        let camera = { x: 0, z: 0 };
        let stickInput = { x: 0, y: 0 };
        let stickPointerId: number | null = null;
        let lookPointer: null | { pointerId: number; x: number; y: number } = null;
        let stepPhase = 0;
        let walkAmount = 0;
        let crouchAmount = 0;
        let previousTime = performance.now();
        const pressedKeys = new Set<string>();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
        const softenControlsHint = () => {
          if (controlsHint) controlsHint.dataset.engaged = 'true';
        };

        const renderCamera = (bobX = 0, bobY = 0) => {
          stand.style.transform = `translateZ(${CAMERA_Z}px) rotateX(${rotation.x}deg) rotateY(${rotation.y}deg) translate3d(${-camera.x + bobX}px, ${bobY}px, ${-camera.z}px)`;
        };

        const fitArtboard = () => {
          const scale = Math.min(window.innerWidth / ARTBOARD_WIDTH, window.innerHeight / ARTBOARD_HEIGHT);
          shell.style.width = `${ARTBOARD_WIDTH * scale}px`;
          shell.style.height = `${ARTBOARD_HEIGHT * scale}px`;
          artboard.style.transform = `scale(${scale})`;
        };

        const updateStick = (event: PointerEvent) => {
          if (!moveStick) return;
          const bounds = moveStick.getBoundingClientRect();
          const radius = bounds.width * 0.31;
          const dx = event.clientX - (bounds.left + bounds.width / 2);
          const dy = event.clientY - (bounds.top + bounds.height / 2);
          const distance = Math.hypot(dx, dy);
          const scale = distance > radius ? radius / distance : 1;
          const x = dx * scale;
          const y = dy * scale;

          stickInput = { x: x / radius, y: y / radius };
          moveStick.style.setProperty('--stick-x', `${x}px`);
          moveStick.style.setProperty('--stick-y', `${y}px`);
        };

        const releaseStick = (event: PointerEvent) => {
          if (!moveStick || event.pointerId !== stickPointerId) return;
          stickPointerId = null;
          stickInput = { x: 0, y: 0 };
          moveStick.style.setProperty('--stick-x', '0px');
          moveStick.style.setProperty('--stick-y', '0px');
          delete moveStick.dataset.active;
        };

        moveStick?.addEventListener('pointerdown', (event) => {
          event.preventDefault();
          softenControlsHint();
          stickPointerId = event.pointerId;
          moveStick.setPointerCapture(event.pointerId);
          moveStick.dataset.active = 'true';
          updateStick(event);
        });

        moveStick?.addEventListener('pointermove', (event) => {
          if (event.pointerId === stickPointerId) updateStick(event);
        });
        moveStick?.addEventListener('pointerup', releaseStick);
        moveStick?.addEventListener('pointercancel', releaseStick);

        viewport.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse') return;
          if (moveStick?.contains(event.target as Node)) return;
          softenControlsHint();
          lookPointer = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
          viewport.setPointerCapture(event.pointerId);
        });

        viewport.addEventListener('click', (event) => {
          if (!(event instanceof PointerEvent) || event.pointerType !== 'mouse') return;
          softenControlsHint();
          if (document.pointerLockElement !== viewport) viewport.requestPointerLock();
        });

        viewport.addEventListener('pointermove', (event) => {
          if (event.pointerType === 'mouse') {
            if (document.pointerLockElement === viewport) return;

            const normalizedX = event.clientX / window.innerWidth - 0.5;
            const normalizedY = event.clientY / window.innerHeight - 0.5;
            targetRotation.y = clamp(normalizedX * 124, -62, 62);
            targetRotation.x = clamp(normalizedY * -34, -17, 17);
            return;
          }

          if (!lookPointer || lookPointer.pointerId !== event.pointerId) return;
          const dx = event.clientX - lookPointer.x;
          const dy = event.clientY - lookPointer.y;
          targetRotation.y = clamp(targetRotation.y + dx * 0.2, -68, 68);
          targetRotation.x = clamp(targetRotation.x - dy * 0.16, -19, 19);
          lookPointer.x = event.clientX;
          lookPointer.y = event.clientY;
        });

        document.addEventListener('mousemove', (event) => {
          if (document.pointerLockElement !== viewport) return;
          targetRotation.y += event.movementX * 0.16;
          targetRotation.x = clamp(targetRotation.x - event.movementY * 0.13, -19, 19);
        });

        const finishLook = (event: PointerEvent) => {
          if (lookPointer?.pointerId === event.pointerId) lookPointer = null;
        };

        viewport.addEventListener('pointerup', finishLook);
        viewport.addEventListener('pointercancel', finishLook);

        window.addEventListener('keydown', (event) => {
          if (!['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyC', 'ArrowUp', 'ArrowLeft', 'ArrowDown', 'ArrowRight', 'ShiftLeft', 'ShiftRight'].includes(event.code)) return;
          event.preventDefault();
          softenControlsHint();
          pressedKeys.add(event.code);
        });

        window.addEventListener('keyup', (event) => {
          pressedKeys.delete(event.code);
        });

        window.addEventListener('blur', () => {
          pressedKeys.clear();
          stickInput = { x: 0, y: 0 };
          if (moveStick) {
            moveStick.style.setProperty('--stick-x', '0px');
            moveStick.style.setProperty('--stick-y', '0px');
            delete moveStick.dataset.active;
          }
        });

        const animate = (time: number) => {
          const delta = Math.min((time - previousTime) / 1000, 0.04);
          previousTime = time;

          const rotationEase = 1 - Math.exp(-delta * 11);
          rotation.x += (targetRotation.x - rotation.x) * rotationEase;
          rotation.y += (targetRotation.y - rotation.y) * rotationEase;

          let strafe = Number(pressedKeys.has('KeyD') || pressedKeys.has('ArrowRight')) - Number(pressedKeys.has('KeyA') || pressedKeys.has('ArrowLeft')) + stickInput.x;
          let forward = Number(pressedKeys.has('KeyW') || pressedKeys.has('ArrowUp')) - Number(pressedKeys.has('KeyS') || pressedKeys.has('ArrowDown')) - stickInput.y;
          const inputLength = Math.hypot(strafe, forward);
          const isCrouching = pressedKeys.has('KeyC');
          const isRunning = !isCrouching && (pressedKeys.has('ShiftLeft') || pressedKeys.has('ShiftRight'));

          if (inputLength > 1) {
            strafe /= inputLength;
            forward /= inputLength;
          }

          const yaw = rotation.y * Math.PI / 180;
          const speedMultiplier = isRunning ? RUN_MULTIPLIER : isCrouching ? CROUCH_MULTIPLIER : 1;
          const currentSpeed = WALK_SPEED * speedMultiplier;
          camera.x += (strafe * Math.cos(yaw) + forward * Math.sin(yaw)) * currentSpeed * delta;
          camera.z += (strafe * Math.sin(yaw) - forward * Math.cos(yaw)) * currentSpeed * delta;
          camera.x = clamp(camera.x, -CAMERA_LIMITS.x, CAMERA_LIMITS.x);
          camera.z = clamp(camera.z, CAMERA_LIMITS.zMin, CAMERA_LIMITS.zMax);

          const targetWalkAmount = inputLength > 0.04 ? 1 : 0;
          walkAmount += (targetWalkAmount - walkAmount) * (1 - Math.exp(-delta * 10));
          crouchAmount += (Number(isCrouching) - crouchAmount) * (1 - Math.exp(-delta * 12));
          if (targetWalkAmount) stepPhase += delta * (isRunning ? 10.4 : isCrouching ? 4.6 : 6.8);

          const bobStrength = isRunning ? 1.45 : isCrouching ? 0.45 : 1;
          const bobX = reduceMotion.matches ? 0 : Math.sin(stepPhase) * 1.15 * walkAmount * bobStrength;
          const bobY = CROUCH_OFFSET * crouchAmount + (reduceMotion.matches ? 0 : Math.sin(stepPhase * 2) * 2.3 * walkAmount * bobStrength);
          renderCamera(bobX, bobY);
          requestAnimationFrame(animate);
        };

        window.addEventListener('resize', fitArtboard);
        fitArtboard();
        renderCamera();
        requestAnimationFrame(animate);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --navy: #16305c;
    --floor-light: #eef0f3;
    --floor-dark: #c7cbd1;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #c9c5ba;
  }

  button,
  body {
    font-family: 'Golos Text', sans-serif;
  }

  button {
    -webkit-tap-highlight-color: transparent;
  }

  .viewport {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 62% 58% at 50% 34%, rgba(255, 255, 255, 0.92) 0%, rgba(245, 242, 234, 0.62) 38%, transparent 72%),
      radial-gradient(ellipse 48% 30% at 50% 91%, rgba(15, 38, 71, 0.18) 0%, rgba(15, 38, 71, 0.07) 42%, transparent 76%),
      radial-gradient(circle at 4% 45%, rgba(22, 48, 92, 0.14) 0%, transparent 38%),
      radial-gradient(circle at 96% 45%, rgba(22, 48, 92, 0.14) 0%, transparent 38%),
      linear-gradient(180deg, #c8c4ba 0%, #dfdbd1 43%, #d2cec4 68%, #b8b3aa 100%);
  }

  .artboard-shell {
    position: relative;
    flex: none;
  }

  .artboard {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1500px;
    height: 1020px;
    overflow: visible;
    background: transparent;
    touch-action: none;
    user-select: none;
    transform-origin: top left;
    perspective: 500px;
    perspective-origin: 750px 380px;
  }

  .camera-edge-blur {
    position: fixed;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 72% 88% at 50% 48%, transparent 58%, rgba(15, 38, 71, 0.035) 100%);
    -webkit-backdrop-filter: blur(1.5px);
    backdrop-filter: blur(1.5px);
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0%,
      rgba(0, 0, 0, 0.72) 9%,
      transparent 28%,
      transparent 72%,
      rgba(0, 0, 0, 0.72) 91%,
      #000 100%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      rgba(0, 0, 0, 0.72) 9%,
      transparent 28%,
      transparent 72%,
      rgba(0, 0, 0, 0.72) 91%,
      #000 100%
    );
  }

  .move-stick {
    --stick-x: 0px;
    --stick-y: 0px;
    position: fixed;
    z-index: 20;
    left: max(22px, env(safe-area-inset-left));
    bottom: max(24px, env(safe-area-inset-bottom));
    width: 112px;
    height: 112px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    background: rgba(15, 38, 71, 0.2);
    box-shadow:
      inset 0 0 0 10px rgba(255, 255, 255, 0.04),
      0 10px 34px rgba(15, 38, 71, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    touch-action: none;
  }

  .move-stick::before {
    content: '';
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
  }

  .move-stick__knob {
    position: absolute;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.74);
    box-shadow: 0 5px 18px rgba(15, 38, 71, 0.26);
    transform: translate3d(var(--stick-x), var(--stick-y), 0);
    transition: transform 140ms ease-out;
  }

  .move-stick[data-active='true'] .move-stick__knob {
    transition: none;
  }

  .controls-hint {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: max(18px, env(safe-area-inset-bottom));
    max-width: calc(100vw - 32px);
    padding: 9px 13px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(15, 38, 71, 0.5);
    box-shadow: 0 7px 24px rgba(15, 38, 71, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transform: translateX(-50%);
    transition: opacity 500ms ease;
    pointer-events: none;
    user-select: none;
  }

  .controls-hint[data-engaged='true'] {
    opacity: 0.24;
  }

  .controls-hint__desktop,
  .controls-hint__mobile {
    align-items: center;
    gap: 13px;
    white-space: nowrap;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
  }

  .controls-hint__desktop {
    display: flex;
  }

  .controls-hint__mobile {
    display: none;
  }

  .controls-hint kbd {
    margin-right: 4px;
    padding: 2px 5px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    font: inherit;
    font-weight: 600;
  }

  .stand {
    position: absolute;
    top: 202px;
    left: 440px;
    width: 620px;
    height: 600px;
    transform-style: preserve-3d;
    transform: translateZ(190px) rotateX(0deg) rotateY(0deg);
    transform-origin: 310px 178px 310px;
    will-change: transform;
  }

  .wall,
  .wall-depth,
  .floor,
  .edge {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  .wall,
  .wall-depth {
    width: 620px;
    height: 520px;
  }

  .wall-depth {
    background: #84898f;
  }

  .wall-depth--back {
    transform: translateZ(-4px);
  }

  .wall-depth--side {
    transform: translate3d(0, 0, 620px) rotateY(90deg) translateZ(-4px);
  }

  .wall-depth--right {
    transform: translate3d(620px, 0, 0) rotateY(-90deg) translateZ(-4px);
  }

  .wall {
    overflow: hidden;
    background: var(--navy);
    backface-visibility: hidden;
  }

  .wall--side {
    transform: translate3d(0, 0, 620px) rotateY(90deg);
  }

  .wall--right {
    transform: translate3d(620px, 0, 0) rotateY(-90deg);
  }

  .panels {
    width: 620px;
    height: 520px;
    display: flex;
  }

  .panel {
    width: 206px;
    height: 520px;
    overflow: hidden;
    flex: none;
  }

  .panel--wide {
    width: 208px;
  }

  .panel + .panel {
    border-left: 2px solid rgba(0, 0, 0, 0.22);
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.06);
  }

  .panel img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  .floor {
    width: 620px;
    height: 620px;
  }

  .floor svg {
    position: absolute;
    left: 230px;
    width: 160px;
  }

  .floor--light {
    background: linear-gradient(to bottom, var(--floor-dark), var(--floor-light));
    transform: translate3d(0, 520px, 0) rotateX(90deg);
  }

  .floor--light svg {
    top: 10px;
    opacity: 0.08;
    fill: var(--navy);
  }

  .floor--dark {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 62px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 62px),
      linear-gradient(155deg, #33383f 0%, #1b1e23 100%);
    transform: translate3d(0, 546px, 0) rotateX(-90deg);
  }

  .floor--dark svg {
    top: 230px;
    opacity: 0.07;
    fill: #fff;
  }

  .edge {
    width: 620px;
    height: 26px;
    background: linear-gradient(#9aa0a8, #7d838c);
  }

  .edge--back {
    transform: translate3d(0, 520px, 620px);
  }

  .edge--side {
    transform: translate3d(620px, 520px, 620px) rotateY(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .stand {
      will-change: auto;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .move-stick {
      display: flex;
    }

    .controls-hint {
      right: max(18px, env(safe-area-inset-right));
      bottom: max(31px, env(safe-area-inset-bottom));
      left: auto;
      padding: 9px 11px;
      transform: none;
    }

    .controls-hint__desktop {
      display: none;
    }

    .controls-hint__mobile {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      font-size: 10px;
    }
  }
</style>
