---
import ProposalTemplate from '../../components/proposal/ProposalTemplate.astro';

const scope = [
  { number: '01', title: 'Сетка и модуль', text: 'Одна логика построения на всех форматах, от 250 мл до канистры 20 кг. Позиция логотипа, зона названия, зона объёма, поле обязательного текста, отступы под высечку.' },
  { number: '02', title: 'Типографика', text: 'Заголовочный шрифт для названия продукта, текстовый для состава. Размерная шкала и правила для длинных названий на маленькой этикетке.' },
  { number: '03', title: 'Цветовое кодирование', text: 'Пять категорий, пять цветов. Плюс шкала оттенков под варианты внутри категории: ароматы полиролей, освежителей, сухого тумана. С Pantone и CMYK.' },
  { number: '04', title: 'Иерархия информации', text: 'Покупатель с двух метров видит категорию, с полуметра название, в руках состав. Порядок блоков на лице и обороте, место штрихкода, объёма, знаков и предупреждений.' },
  { number: '05', title: 'Работа с логотипом', text: 'Охранное поле, минимальный размер, версии под светлый и тёмный фон, поведение на разных пропорциях этикетки.' },
  { number: '06', title: 'Шаблоны в Illustrator', text: 'Готовые макеты под каждый типоразмер из вашей таблицы: 150×85, 120×110, 185×170 и остальные. С вылетами и метками под высечку.' },
  { number: '07', title: 'Документ с правилами', text: 'PDF на 15–25 страниц. По нему любой дизайнер соберёт новую этикетку без моего участия, и линейка сохранит единый вид.' },
  { number: '08', title: 'Две демонстрационные этикетки', text: 'Собираю по системе на реальных продуктах. Проверяем правила до запуска всей линейки.' },
];

const estimate = [
  { title: 'Система этикеток', note: 'Полный состав в разделе 01. Делаю один раз', quantity: '1', unit: '—', total: '250 000 – 400 000' },
  { title: 'Базовые дизайны', note: 'Отдельный продукт в системе: лицо и оборот, вёрстка названия, состава, инструкции, штрихкода и обязательных знаков. Файл готов к печати', quantity: '20', unit: '15 000 – 25 000', total: '300 000 – 500 000' },
  { title: 'Варианты по аромату и оттенку', note: 'Тот же дизайн, меняю название и цвет: POLISH PANEL, POLISH PRO, AROMATICA, сухой туман', quantity: '17', unit: '5 000 – 8 000', total: '85 000 – 136 000' },
  { title: 'Размерные адаптации', note: 'Перевёрстка готового дизайна под другой типоразмер: 1 / 5 / 10 / 20 кг', quantity: '32', unit: '5 000 – 7 000', total: '160 000 – 224 000' },
];

const stages = [
  { number: '01', title: 'Система и две демонстрационные этикетки', duration: '1–2 недели', payment: '50% предоплата' },
  { number: '02', title: 'Чернители и полироли', duration: '1–2 недели', payment: 'по факту этапа' },
  { number: '03', title: 'Шампуни и концентраты', duration: '1–2 недели', payment: 'по факту этапа' },
  { number: '04', title: 'Освежители, сухой туман, стёкла, химчистка', duration: '1–2 недели', payment: 'по факту этапа' },
];

const materials = [
  { title: 'Названия и состав по каждой позиции', note: 'Текст, который пойдёт на этикетку' },
  { title: 'Логотип в векторе', note: 'AI, EPS или SVG. Растр не подойдёт' },
  { title: 'Финальная таблица размеров этикеток', note: 'Ширина и высота по каждой таре' },
  { title: 'Требования типографии к макету', note: 'Вылеты, минимальный кегль, число красок, профиль цвета. Типография выдаёт списком. Нужны к началу второго этапа' },
];

const exclusions = [
  { title: 'Копирайтинг описаний и инструкций', note: 'Состав и инструкцию пишете вы или отдельный автор' },
  { title: 'Фотосъёмка продукта', note: 'Съёмка тары для этикетки и рекламы' },
  { title: 'Препресс и работа с типографией', note: 'Треппинг, оверпринт, спуск на рулон. Делает препресс-отдел типографии' },
  { title: 'Получение штрихкодов', note: 'EAN-13 компания покупает через GS1 Kazakhstan. Номера присылаете мне, я ставлю их в макет' },
];

const terms = [
  { title: 'Правки', text: 'Два круга на каждом этапе. Дальше по часовой ставке.' },
  { title: 'Исходники', text: 'Передаю после полной оплаты этапа.' },
  { title: 'Точность сметы', text: 'Назову точную сумму, когда подтвердите финальный список позиций. На присланных скриншотах часть таблицы обрезана.' },
  { title: 'Оплата', text: 'Безналичный расчёт, ИП. Договор и счёт после согласования объёма.' },
];
---

<ProposalTemplate
  title="Система этикеток для линейки автохимии"
  description="Коммерческое предложение Yapil по разработке системы этикеток для линейки автохимии."
  date="21.08.2026"
  proposalNumber="01"
  titleLines={['Система этикеток', 'для линейки автохимии']}
  lead="Один набор правил на 130 позиций. Покупатель видит на полке один бренд."
  client="Есбол"
  validUntil="20.09.2026"
  scopeIntro="Один раз задаём правила, дальше по ним собираю всю линейку. Правила держат 130 позиций в одном бренде."
  {scope}
  estimateIntro={[
    'Дизайнов меньше, чем позиций: один макет работает на несколько ароматов, оттенков и объёмов. Поэтому считаю по трём ставкам, а не по числу SKU.',
    'Ранее я называл 35–70к за отдельный продукт. Это цена разовой этикетки. В КП ставки ниже: все двадцать продуктов собираю по одной системе, это один проект вместо двадцати. По старой ставке те же двадцать макетов вышли бы в 700к–1,4 млн без адаптаций.',
  ]}
  {estimate}
  estimateSubtotal="795 000 – 1 260 000"
  packageLabel="Пакетом за всю линейку"
  packageNote="Работа однотипная, согласование одно"
  packageTotal="750 000 – 850 000 ₸"
  estimateFinePrint="Отдельный блок считаю по ставкам из таблицы."
  stagesIntro="Начинаю с системы и двух демо-этикеток, включая чернитель в большой таре. Дальше собираю линейку блоками. Каждый блок принимаете и оплачиваете отдельно."
  {stages}
  {materials}
  {exclusions}
  exclusionsNote="Любую из этих задач возьму отдельно, стоимость посчитаю по факту."
  {terms}
  closingTitle={['Соберём линейку', 'в одну систему.']}
/>
