---
import ProposalTemplate from '../../components/proposal/ProposalTemplate.astro';

const scope = [
  { number: '01', title: 'Баннер X-stand', text: 'Обновление списков клиентов, партнеров и фоновой иллюстрации на существующем макете. Контроль читаемости с дистанции прохода, предпечатная подготовка в CMYK.' },
  { number: '02', title: 'Концепция стенда', text: 'Разработка единой визуальной стилистики выставочной застройки на основе презентационных материалов компании.' },
  { number: '03', title: 'Учет конструктива', text: 'Анализ выставочного профиля, компенсация стыков панелей и «слепых зон» каркаса, чтобы важная информация и логотипы не перекрывались стойками.' },
  { number: '04', title: 'Иерархия ярусов', text: 'Верхний ярус для крупного брендинга над проходами, средний ярус — модельный ряд и преимущества на уровне глаз, чистый нижний ярус без критически важного текста.' },
  { number: '05', title: 'Вёрстка 6 панелей', text: 'Детальная проработка графики, фотоматериалов техники, текстовых акцентов и контактов на всех шести панелях стенда в едином стиле.' },
  { number: '06', title: 'Prepress 1:1', text: 'Подготовка широкоформатных файлов в масштабе 1:1 по техническим требованиям застройщика и типографии (цветовой профиль CMYK, вылеты под монтаж).' },
  { number: '07', title: 'Моушн-дизайн ТВ', text: 'Анимационный видеоряд для ТВ-панелей стенда: две смысловые сцены с динамичной презентацией техники и преимуществ.' },
  { number: '08', title: '2 языка и бесшовный луп', text: 'Две языковые версии ролика, адаптированные для непрерывного циклического воспроизведения на выставке без звука (Full HD / 4K 60fps).' },
];

const estimate = [
  { title: 'Корректировка баннера (X-stand)', note: 'Обновление списков клиентов, партнеров и фоновой графики. Prepress к печати', quantity: '1 макет', unit: '10 000', total: '10 000 ₸' },
  { title: 'Дизайн выставочного стенда', note: 'Разработка визуальной концепции (6 панелей) с учетом конструктива и слепых зон профиля. Подготовка к печати 1:1', quantity: '6 панелей', unit: '—', total: '136 000 ₸' },
  { title: 'Анимационный ролик', note: 'Моушн-графика для ТВ-панелей, две сцены, адаптация на двух языках, бесшовный луп', quantity: '1 ролик (2 версии)', unit: '30 000', total: '30 000 ₸' },
];

const stages = [
  { number: '01', title: 'Сбор материалов и аудит вводных', duration: '1 рабочий день', payment: '' },
  { number: '02', title: 'Концепция стенда и макет баннера', duration: '2–3 рабочих дня', payment: '' },
  { number: '03', title: 'Вёрстка всех 6 панелей и анимация', duration: '2–3 рабочих дня', payment: '' },
  { number: '04', title: 'Финальный препресс и сдача исходников', duration: '1 рабочий день', payment: '' },
];

const materials = [
  { title: 'Логотип в векторе', note: 'AI, EPS, SVG или векторный PDF' },
  { title: 'Материалы и презентация', note: 'Фотографии техники, списки клиентов и тексты' },
  { title: 'Тексты для двух языков', note: 'Для двух языковых версий анимационного ролика' },
  { title: 'Чертежи стенда и техтребования', note: 'Размеры панелей и требования к печати от застройщика' },
];

const exclusions = [
  { title: 'Физическое производство и монтаж', note: 'Печать, аренда конструкций и монтаж стенда' },
  { title: 'Копирайтинг и переводы', note: 'Написание текстов с нуля и языковой перевод' },
  { title: '3D-моделирование техники с нуля', note: 'Используются существующие фотоматериалы и рендеры' },
];

const terms = [
  { title: 'Правки', text: 'Два круга комплексных правок на этапе согласования. Дополнительные правки сверх согласованного объема тарифицируются по ставке 10 000 ₸/час.' },
  { title: 'Исходники', text: 'Готовые к печати файлы панелей (1:1 CMYK), файл баннера, видеофайлы MP4 (Full HD / 4K) и рабочие исходники передаются ссылкой на облачное хранилище.' },
  { title: 'Сроки', text: 'Общий срок реализации проекта составляет 5–8 рабочих дней с момента предоставления всех исходных материалов.' },
];
---

<ProposalTemplate
  title="Оформление выставочного стенда и промо-материалов для Shanding"
  description="Коммерческое предложение Yapil по дизайну выставочного стенда, баннера и анимационного ролика для Shanding."
  date="26.08.2026"
  proposalNumber="03"
  titleLines={['Выставочный стенд', 'и анимация Shanding']}
  lead="Комплексная подготовка визуальной составляющей выставочного пространства: мобильный баннер, 6 панелей стенда с учетом конструктива и динамичный промо-ролик для экранов."
  client="Shanding"
  validUntil="25.09.2026"
  scopeTitle={['Состав', 'проекта']}
  scopeIntro="Комплекс работ по оформлению стенда, мобильного баннера и созданию цикличной анимации для ТВ-экранов."
  {scope}
  estimateIntro={[
    'В смету входит разработка визуальной концепции и верстка 6 панелей стенда с учетом выставочного конструктива, корректировка баннера X-stand и создание анимационного промо-ролика на двух языках.',
  ]}
  {estimate}
  estimateSubtotal="176 000 ₸"
  packageLabel="Комплекс выставочных материалов"
  packageNote="Баннер + стенд 6 панелей + промо-анимация для ТВ"
  packageTotal="176 000 ₸"
  estimateFinePrint="Финальные макеты готовятся в масштабе 1:1 согласно техническим требованиям застройщика и типографии."
  stagesIntro="Работу ведем поэтапно: от согласования концепции ключевой панели до полной верстки всех элементов и предпечатной подготовки."
  {stages}
  {materials}
  {exclusions}
  exclusionsNote="Любую из дополнительных задач можно обсудить отдельно."
  {terms}
  closingTitle={['Подготовим яркий', 'и продуманный стенд.']}
/>
