---
import { mediaUrl, videoPoster } from '../../lib/media';
import { getCases, type SanityCase } from '../../lib/sanity';
import { renderCaseBody } from '../../lib/markdown';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import Base from '../../layouts/Base.astro';
import PdfSlider from '../../components/PdfSlider.astro';
import InstagramCarousels from '../../components/InstagramCarousels.astro';
import '../../styles/taxi-analytics.css';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

interface Props {
  c: SanityCase;
}

const { c } = Astro.props;
const bodyHtml = renderCaseBody(c.body);
const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(c.cover);
const poster = isVideo
  ? videoPoster(c.cover)
  : c.cover;
const ogImage = mediaUrl(`/open-graph/${c.slug}.png`);
const caseCoverUrl = c.cover.startsWith('http')
  ? c.cover
  : new URL(c.cover, Astro.site).href;
const metaDescriptionParts = [
  `Кейс ${c.title}: ${c.summary.replace(/[.!?]+$/, '')}.`,
  c.task?.replace(/[.!?]+$/, ''),
  `Услуги: ${c.services.join(', ')}.`,
  `Проект ${c.year} года из портфолио дизайн-студии Yapil.`,
  'Смотрите задачу, визуальное решение и материалы проекта.',
].filter(Boolean).join(' ');
const metaDescription = metaDescriptionParts.length <= 160
  ? metaDescriptionParts
  : `${metaDescriptionParts.slice(0, 157).replace(/\s+\S*$/, '')}…`;
const creativeWorkJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      headline: `${c.title} — ${c.summary}`,
      name: c.title,
      description: c.summary,
      dateCreated: c.year,
      image: caseCoverUrl,
      inLanguage: 'ru',
      keywords: c.services.join(', '),
      creator: {
        '@type': 'Organization',
        name: 'Yapil',
        url: 'https://yapil.art',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Yapil',
        url: 'https://yapil.art',
      },
      url: new URL(`/case/${c.slug}`, Astro.site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Главная',
          item: 'https://yapil.art',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Кейсы',
          item: 'https://yapil.art/cases',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: c.title,
          item: new URL(`/case/${c.slug}`, Astro.site).href,
        },
      ],
    },
  ],
};
---

<Base
  title={`${c.title} · ${c.services.join(' / ')}`}
  description={metaDescription}
  image={ogImage}
  type="article"
  jsonLd={creativeWorkJsonLd}
>
  <article class="case-page">
    <header class="case-hero container">
      <a class="back-link" href="/#cases">
        <span class="back-link-inner">
          <span class="back-link-arrow">←</span>
          <span class="back-link-text">Все кейсы</span>
        </span>
      </a>
      <div class="case-heading">
        <div>
          <h1>{c.title}</h1>
        </div>
        <p class="case-summary">{c.summary}</p>
      </div>
    </header>

    <div class="case-cover" data-parallax-media>
      <div class="case-cover-parallax" data-parallax-target>
        {isVideo ? (
          <>
            <img
              src={poster}
              alt={`${c.title} — ${c.summary}`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="case-cover-poster"
            />
            <video
              data-lazy-video
              data-src={c.cover}
              poster={poster}
              muted
              loop
              playsinline
              preload="none"
              aria-label={`${c.title}: видео обложки проекта`}
              class="case-cover-video"
            ></video>
          </>
        ) : c.cover.startsWith('/') ? (
          <img
            src={c.cover}
            alt={`${c.title} — ${c.summary}`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <img
            src={c.cover}
            alt={`${c.title} — ${c.summary}`}
            width="1600"
            height="1000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )}
      </div>
    </div>

    {(c.task || c.goal) && (
      <div class="case-brief container">
        {c.task && (
          <section aria-labelledby="task-title">
            <span>01</span>
            <h2 id="task-title">Задача</h2>
            <p>{c.task}</p>
          </section>
        )}
        {c.goal && (
          <section aria-labelledby="goal-title">
            <span>02</span>
            <h2 id="goal-title">Цель</h2>
            <p>{c.goal}</p>
          </section>
        )}
      </div>
    )}

    <div class="case-body container">
      <Fragment set:html={bodyHtml} />
      {c.slug === 'yatut' && <InstagramCarousels />}
      <PdfSlider />
    </div>

    <Contacts
      theme="light"
      title="Понравился проект?"
      source="case_inquiry"
      sourceDetails={`Кейс: ${c.title}`}
      gradientToDark
    />
  </article>
  <Footer slot="footer" />
</Base>

<script>
  import '../../scripts/taxi-analytics';
</script>

<style>
  .case-hero {
    padding-block: clamp(2rem, 7vw, 6rem);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: clamp(3rem, 8vw, 7rem);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    text-decoration: none;
    will-change: transform;
    transition:
      transform var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      color 200ms ease;
  }

  .back-link-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .back-link-arrow {
    display: inline-block;
    transition: transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18));
  }

  .back-link-text {
    display: inline-block;
    transition: transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18)) var(--delay-btn-text, 90ms),
                letter-spacing var(--duration-btn-text, 910ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)) var(--delay-btn-text, 90ms);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: #ffffff;
    transform: scale(1.04);
  }

  .back-link:hover .back-link-arrow,
  .back-link:focus-visible .back-link-arrow {
    transform: translateX(-3px) scale(1.15);
  }

  .back-link:hover .back-link-text,
  .back-link:focus-visible .back-link-text {
    letter-spacing: 0.02em;
  }

  .case-heading {
    display: grid;
    gap: 1.5rem clamp(3rem, 8vw, 10rem);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.065em;
    color: #ffffff;
    overflow-wrap: anywhere;
  }

  .case-summary {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 400;
    font-variation-settings: 'wght' 400;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.85);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .case-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--border-subtle);
  }

  @media (min-width: 48rem) {
    .case-cover {
      aspect-ratio: 5 / 4;
    }
  }

  .case-cover-parallax {
    position: absolute;
    inset: -14% 0;
    width: 100%;
    height: 128%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .case-cover-parallax :global(img),
  .case-cover-parallax img,
  .case-cover-parallax video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-cover-parallax video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .case-cover-parallax video.is-playing {
    opacity: 1;
  }

  .case-brief {
    display: grid;
    padding-block: clamp(4rem, 9vw, 9rem);
  }

  .case-brief section {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .case-brief section:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .case-brief span {
    grid-row: 1 / span 2;
    color: var(--accent-tint, #F7C8BF);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .case-brief h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1;
    color: #ffffff;
  }

  .case-brief p {
    max-width: 43rem;
    margin: 0;
    font-weight: 400;
    font-variation-settings: 'wght' 400;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.3;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .case-body {
    max-width: 54rem;
  }

  .case-body :global(:first-child) {
    margin-top: 0;
  }

  .case-body :global(p) {
    margin-bottom: 1.5rem;
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    font-weight: 400;
    font-variation-settings: 'wght' 400;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .case-body :global(h2) {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.035em;
  }

  .case-body :global(h3) {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.025em;
  }

  .case-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin-block: clamp(3rem, 6vw, 5rem);
  }

  .case-body :global(.media-grid) {
    display: grid;
    gap: 1.5rem;
    margin-block: 2.5rem;
  }

  .case-body :global(.taxi-dashboard) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 2rem 1.25rem;
  }

  .case-body :global(.taxi-metric) {
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 2.2vw, 1.75rem);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 0;
    background: rgba(35, 13, 8, 0.65);
    color: #fff;
  }

  .case-body :global(.taxi-metric-lead) {
    background: #ffce32;
    border-color: #ffce32;
    color: #23180b;
  }

  .case-body :global(.taxi-metric h3) {
    margin: 0 0 1.75rem;
    color: inherit;
    font-size: 1.6rem;
  }

  .case-body :global(.taxi-metric-value) {
    display: block;
    font-size: clamp(2.5rem, 4.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .case-body :global(.taxi-metric-value span) {
    font-size: 0.55em;
    margin-left: 0.12em;
  }

  .case-body :global(.taxi-metric-description) {
    display: block;
    margin-block: 0.8rem 1.5rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .case-body :global(.taxi-metric-breakdown) {
    display: grid;
    gap: 0.6rem;
    border-top: 1px solid currentColor;
    padding-top: 1rem;
    margin-top: auto;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .case-body :global(.taxi-metric-breakdown > span) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem;
  }

  .case-body :global(.taxi-results-note),
  .case-body :global(.taxi-results-details p) {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .case-body :global(.taxi-results-details) {
    border-block: 1px solid var(--border-subtle);
    padding-block: 1rem;
  }

  .case-body :global(.taxi-results-details summary) {
    cursor: pointer;
    font-size: 0.95rem;
    color: #fff;
  }

  .case-body :global(.taxi-results-details summary:focus-visible) {
    outline: 2px solid #ffce32;
    outline-offset: 5px;
  }

  .case-body :global(.taxi-results-details p) {
    margin: 1rem 0 0;
  }

  @media (max-width: 40rem) {
    .case-body :global(.taxi-dashboard) {
      grid-template-columns: 1fr;
    }
  }

  .case-body :global(.media-grid-2) {
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .case-body :global(.media-grid-2) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-body :global(figure) {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .case-body :global(figure img),
  .case-body :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border-subtle);
    background: var(--border-subtle);
  }

  .case-body :global(figcaption) {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.35;
  }

  .case-body :global(.video-container) {
    width: 100%;
    margin-block: 2.5rem;
    border: 1px solid var(--border-subtle);
    background: #000;
    overflow: hidden;
  }

  .case-body :global(video) {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 48rem) {
    .case-heading {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.55fr);
      align-items: end;
    }

    .case-brief {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 5vw, 6rem);
    }

    .case-brief section:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .back-link-arrow,
    .back-link-text {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
