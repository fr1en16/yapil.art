      alternateName: 'Yapil',
      url: 'https://yapil.art',
      jobTitle: 'Дизайнер',
      email: 'hi@yapil.art',
      telephone: '+77067436197',
      sameAs: ['https://t.me/yakov_pil', 'https://wa.me/77067436197'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
