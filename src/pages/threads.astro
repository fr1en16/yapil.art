---
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProduxPortfolio from '../components/ProduxPortfolio.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import AboutCompact from '../components/AboutCompact.astro';
import Founder from '../components/Founder.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';

const threadsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://yapil.art/#person',
      name: 'Яков Пилипюк',
      alternateName: 'Yapil',
      url: 'https://yapil.art',
      jobTitle: 'Дизайнер',
      email: 'hi@yapil.art',
      telephone: '+77067436197',
      sameAs: ['https://t.me/yakov_pil', 'https://wa.me/77067436197'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Сколько стоит проект?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Зависит от задачи: лендинг, айдентика и упаковка стоят по-разному. Присылаю смету после короткого созвона или переписки — точную, без “от” и без сюрпризов в процессе.',
          },
        },
        {
          '@type': 'Question',
          name: 'Сколько занимает разработка?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Лендинги и презентации — от 1 до 3 недель. Сайты и айдентика — от 3 до 6 недель. Срок фиксируется в договоре на старте.',
          },
        },
        {
          '@type': 'Question',
          name: 'Работаете официально?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Да: договор, поэтапная оплата, акты выполненных работ и передача исключительных прав на исходники после финального платежа.',
          },
        },
        {
          '@type': 'Question',
          name: 'Почему не студия, а один человек?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Проект от эскиза до релиза веду сам — без передачи между отделами и потери смысла на стыках. При этом есть опыт агентства thePeak: там я работал с LUKOIL, Cadillac, PUMA и Gippo, и оттуда — процессы, которые держат сроки.',
          },
        },
      ],
    },
  ],
};
---

<Base
  title="Заявка дизайнеру из Threads — Яков Пилипюк | Yapil"
  description="Пишете из Threads? Оставьте заявку — отвечаю в течение 2 часов лично. Сайты, айдентика, полиграфия и презентации под ключ."
  jsonLd={threadsJsonLd}
  noindex
>
  <section class="threads-badge">
    <div class="container threads-badge-inner">
      <span class="threads-badge-dot" aria-hidden="true"></span>
      <p>
        Вы&nbsp;из&nbsp;Threads&nbsp;— значит, уже видели, как я думаю о&nbsp;дизайне.
        Отвечаю на&nbsp;заявки лично, в&nbsp;течение 2&nbsp;часов.
      </p>
    </div>
  </section>

  <Hero
    title="Дизайн, который<br />работает на бизнес"
    description="Сайты, айдентика, упаковка и презентации, которые выделяют компанию среди конкурентов и приносят заявки — от первого эскиза до релиза или печати."
    casesHref="#cases"
  />

  <section class="trust-strip" aria-label="Опыт и цифры">
    <div class="container trust-strip-inner">
      <div class="trust-item">
        <span class="trust-number">8 лет</span>
        <span class="trust-label">в дизайне</span>
      </div>
      <div class="trust-item">
        <span class="trust-number">50+</span>
        <span class="trust-label">завершённых проектов</span>
      </div>
      <div class="trust-item">
        <span class="trust-number">2 часа</span>
        <span class="trust-label">на ответ по заявке</span>
      </div>
      <div class="trust-item">
        <span class="trust-number">1</span>
        <span class="trust-label">дизайнер ведёт проект от идеи до релиза</span>
      </div>
    </div>
    <p class="trust-footnote">
      Опыт агентства thePeak — работал над визуалом для&nbsp;LUKOIL, Cadillac, PUMA и&nbsp;Gippo.
    </p>
  </section>

  <AboutCompact personal />
  <Services personal />
  <ProduxPortfolio />
  <ReviewsSlider />

  <section class="process section" aria-labelledby="process-title">
    <div class="container">
      <h2 class="display-title" id="process-title">Как строим<br />работу</h2>
      <ol class="process-list">
        <li class="process-step">
          <span class="process-step-number">01</span>
          <div>
            <h3>Обсуждаем задачу</h3>
            <p>Пишете в форму ниже или в Telegram — коротко рассказываете о задаче, сроках и бюджете.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number">02</span>
          <div>
            <h3>Присылаю смету и сроки</h3>
            <p>Точная стоимость и срок — фиксируем в договоре, без изменений задним числом.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number">03</span>
          <div>
            <h3>Делаю и присылаю на согласование</h3>
            <p>Показываю концепцию, собираю обратную связь, довожу до финального варианта.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number">04</span>
          <div>
            <h3>Передаю результат</h3>
            <p>Готовый сайт, макет или файл под печать — плюс исходники и все права на них.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="faq section" aria-labelledby="faq-title">
    <div class="container">
      <h2 class="display-title" id="faq-title">Частые<br />вопросы</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Сколько стоит проект?</summary>
          <p>Зависит от задачи: лендинг, айдентика и упаковка стоят по-разному. Присылаю смету после короткого созвона или переписки — точную, без «от» и без сюрпризов в процессе.</p>
        </details>
        <details class="faq-item">
          <summary>Сколько занимает разработка?</summary>
          <p>Лендинги и презентации — от 1 до 3 недель. Сайты и айдентика — от 3 до 6 недель. Срок фиксируется в договоре на старте.</p>
        </details>
        <details class="faq-item">
          <summary>Работаете официально?</summary>
          <p>Да: договор, поэтапная оплата, акты выполненных работ и передача исключительных прав на исходники после финального платежа.</p>
        </details>
        <details class="faq-item">
          <summary>Почему не студия, а один человек?</summary>
          <p>Проект от эскиза до релиза веду сам — без передачи между отделами и потери смысла на стыках. При этом есть опыт агентства thePeak: там я работал с LUKOIL, Cadillac, PUMA и Gippo, и оттуда — процессы, которые держат сроки на больших проектах.</p>
        </details>
        <details class="faq-item">
          <summary>Что если моя задача не из списка услуг?</summary>
          <p>Напишите — обсудим. Если задача не моя, честно скажу сразу, а не буду тянуть время.</p>
        </details>
      </div>
    </div>
  </section>

  <Founder />

  <Contacts
    title="Пишете<br />из Threads?"
    lead="Расскажите о задаче или заполните форму — отвечу лично в течение 2 часов и пришлю смету со сроками."
    successText="Спасибо за заявку. Отвечу в течение 2 часов — проверьте Telegram или WhatsApp, если оставили контакт там."
    source="threads_landing"
    sourceDetails="Лендинг для заявок из Threads"
  />

  <Footer slot="footer" personal />
</Base>

<style>
  .threads-badge {
    position: relative;
    z-index: 2;
    padding-block: 0.85rem;
    background: rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .threads-badge-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    text-align: center;
  }

  .threads-badge-dot {
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px rgba(128, 239, 201, 0.6);
  }

  .threads-badge p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(0.8rem, 1.4vw, 0.92rem);
    line-height: 1.35;
  }

  .trust-strip {
    position: relative;
    z-index: 2;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(to bottom, #000000 0%, #0B0B0C 100%);
    color: #fff;
  }

  .trust-strip-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 58rem) {
    .trust-strip-inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: center;
    padding-inline: 0.5rem;
  }

  .trust-number {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent-cyan);
  }

  .trust-label {
    font-size: clamp(0.8rem, 1vw, 0.88rem);
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.3;
  }

  .trust-footnote {
    margin: clamp(1.75rem, 3vw, 2.5rem) auto 0;
    max-width: 40rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .process {
    position: relative;
    z-index: 2;
    color: #fff;
    background: #0B0B0C;
  }

  .process-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 58rem) {
    .process-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .process-step {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  .process-step-number {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--accent);
    line-height: 1;
  }

  .process-step h3 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    letter-spacing: -0.02em;
  }

  .process-step p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .faq {
    position: relative;
    z-index: 2;
    color: #fff;
    background: linear-gradient(to bottom, #0B0B0C 0%, #000000 100%);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(1.1rem, 2vw, 1.4rem) clamp(1.25rem, 2.5vw, 1.6rem);
    background: rgba(255, 255, 255, 0.03);
  }

  .faq-item summary {
    cursor: pointer;
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--accent);
    transition: transform 0.25s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
