---
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProduxPortfolio from '../components/ProduxPortfolio.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import AboutCompact from '../components/AboutCompact.astro';
import Founder from '../components/Founder.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';
import ProcessTimeline from '../components/ui/process-timeline';

const processStepsEn = [
  {
    number: '01',
    title: 'Discussing the task',
    description: 'Fill out the form below or message in Telegram — briefly describe your goals, timeline, and budget.',
  },
  {
    number: '02',
    title: 'Quote and schedule',
    description: 'Exact cost and timeline — agreed before kickoff, fixed in the contract with no surprise changes.',
  },
  {
    number: '03',
    title: 'Design & approval',
    description: 'Presenting concepts, collecting feedback, and iterating until the design is completely approved.',
  },
  {
    number: '04',
    title: 'Final handover',
    description: 'Live website, clean Figma UI, or prepress print files — plus full source assets and rights transfer.',
  },
];

const enJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://yapil.art/#person',
      name: 'Yakov Pilipyuk',
      alternateName: 'Yapil',
      url: 'https://yapil.art/en',
      jobTitle: 'Designer & Creative Director',
      email: 'hi@yapil.art',
      telephone: '+77067436197',
      sameAs: ['https://t.me/yakov_pil', 'https://wa.me/77067436197'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How much does a project cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'It depends on the task: landing pages, visual identities, and packaging have different scope. I provide a transparent estimate after a short call or chat — fixed, accurate, and with zero surprises during the project.',
          },
        },
        {
          '@type': 'Question',
          name: 'How long does development take?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Landing pages and presentation pitch decks: 1 to 3 weeks. Full websites and complete brand identities: 3 to 6 weeks. The timeline is fixed in the agreement at the start.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you work under contract?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes: formal contract, milestone-based payments, delivery reports, and transfer of all exclusive rights and source files upon final settlement.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why work with an independent designer instead of an agency?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'I lead every project myself from the first sketch to release — no account managers or miscommunications between departments. At the same time, I bring agency leadership experience from thePeak (working with LUKOIL, Cadillac, PUMA, Gippo), ensuring rigorous processes and met deadlines on major projects.',
          },
        },
        {
          '@type': 'Question',
          name: 'What if my task is not listed under services?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Reach out — let's discuss. If the task is outside my expertise, I'll tell you honestly right away rather than wasting your time.",
          },
        },
      ],
    },
  ],
};
---

<Base
  lang="en"
  title="Designer for hire — Yakov Pilipyuk | Yapil"
  description="Websites, brand identity, packaging, and presentations that distinguish your company from competitors and drive business growth — from initial sketch to release."
  image="/cover-threads.webp"
  jsonLd={enJsonLd}
  noindex
  navMinimal
  bodyClass="page-threads"
>
  <Hero
    title="Design<br />that works<br />for you"
    description="Websites, brand identity, packaging, and presentations that make your business stand out and convert visitors into clients — from initial sketch to print or launch."
    casesHref="#contacts"
    ctaText="Get in touch"
  />

  <AboutCompact personal lang="en" />
  <Founder lang="en" />
  <Services personal cards currency="usd" lang="en" />
  <ProduxPortfolio lang="en" />
  <ReviewsSlider lang="en" />

  <div class="process-faq-group">
    <div class="process-faq-inner">
      <section class="process section" aria-labelledby="process-title">
        <div class="container">
          <h2 class="display-title" id="process-title">How we<br />work</h2>
          <ProcessTimeline client:visible steps={processStepsEn} />
        </div>
      </section>

      <section class="faq section" aria-labelledby="faq-title">
        <div class="container">
          <h2 class="display-title" id="faq-title">Frequently<br />asked questions</h2>
          <div class="faq-list">
            <details class="faq-item">
              <summary>How much does a project cost?</summary>
              <div class="faq-answer"><div class="faq-answer-inner">
                <p>It depends on the task: landing pages, visual identities, and packaging have different scope. I provide a transparent estimate after a short call or chat — fixed, accurate, and with zero surprises during the project.</p>
              </div></div>
            </details>
            <details class="faq-item">
              <summary>How long does development take?</summary>
              <div class="faq-answer"><div class="faq-answer-inner">
                <p>Landing pages and presentation pitch decks: 1 to 3 weeks. Full websites and complete brand identities: 3 to 6 weeks. The timeline is fixed in the agreement at the start.</p>
              </div></div>
            </details>
            <details class="faq-item">
              <summary>Do you work under contract?</summary>
              <div class="faq-answer"><div class="faq-answer-inner">
                <p>Yes: formal contract, milestone-based payments, delivery reports, and transfer of all exclusive rights and source files upon final settlement.</p>
              </div></div>
            </details>
            <details class="faq-item">
              <summary>Why work with an independent designer instead of an agency?</summary>
              <div class="faq-answer"><div class="faq-answer-inner">
                <p>I lead every project myself from the first sketch to release — no account managers or miscommunications between departments. At the same time, I bring agency leadership experience from thePeak (working with LUKOIL, Cadillac, PUMA, Gippo), ensuring rigorous processes and met deadlines on major projects.</p>
              </div></div>
            </details>
            <details class="faq-item">
              <summary>What if my task is not listed under services?</summary>
              <div class="faq-answer"><div class="faq-answer-inner">
                <p>Reach out — let's discuss. If the task is outside my expertise, I'll tell you honestly right away rather than wasting your time.</p>
              </div></div>
            </details>
          </div>
        </div>
      </section>
    </div>
  </div>

  <Contacts
    lang="en"
    title="Have a project<br />in mind?"
    lead="Tell me about your task or fill out the form — I will reply personally within 2 hours with an estimate and timeline."
    successText="Thank you for your inquiry. I will reply within 2 hours — please check Telegram or WhatsApp if you provided a handle."
    source="en_landing"
    sourceDetails="English Landing Page"
  />

  <Footer slot="footer" personal lang="en" />
</Base>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLDetailsElement>('.page-threads .faq-item').forEach((item) => {
    const summary = item.querySelector('summary');
    const answer = item.querySelector<HTMLElement>('.faq-answer');
    if (!summary || !answer) return;

    let transitionVersion = 0;

    if (item.open) item.classList.add('is-expanded');

    summary.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      summary.click();
    });

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      const version = ++transitionVersion;
      const isExpanded = item.classList.contains('is-expanded');

      if (reduceMotion.matches) {
        item.open = !isExpanded;
        item.classList.toggle('is-expanded', !isExpanded);
        return;
      }

      if (isExpanded) {
        item.classList.remove('is-expanded');

        const finishClosing = (transitionEvent?: TransitionEvent) => {
          if (transitionEvent && transitionEvent.propertyName !== 'grid-template-rows') return;
          if (version !== transitionVersion) return;
          answer.removeEventListener('transitionend', finishClosing);
          item.open = false;
        };

        answer.addEventListener('transitionend', finishClosing);
        window.setTimeout(() => finishClosing(), 450);
        return;
      }

      item.open = true;
      answer.getBoundingClientRect();
      requestAnimationFrame(() => {
        if (version === transitionVersion) item.classList.add('is-expanded');
      });
    });
  });
</script>

<style is:global>
  /*
   * Threads background flow. Every boundary shares the same color on both
   * sides, so the fixed shader can appear through transparent stops without
   * producing hard horizontal seams between independently rendered sections.
   */
  .page-threads .hero-cover {
    background: linear-gradient(to bottom, transparent 0%, transparent 100%) !important;
  }

  .page-threads #about-compact {
    background: linear-gradient(to bottom, transparent 0%, #000 100%) !important;
  }

  .page-threads #services {
    background: linear-gradient(to bottom, #000 0%, #000 100%) !important;
  }

  .page-threads .portfolio {
    background: linear-gradient(
      to bottom,
      #000 0%,
      #000 15%,
      rgba(0, 0, 0, 0.55) 45%,
      transparent 85%,
      transparent 100%
    ) !important;
  }

  .page-threads #reviews {
    background: linear-gradient(to bottom, transparent 0%, #000 100%) !important;
  }

  .page-threads .process {
    position: relative;
    z-index: 2;
    color: #fff;
    background: linear-gradient(to bottom, #000 0%, #000 100%);
  }

  .page-threads .faq {
    position: relative;
    z-index: 2;
    color: #fff;
    background: linear-gradient(to bottom, #000 0%, #000 100%);
  }

  @media (min-width: 64rem) {
    .page-threads .process-faq-group {
      position: relative;
      z-index: 2;
      color: #fff;
      padding-block: clamp(4.5rem, 9vw, 9rem);
      background: #000;
    }

    .page-threads .process-faq-inner {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
      width: min(calc(100% - var(--container-inline-space)), var(--container-max));
      margin-inline: auto;
    }

    .page-threads .process-faq-group .process,
    .page-threads .process-faq-group .faq {
      padding-block: 0;
      background: transparent !important;
    }

    .page-threads .process-faq-group .process {
      grid-column: 1 / span 6;
    }

    .page-threads .process-faq-group .faq {
      grid-column: 8 / span 5;
    }

    .page-threads .process-faq-group .container {
      width: 100%;
      margin-inline: 0;
    }

    .page-threads .process-faq-group .faq-list {
      max-width: none;
    }
  }

  .page-threads #founder {
    background: linear-gradient(
      to bottom,
      #000 0%,
      #000 100%
    ) !important;
  }

  .page-threads #contacts {
    background: linear-gradient(to bottom, #000 0%, #000 100%) !important;
  }

  .page-threads .site-footer {
    background: linear-gradient(to bottom, #000 0%, #000 100%) !important;
  }

  .page-threads .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .page-threads .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(1.1rem, 2vw, 1.4rem) clamp(1.25rem, 2.5vw, 1.6rem);
    background: rgba(255, 255, 255, 0.03);
  }

  .page-threads .faq-item summary {
    cursor: pointer;
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    font-weight: 500;
    letter-spacing: -0.014em;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-threads .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .page-threads .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--accent);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .page-threads .faq-item.is-expanded summary::after {
    transform: rotate(45deg);
  }

  .page-threads .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.28s ease;
  }

  .page-threads .faq-item.is-expanded .faq-answer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .page-threads .faq-answer-inner {
    min-height: 0;
    overflow: hidden;
  }

  .page-threads .faq-item p {
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-threads .faq-item summary::after,
    .page-threads .faq-answer {
      transition: none;
    }
  }
</style>
