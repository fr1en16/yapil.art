---
import Base from '../../layouts/Base.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import { indexableCitiesList, type CityData } from '../../data/citiesData';
import { servicesList } from '../../data/servicesData';
import { geoServicesData } from '../../data/geoServicesData';
import '../../styles/proposal-pages.css';

export function getStaticPaths() {
  return indexableCitiesList.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

interface Props { city: CityData; }
const { city } = Astro.props;
const title = `Услуги дизайн-студии в ${city.prepositional} — Yapil`;
const description = `Разработка сайтов, айдентики, упаковки, презентаций, SMM-дизайна и дизайн-сопровождения для компаний ${city.genitive}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `Услуги Yapil в ${city.prepositional}`,
      description,
      url: `https://yapil.art/cities/${city.slug}`,
      about: { '@type': 'City', name: city.name },
      hasPart: servicesList.map((service) => ({
        '@type': 'Service',
        name: `${geoServicesData[service.slug].searchName} в ${city.prepositional}`,
        url: `https://yapil.art/services/${service.slug}/${city.slug}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
        { '@type': 'ListItem', position: 2, name: 'Города', item: 'https://yapil.art/cities' },
        { '@type': 'ListItem', position: 3, name: city.name, item: `https://yapil.art/cities/${city.slug}` },
      ],
    },
  ],
};
---

<Base {title} {description} {jsonLd} theme="light" navOverlay={true}>
  <article class="editorial-page">
    <header class="editorial-cover">
      <div class="container editorial-cover__inner">
        <nav class="city-breadcrumbs" aria-label="Хлебные крошки"><a href="/cities">Города</a><span>/</span><span>{city.name}</span></nav>
        <div class="editorial-title-wrap"><h1>Услуги дизайн-студии в {city.prepositional}</h1></div>
        <div class="editorial-cover__bottom">
          <p class="editorial-lead">{city.context} {city.workFormat}</p>
          <dl class="editorial-meta">
            <div><dt>Направления</dt><dd>{city.businessFocus.join(' / ')}</dd></div>
            <div><dt>Услуги</dt><dd>{servicesList.length}</dd></div>
            <div><dt>Формат</dt><dd>онлайн по Казахстану</dd></div>
          </dl>
        </div>
      </div>
    </header>

    <div class="editorial-body">
      <section class="editorial-section" aria-labelledby="services-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">01</p>
          <div class="editorial-heading__content"><h2 id="services-title">Услуги в {city.prepositional}</h2></div>
        </header>
        <div class="editorial-grid">
          {servicesList.map((service) => (
            <a class="editorial-card" href={`/services/${service.slug}/${city.slug}`}>
              <span class="editorial-card__number">{service.number} / ↗</span>
              <h2>{geoServicesData[service.slug].shortName}</h2><p>{geoServicesData[service.slug].localValue}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="editorial-section" aria-labelledby="conditions-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">02</p>
          <div class="editorial-heading__content"><h2 id="conditions-title">Условия работы с командами {city.genitive}</h2></div>
        </header>
        <ol class="editorial-list">
          <li class="editorial-row"><span class="editorial-row__number">01</span><h3>Формат</h3><p>{city.workFormat}</p></li>
          <li class="editorial-row"><span class="editorial-row__number">02</span><h3>Контекст</h3><p>Учитываем специфику направлений: {city.businessFocus.join(', ')}.</p></li>
          <li class="editorial-row"><span class="editorial-row__number">03</span><h3>Результат</h3><p>До старта фиксируем состав работ, календарь, точки согласования и комплект передаваемых материалов.</p></li>
        </ol>
      </section>
    </div>

    <Contacts theme="light" title={`Обсудим проект в ${city.prepositional}`} lead="Опишите задачу — предложим подход, сроки и состав работ." source="contacts_form" sourceDetails={`Город: ${city.name}`} gradientToDark />
  </article>
  <Footer slot="footer" theme="dark" />
</Base>

<style>
  .city-breadcrumbs { display: flex; gap: .5rem; padding-top: 7rem; color: rgba(23,23,23,.58); font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; }
  .city-breadcrumbs a { color: inherit; text-decoration: none; }
  @media (max-width: 800px) { .city-breadcrumbs { padding-top: 5.5rem; } }
</style>
