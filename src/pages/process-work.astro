---
import ProcessWork from '../components/process-work/ProcessWork.astro';
import '@fontsource-variable/inter-tight';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="От первой идеи до запуска: процесс и избранные проекты Yapil." />
    <title>Процесс и проекты — Yapil</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/oranienbaum-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#process">К содержанию</a>
    <header><a class="wordmark" href="/" aria-label="Yapil — главная">yapil<span>®</span></a><nav aria-label="Навигация страницы"><a href="#process">Процесс</a><a href="#work">Проекты</a><a href="mailto:hi@yapil.art">Обсудить проект ↗</a></nav></header>
    <main><ProcessWork /></main>
    <footer><a href="/cases">Все проекты ↗</a><a href="mailto:hi@yapil.art">hi@yapil.art</a><a href="/">На главную ↗</a></footer>
  </body>
</html>
<style is:global>
  @font-face{font-family:Oranienbaum;src:url('/fonts/oranienbaum-cyrillic.woff2') format('woff2');font-display:swap;unicode-range:U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
  @font-face{font-family:Oranienbaum;src:url('/fonts/oranienbaum-latin.woff2') format('woff2');font-display:swap;unicode-range:U+0000-00FF,U+2000-206F}
  *{box-sizing:border-box}html{background:#fff;color:#FD4B32;scroll-behavior:smooth}body{margin:0;font-family:'Inter Tight Variable',Arial,sans-serif}a{color:inherit;text-decoration:none}button{font:inherit}a:focus-visible,button:focus-visible{outline:2px solid currentColor;outline-offset:6px}header{height:80px;padding:20px;display:flex;justify-content:space-between;align-items:center}nav{display:flex;gap:32px;font-size:16px}.wordmark{font-weight:750;font-size:36px;letter-spacing:-3px}.wordmark span{font-size:12px;letter-spacing:0;vertical-align:top}footer{padding:80px 20px;display:flex;justify-content:space-between;gap:20px;border-top:1px solid #FD4B32}.skip-link{position:fixed;top:10px;left:10px;transform:translateY(-200%);z-index:100;background:#fff;padding:15px}.skip-link:focus{transform:none}h1,h2,h3{font-family:Oranienbaum,Georgia,serif;font-weight:400;margin:0}p{margin:0}@media(max-width:600px){header{padding:16px}nav{gap:16px;font-size:13px}nav a:last-child{display:none}footer{padding:48px 16px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
