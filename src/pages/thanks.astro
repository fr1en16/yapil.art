---
import Base from '../layouts/Base.astro';
import { getTelegramUrl, getWhatsAppUrl } from '../utils/messengerLinks';

const telegramHref = getTelegramUrl();
const whatsappHref = getWhatsAppUrl({
  pageUrl: Astro.url.href,
  sourceContext: 'thanks_page',
});
---

<Base
  title="Спасибо — Yapil"
  description="Заявка отправлена. Яков свяжется с вами в ближайшее время."
  noindex={true}
  navOverlay={true}
  bodyClass="thanks-page"
>
  <section class="thanks" aria-labelledby="thanks-title">
    <div class="thanks__content container">
      <div class="thanks__mark" aria-hidden="true">
        <span></span>
      </div>

      <h1 id="thanks-title">Спасибо</h1>
      <p>Заявка отправлена.<br />Я свяжусь с вами в ближайшее время.</p>

      <div class="thanks__messengers" aria-label="Написать напрямую">
        <a href={telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram" title="Telegram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.7 3.3a1.7 1.7 0 0 0-1.8-.2L2.8 9.7c-1.2.5-1.2 1.2-.2 1.5l4.4 1.4 1.7 5.2c.2.7.1 1 .8 1 .5 0 .7-.2 1-.5l2.1-2 4.5 3.3c.8.5 1.4.2 1.6-.8l3-14.2c.3-.7.2-1.1 0-1.3ZM8 12.3l10.7-6.8c.5-.3 1-.1.6.2l-8.8 8-.3 3.6L8 12.3Z" />
          </svg>
        </a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Написать в WhatsApp" title="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48a9 9 0 0 1-1.66-2.07c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.51-.23-.36A9.44 9.44 0 0 1 2.5 12C2.5 6.76 6.78 2.5 12.04 2.5a9.45 9.45 0 0 1 6.74 2.79A9.43 9.43 0 0 1 21.56 12c0 5.24-4.28 9.5-9.52 9.5m8.1-17.57A11.38 11.38 0 0 0 12.05.58C5.75.58.63 5.7.63 12c0 2.01.52 3.98 1.52 5.72L.53 23.63l6.05-1.59a11.43 11.43 0 0 0 5.46 1.39h.01c6.3 0 11.42-5.12 11.42-11.42 0-3.05-1.18-5.92-3.34-8.08" />
          </svg>
        </a>
      </div>

      <a class="thanks__link" href="/">
        <span aria-hidden="true">←</span>
        <span>Вернуться на главную</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .thanks {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: clip;
    color: #fff;
    isolation: isolate;
  }

  .thanks::before {
    position: absolute;
    width: min(62vw, 52rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50%;
    content: '';
    pointer-events: none;
    transform: translate(38vw, -28vh);
  }

  .thanks__content {
    padding-block: clamp(8rem, 18vh, 12rem) clamp(5rem, 12vh, 8rem);
    text-align: center;
  }

  .thanks__mark {
    display: grid;
    width: clamp(4.75rem, 8vw, 6.5rem);
    aspect-ratio: 1;
    margin: 0 auto clamp(2rem, 4vh, 3rem);
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    animation: mark-in 900ms var(--ease-spring) both;
  }

  .thanks__mark span {
    width: 1.8rem;
    height: 0.9rem;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
    transform: translateY(-0.15rem) rotate(-45deg);
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 15vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  p {
    max-width: 37rem;
    margin: clamp(2rem, 4vh, 3rem) auto clamp(1.5rem, 3vh, 2rem);
    color: rgb(255 255 255 / 0.78);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.25;
  }

  .thanks__messengers {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 5vh, 4rem);
  }

  .thanks__messengers a {
    display: grid;
    width: 3.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 50%;
    color: #fff;
    background: rgb(0 0 0 / 0.24);
    backdrop-filter: blur(1rem);
    transition:
      color 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease,
      transform 420ms var(--ease-spring);
  }

  .thanks__messengers a:hover,
  .thanks__messengers a:focus-visible {
    color: #82f2c9;
    border-color: rgb(255 255 255 / 0.48);
    background: rgb(0 0 0 / 0.54);
    transform: translateY(-3px) scale(1.04);
  }

  .thanks__messengers svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: currentColor;
  }

  .thanks__link {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    color: #fff;
    background: rgb(0 0 0 / 0.32);
    font-size: 0.95rem;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(1rem);
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      transform 420ms var(--ease-spring);
  }

  .thanks__link:hover,
  .thanks__link:focus-visible {
    border-color: rgb(255 255 255 / 0.48);
    background: rgb(0 0 0 / 0.54);
    transform: translateY(-3px);
  }

  .thanks__link span:first-child {
    transition: transform 420ms var(--ease-spring);
  }

  .thanks__link:hover span:first-child,
  .thanks__link:focus-visible span:first-child {
    transform: translateX(-0.25rem);
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      transform: scale(0.68) rotate(-12deg);
    }
  }

  @media (max-width: 40rem) {
    .thanks::before {
      width: 28rem;
      transform: translate(48%, -65%);
    }

    .thanks__content {
      padding-inline: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks__mark {
      animation: none;
    }
  }
</style>

<style is:global>
  .thanks-page > .floating-whatsapp {
    display: none;
  }
</style>
