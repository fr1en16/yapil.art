---
import GeoServicePage from '../../../components/GeoServicePage.astro';
import GeoWebsitePage from '../../../components/GeoWebsitePage.astro';
import { servicesList, type ServiceData } from '../../../data/servicesData';
import { indexableCitiesList, type CityData } from '../../../data/citiesData';

export function getStaticPaths() {
  return servicesList.flatMap((service) =>
    indexableCitiesList.map((city) => ({
      params: { service: service.slug, city: city.slug },
      props: { service, city },
    })),
  );
}

interface Props {
  service: ServiceData;
  city: CityData;
}

const { service, city } = Astro.props;
---

{service.slug === 'websites' ? (
  <GeoWebsitePage {service} {city} />
) : (
  <GeoServicePage {service} {city} />
)}
