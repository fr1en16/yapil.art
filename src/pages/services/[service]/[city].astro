---
import GeoOfferingPage from '../../../components/GeoOfferingPage.astro';
import { getServices, type SanityService } from '../../../lib/sanity';
import { indexableCitiesList, type CityData } from '../../../data/citiesData';

export async function getStaticPaths() {
  const servicesList = await getServices();
  return servicesList.flatMap((service) =>
    indexableCitiesList.map((city) => ({
      params: { service: service.slug, city: city.slug },
      props: { service, city },
    })),
  );
}

interface Props {
  service: SanityService;
  city: CityData;
}

const { service, city } = Astro.props;
---

<GeoOfferingPage {service} {city} />
