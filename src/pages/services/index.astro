---
import OfferingIndexTemplate from '../../components/proposal/OfferingIndexTemplate.astro';
import { servicesList } from '../../data/servicesData';

const title = 'Услуги дизайн-студии Yapil — сайты, айдентика, полиграфия, презентации, SMM';
const description = 'Комплексные услуги дизайн-студии Yapil: разработка сайтов под ключ, айдентика и фирменный стиль, полиграфия и упаковка, инвест-презентации, SMM и сопровождение.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Услуги дизайн-студии Yapil', description, url: 'https://yapil.art/services', provider: { '@type': 'ProfessionalService', name: 'Yapil', url: 'https://yapil.art' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
      { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://yapil.art/services' },
    ] },
  ],
};
---

<OfferingIndexTemplate
  {title}
  {description}
  {jsonLd}
  section="services"
  heading="Услуги студии"
  lead="Создаём визуальные системы, сайты и печатные материалы, которые помогают бизнесу привлекать клиентов, вызывать доверие и масштабироваться."
  items={servicesList}
  catalogTitle="Что мы делаем"
  contactsTitle="Обсудим вашу задачу"
  contactsLead="Расскажите о проекте — предложим подходящий формат, сроки и следующий шаг."
  source="contacts_form"
/>
