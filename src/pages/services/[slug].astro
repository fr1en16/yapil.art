---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import { servicesData, type ServiceData } from '../../data/servicesData';

export async function getStaticPaths() {
  return Object.values(servicesData).map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceData;
}

const { service } = Astro.props;

// Fetch cases associated with this service
const allCases = await getCollection('cases');
const caseMap = new Map(allCases.map((c) => [c.id, c]));
const serviceCases = service.caseSlugs
  .map((slug) => caseMap.get(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// Schema.org JSON-LD (Service & FAQPage & BreadcrumbList)
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.name,
      serviceType: service.seo.h1,
      description: service.seo.description,
      provider: {
        '@type': 'ProfessionalService',
        name: 'Yapil',
        url: 'https://yapil.art',
        telephone: '+77067436197',
        email: 'hi@yapil.art',
      },
      areaServed: ['KZ', 'UZ', 'RU', 'Worldwide'],
      url: new URL(`/services/${service.slug}`, Astro.site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Главная',
          item: 'https://yapil.art',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Услуги',
          item: 'https://yapil.art/services',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: service.name,
          item: new URL(`/services/${service.slug}`, Astro.site).href,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Base
  title={service.seo.title}
  description={service.seo.description}
  jsonLd={serviceJsonLd}
>
  <article class="service-page">
    <!-- 1. Hero Section -->
    <header class="service-hero container">
      <nav class="service-breadcrumbs" aria-label="Хлебные крошки">
        <a class="back-link" href="/services">
          <span class="back-link-inner">
            <span class="back-link-arrow">←</span>
            <span class="back-link-text">Все услуги</span>
          </span>
        </a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">{service.name}</span>
      </nav>

      <div class="service-hero-content">
        <h1 class="service-hero-title">{service.heroH1}</h1>
        <p class="service-hero-lead">{service.heroLead}</p>

        <div class="service-hero-actions">
          <a href="#contacts" class="service-cta-btn">
            <span class="btn-inner">
              <span class="btn-text">Обсудить задачу</span>
              <span class="btn-icon" aria-hidden="true">→</span>
            </span>
          </a>
          <a href="#formats" class="service-secondary-link">
            <span>Смотреть форматы и этапы ↓</span>
          </a>
        </div>
      </div>

      <!-- Quick Metrics Row -->
      <div class="service-metrics-grid" role="region" aria-label="Ключевые показатели услуги">
        {service.metrics.map((metric) => (
          <div class="metric-card">
            <div class="metric-num-wrap">
              <span class="metric-num">{metric.number}</span>
              <span class="metric-label">{metric.label}</span>
            </div>
            <p class="metric-text">{metric.text}</p>
          </div>
        ))}
      </div>
    </header>

    <!-- 2. Formats / Directions Section -->
    <section class="service-section formats-section" id="formats" aria-labelledby="formats-title">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">Форматы</span>
          <h2 class="display-title" id="formats-title">{service.formatsTitle}</h2>
        </div>

        <div class="formats-grid">
          {service.formats.map((format, idx) => (
            <div class="format-card">
              <div class="format-card-top">
                <span class="format-idx">0{idx + 1}</span>
                <span class="format-badge">{format.subtitle}</span>
              </div>
              <div class="format-card-body">
                <h3 class="format-title">{format.title}</h3>
                <p class="format-desc">{format.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Deliverables / Artifacts Section -->
    <section class="service-section deliverables-section" aria-labelledby="deliverables-title">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">Результат</span>
          <h2 class="display-title" id="deliverables-title">{service.deliverablesTitle}</h2>
        </div>

        <div class="deliverables-grid">
          {service.deliverables.map((item, idx) => (
            <div class="deliverable-card">
              <div class="deliverable-header">
                <span class="deliverable-marker">0{idx + 1}</span>
                <h3 class="deliverable-title">{item.title}</h3>
              </div>
              <p class="deliverable-text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Process Steps Section -->
    <section class="service-section process-section" aria-labelledby="process-title">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">Процесс</span>
          <h2 class="display-title" id="process-title">{service.processTitle}</h2>
        </div>

        <ol class="process-list">
          {service.steps.map((step) => (
            <li class="process-step">
              <div class="step-num-col">
                <span class="step-num">{step.number}</span>
              </div>
              <div class="step-content">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Relevant Cases Section -->
    {serviceCases.length > 0 && (
      <section class="service-section cases-section" aria-labelledby="cases-title">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Портфолио</span>
            <h2 class="display-title" id="cases-title">{service.casesTitle}</h2>
          </div>

          <div class="portfolio__grid">
            {serviceCases.map((project, index) => {
              const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(project.data.cover);
              const positions = [
                'project--lead',
                'project--side',
                'project--center',
                'project--small',
                'project--wide',
                'project--lead',
              ];
              const posClass = positions[index % positions.length];
              const poster = isVideo
                ? project.data.cover.replace(/\.(mp4|webm)(?:\?.*)?$/i, '.webp')
                : project.data.cover;

              return (
                <article class:list={['project', posClass]} data-slug={project.id}>
                  <a class="project__link" href={`/case/${project.id}`}>
                    <div class="project__media" data-parallax-media>
                      <div class="project__parallax" data-parallax-target>
                        <div class="project__image">
                          {isVideo ? (
                            <>
                              <img
                                src={poster}
                                alt={`${project.data.title} — ${project.data.summary}`}
                                loading="lazy"
                                decoding="async"
                                class="project__poster"
                              />
                              <video
                                data-lazy-video
                                data-src={project.data.cover}
                                poster={poster}
                                muted
                                loop
                                playsinline
                                preload="none"
                                aria-hidden="true"
                                class="project__video"
                              >
                                <track kind="captions" src="data:text/vtt,WEBVTT" label="Без звука" default />
                              </video>
                            </>
                          ) : project.data.cover.startsWith('/') ? (
                            <img
                              src={project.data.cover}
                              alt={`${project.data.title} — ${project.data.summary}`}
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <Image
                              src={project.data.cover}
                              alt={`${project.data.title} — ${project.data.summary}`}
                              inferSize
                              widths={[640, 960, 1440]}
                              sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1199px) calc(100vw - 4rem), 70vw"
                              format="webp"
                              quality={78}
                              loading="lazy"
                            />
                          )}
                        </div>
                      </div>

                      <div class="project__tags" aria-hidden="true">
                        {project.data.services.map((s) => <span>{s}</span>)}
                      </div>
                    </div>

                    <div class="project__info">
                      <span class="project__marker" aria-hidden="true"></span>
                      <div class="project__copy">
                        <h3>{project.data.title}</h3>
                        <p>{project.data.summary}</p>
                      </div>
                      <div class="project__action" aria-hidden="true">
                        <span class="project__arrow">↗</span>
                        <span>Смотреть кейс</span>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 6. FAQ Section -->
    <section class="service-section faq-section" aria-labelledby="faq-title">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">FAQ</span>
          <h2 class="display-title" id="faq-title">{service.faqTitle}</h2>
        </div>

        <div class="faq-list">
          {service.faq.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-summary">
                <span class="faq-question">{item.question}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Cross-Links (Other Services) -->
    <section class="service-section cross-links-section" aria-labelledby="cross-links-title">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">Направления</span>
          <h2 class="display-title" id="cross-links-title">{service.crossLinksTitle}</h2>
        </div>

        <div class="cross-links-grid">
          {service.crossLinks.map((link) => (
            <a class="cross-link-card" href={`/services/${link.slug}`}>
              <div class="cross-link-top">
                <span class="cross-link-num">{link.number}</span>
                <span class="cross-link-arrow">↗</span>
              </div>
              <div class="cross-link-body">
                <h3 class="cross-link-title">{link.title}</h3>
                <p class="cross-link-desc">{link.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Contacts Section with prefill -->
    <Contacts />
  </article>

  <Footer slot="footer" />
</Base>

<style>
  .service-page {
    position: relative;
    padding-top: clamp(2rem, 5vw, 4rem);
    color: var(--ink-primary);
  }

  /* Breadcrumbs */
  .service-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .back-link {
    display: inline-flex;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    will-change: transform;
    transition:
      transform var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      color 200ms ease;
  }

  .back-link-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .back-link-arrow {
    display: inline-block;
    transition: transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18));
  }

  .back-link-text {
    display: inline-block;
    transition: transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18)) var(--delay-btn-text, 90ms),
                letter-spacing var(--duration-btn-text, 910ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)) var(--delay-btn-text, 90ms);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: #ffffff;
    transform: scale(1.04);
  }

  .back-link:hover .back-link-arrow,
  .back-link:focus-visible .back-link-arrow {
    transform: translateX(-3px) scale(1.15);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--accent-tint, #F7C8BF);
  }

  /* Hero Section */
  .service-hero {
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .service-hero-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.05em;
    color: #ffffff;
    max-width: 60rem;
    overflow-wrap: anywhere;
  }

  .service-hero-lead {
    max-width: 46rem;
    margin: 0 0 2.5rem;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
  }

  .service-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .service-cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.1rem 2.4rem;
    color: #ffffff;
    background: var(--accent, #FD4B32);
    border: 1px solid var(--accent, #FD4B32);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    transform-origin: center center;
    will-change: transform, box-shadow, background-color;
    transition:
      transform var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      background-color var(--duration-btn-color, 770ms) ease,
      box-shadow var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .service-cta-btn:hover,
  .service-cta-btn:focus-visible {
    background: var(--accent-hover, #E63A22);
    transform: scale(1.055) translateY(-2px);
    box-shadow: 0 14px 34px -4px rgba(253, 75, 50, 0.45), 0 0 2.2rem rgba(253, 75, 50, 0.25);
  }

  .service-cta-btn .btn-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .service-cta-btn .btn-text {
    letter-spacing: -0.01em;
    transition:
      transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18)) var(--delay-btn-text, 90ms),
      letter-spacing var(--duration-btn-text, 910ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)) var(--delay-btn-text, 90ms);
  }

  .service-cta-btn .btn-icon {
    transition: transform var(--duration-btn-text, 910ms) var(--ease-text-stagger, cubic-bezier(0.16, 1, 0.3, 1.18)) var(--delay-btn-icon, 140ms);
  }

  .service-cta-btn:hover .btn-text,
  .service-cta-btn:focus-visible .btn-text {
    letter-spacing: 0.025em;
  }

  .service-cta-btn:hover .btn-icon,
  .service-cta-btn:focus-visible .btn-icon {
    transform: translateX(4px);
  }

  .service-secondary-link {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .service-secondary-link:hover {
    color: #ffffff;
  }

  /* Metrics Grid */
  .service-metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .service-metrics-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap, 1rem);
    }
  }

  .metric-card {
    padding: 1.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(20px);
  }

  .metric-num-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .metric-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 700;
  }

  .metric-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .metric-text {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.25;
  }

  /* Section Headings */
  .service-section {
    padding-block: clamp(4.5rem, 9vw, 9rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-tint, #F7C8BF);
  }

  /* Formats Section (Block 2 - Rich Black Gradient Transition) */
  .formats-section {
    position: relative;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(253, 75, 50, 0.14) 0%, transparent 60%),
      linear-gradient(to bottom, transparent 0%, rgba(11, 11, 12, 0.82) 14%, #0B0B0C 32%, #141417 65%, #0B0B0C 100%);
  }

  /* Formats Grid */
  .formats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .formats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .formats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--grid-gap, 1rem);
    }
  }

  .format-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(18rem, 24vw, 24rem);
    padding: clamp(1.75rem, 2.5vw, 2.25rem);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%), #0e0e10;
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .format-card:hover {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 100%), #141417;
    border-color: rgba(253, 75, 50, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.5);
  }

  .format-card-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .format-idx {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 700;
  }

  .format-badge {
    font-size: 0.8rem;
    color: var(--ink-muted);
    line-height: 1.3;
  }

  .format-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .format-desc {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.35;
  }

  /* Deliverables Grid */
  .deliverables-section {
    position: relative;
    background: #0B0B0C;
  }

  .deliverables-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .deliverables-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-gap, 1.25rem);
    }
  }

  .deliverable-card {
    padding: clamp(2rem, 3vw, 3rem);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.01) 100%), #0D0D0F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .deliverable-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .deliverable-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .deliverable-marker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-tint, #F7C8BF);
    font-weight: 700;
  }

  .deliverable-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    line-height: 1.15;
    color: #ffffff;
  }

  .deliverable-text {
    margin: 0;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.4;
  }

  /* Process Section (Block 4 - Radial & Linear Black Gradient) */
  .process-section {
    position: relative;
    background:
      radial-gradient(ellipse 70% 50% at 50% 50%, rgba(253, 75, 50, 0.05) 0%, transparent 70%),
      linear-gradient(to bottom, #0B0B0C 0%, #161619 40%, #18181C 50%, #161619 60%, #0B0B0C 100%);
  }

  /* Process List */
  .process-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

