---
import ProcessWork from '../../components/process-work/ProcessWork.astro';
import OfferingDetailTemplate from '../../components/proposal/OfferingDetailTemplate.astro';
import { servicesData, type ServiceData } from '../../data/servicesData';

export function getStaticPaths() {
  return Object.values(servicesData).map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: ServiceData; }
const { service } = Astro.props;
const url = new URL(`/services/${service.slug}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: service.name, serviceType: service.seo.h1, description: service.seo.description, provider: { '@type': 'ProfessionalService', name: 'Yapil', url: 'https://yapil.art', telephone: '+77067436197', email: 'hi@yapil.art' }, areaServed: ['KZ', 'UZ', 'RU', 'Worldwide'], url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
      { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://yapil.art/services' },
      { '@type': 'ListItem', position: 3, name: service.name, item: url },
    ] },
    { '@type': 'FAQPage', mainEntity: service.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
  ],
};
---

<OfferingDetailTemplate
  title={service.seo.title}
  description={service.seo.description}
  {jsonLd}
  section="services"
  slug={service.slug}
  name={service.name}
  heroH1={service.heroH1}
  heroLead={service.heroLead}
  metrics={service.metrics}
  firstTitle={service.formatsTitle}
  firstCards={service.formats.map((item) => ({ title: item.title, text: item.description }))}
  secondTitle={service.deliverablesTitle}
  secondCards={service.deliverables}
  rowsTitle={service.processTitle}
  rows={service.steps}
  casesTitle={service.casesTitle}
  caseSlugs={service.caseSlugs}
  faqTitle={service.faqTitle}
  faq={service.faq}
  linksTitle={service.crossLinksTitle}
  links={service.crossLinks}
  ctaTitle={service.ctaTitle}
  ctaLead={service.ctaLead}
>
  {service.slug === 'websites' && <ProcessWork slot="process-work" embedded />}
</OfferingDetailTemplate>
