---
interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props;
const isLight = theme === 'light';
---

<section class:list={['contacts section', { 'theme-light': isLight }]} id="contacts" aria-labelledby="contacts-title">
  <div class="container">
    <div class="contacts-grid">
      <!-- Left side: Cover (columns 1-8) -->
      <div class="contacts-cover" id="contacts-cover">
        <div class="contacts-cover-inner">
          <div class="contacts-cover-header">
            <h2 class="display-title" id="contacts-title">Нашли задачу,<br />похожую на вашу?</h2>
          </div>
          <p class="contacts-cover-lead">
            Расскажите о задаче или заполните форму — ответим в течение нескольких часов и подготовим предложение.
          </p>
          <div class="contacts-cover-links">
            <a href="https://t.me/yakov_pil" target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">Telegram</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="https://wa.me/77067436197" target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">WhatsApp</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="mailto:hi@yapil.art" class="contact-link-pill">
              <span class="contact-link-label">hi@yapil.art</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right side: Feedback Form (columns 9-12) -->
      <div class="feedback-panel">
        <div class="feedback-card">
          <form class="feedback-form" id="contact-feedback-form" novalidate>
            <!-- 1. Name -->
            <div class="form-group">
              <label class="form-label" for="client-name">
                Имя <span class="required-star" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="client-name"
                name="name"
                class="form-control"
                placeholder="Как к вам обращаться"
                required
                autocomplete="name"
              />
              <span class="field-error" id="name-error" aria-live="polite"></span>
            </div>

            <!-- 2. Phone with automatic mask -->
            <div class="form-group">
              <label class="form-label" for="client-phone">
                Номер телефона <span class="required-star" aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="client-phone"
                name="phone"
                class="form-control"
                placeholder="+7 (___) ___-__-__"
                required
                autocomplete="tel"
                inputmode="tel"
              />
              <span class="field-error" id="phone-error" aria-live="polite"></span>
            </div>

            <!-- 3. What interests you (Service Chips) -->
            <div class="form-group">
              <label class="form-label" id="services-label">Что вас интересует?</label>
              <div class="service-chips" role="group" aria-labelledby="services-label">
                <label class="chip">
                  <input type="checkbox" name="services" value="Сайты" />
                  <span class="chip-label">Сайты</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="Айдентика" />
                  <span class="chip-label">Айдентика</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="Полиграфия" />
                  <span class="chip-label">Полиграфия</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="SMM" />
                  <span class="chip-label">SMM</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="Презентации" />
                  <span class="chip-label">Презентации</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="Дизайн-поддержка" />
                  <span class="chip-label">Поддержка</span>
                </label>
              </div>
            </div>

            <!-- 4. Message (About task) -->
            <div class="form-group">
              <label class="form-label" for="client-message">О задаче</label>
              <textarea
                id="client-message"
                name="message"
                class="form-control form-textarea"
                rows="3"
                placeholder="Кратко расскажите о вашей задаче, пожеланиях по срокам или приложите ссылки"
              ></textarea>
            </div>

            <!-- 5. Consent Checkbox -->
            <div class="consent-group">
              <label class="form-consent" for="privacy-consent">
                <input
                  type="checkbox"
                  name="privacy"
                  id="privacy-consent"
                  class="consent-checkbox"
                  checked
                  required
                />
                <span class="consent-custom-box" aria-hidden="true">
                  <svg class="consent-check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square">
                    <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
                  </svg>
                </span>
                <span class="form-disclaimer">
                  Нажимая «Отправить заявку», вы соглашаетесь с условиями <a href="/privacy" target="_blank" rel="noopener noreferrer">конфиденциальности</a>.
                </span>
              </label>
              <span class="field-error" id="privacy-error" aria-live="polite"></span>
            </div>

            <!-- 6. Submit Button -->
            <div class="form-actions">
              <button type="submit" class="submit-button" id="submit-button">
                <span class="btn-inner">
                  <span class="btn-text">Отправить заявку</span>
                  <span class="btn-icon" aria-hidden="true">→</span>
                </span>
              </button>
            </div>
          </form>

          <!-- Success State Overlay -->
          <div class="form-success-state" id="form-success-message" aria-hidden="true">
            <div class="success-icon-wrap">
              <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h4 class="success-title">Заявка успешно отправлена!</h4>
            <p class="success-text">
              Спасибо за обращение. Мы изучим вашу задачу и ответим в ближайшее время.
            </p>
            <button type="button" class="reset-button" id="reset-form-btn">
              <span class="reset-btn-inner">
                <span class="reset-btn-text">Отправить ещё одну заявку</span>
                <span class="reset-btn-icon" aria-hidden="true">↺</span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupPhoneMask(phoneInput: HTMLInputElement) {
    const formatPhone = () => {
      const digits = phoneInput.value.replace(/\D/g, '');
      if (!digits) {
        phoneInput.value = '';
        return;
      }

      let raw = digits;
      if (raw.startsWith('8') || raw.startsWith('7')) {
        raw = '7' + raw.slice(1);
      } else {
        raw = '7' + raw;
      }

      raw = raw.slice(0, 11);

      let res = '+7';
      if (raw.length > 1) {
        res += ' (' + raw.slice(1, 4);
      }
      if (raw.length > 4) {
        res += ') ' + raw.slice(4, 7);
      }
      if (raw.length > 7) {
        res += '-' + raw.slice(7, 9);
      }
      if (raw.length > 9) {
        res += '-' + raw.slice(9, 11);
      }

      phoneInput.value = res;
    };

    phoneInput.addEventListener('input', formatPhone);

    phoneInput.addEventListener('focus', () => {
      if (!phoneInput.value) {
        phoneInput.value = '+7 (';
      }
    });

    phoneInput.addEventListener('blur', () => {
      if (phoneInput.value === '+7' || phoneInput.value === '+7 (' || phoneInput.value === '+7 ()') {
        phoneInput.value = '';
      }
    });

    phoneInput.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && phoneInput.value.length <= 4) {
        phoneInput.value = '';
      }
    });
  }

  function initContactForm() {
    const form = document.getElementById('contact-feedback-form') as HTMLFormElement | null;
    const successState = document.getElementById('form-success-message');
    const resetBtn = document.getElementById('reset-form-btn');
    const nameInput = document.getElementById('client-name') as HTMLInputElement | null;
    const phoneInput = document.getElementById('client-phone') as HTMLInputElement | null;
    const privacyCheckbox = document.getElementById('privacy-consent') as HTMLInputElement | null;
    const nameError = document.getElementById('name-error');
    const phoneError = document.getElementById('phone-error');
    const privacyError = document.getElementById('privacy-error');
    const submitBtn = document.getElementById('submit-button');

    if (!form || !successState || !resetBtn || !nameInput || !phoneInput) return;

    setupPhoneMask(phoneInput);

    function clearErrors() {
      if (nameError) nameError.textContent = '';
      if (phoneError) phoneError.textContent = '';
      if (privacyError) privacyError.textContent = '';
      nameInput?.classList.remove('has-error');
      phoneInput?.classList.remove('has-error');
      privacyCheckbox?.classList.remove('has-error');
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();

      let hasError = false;
      const nameVal = nameInput.value.trim();
      const phoneVal = phoneInput.value.trim();
      const phoneDigits = phoneVal.replace(/\D/g, '');

      if (!nameVal) {
        if (nameError) nameError.textContent = 'Пожалуйста, укажите имя';
        nameInput.classList.add('has-error');
        nameInput.focus();
        hasError = true;
      }

      if (!phoneVal || phoneDigits.length < 11) {
        if (phoneError) phoneError.textContent = 'Пожалуйста, укажите полный номер телефона';
        phoneInput.classList.add('has-error');
        if (!hasError) phoneInput.focus();
        hasError = true;
      }

      if (privacyCheckbox && !privacyCheckbox.checked) {
        if (privacyError) privacyError.textContent = 'Необходимо согласие с условиями';
        privacyCheckbox.classList.add('has-error');
        if (!hasError) privacyCheckbox.focus();
        hasError = true;
      }

      if (hasError) return;

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        const btnText = submitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Отправка...';
      }

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        services: formData.getAll('services'),
        message: formData.get('message'),
        date: new Date().toISOString(),
      };

      try {
        const stored = JSON.parse(localStorage.getItem('yapil_inquiries') || '[]');
        stored.push(data);
        localStorage.setItem('yapil_inquiries', JSON.stringify(stored));
      } catch (err) {
        // ignore localStorage errors
      }

      setTimeout(() => {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = 'Отправить заявку';
        }
        form.style.display = 'none';
        successState.classList.add('is-visible');
        successState.setAttribute('aria-hidden', 'false');
      }, 400);
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      clearErrors();
      form.style.display = 'flex';
      successState.classList.remove('is-visible');
      successState.setAttribute('aria-hidden', 'true');
    });

    nameInput.addEventListener('input', () => {
      if (nameInput.classList.contains('has-error') && nameInput.value.trim()) {
        nameInput.classList.remove('has-error');
        if (nameError) nameError.textContent = '';
      }
    });

    phoneInput.addEventListener('input', () => {
      const phoneDigits = phoneInput.value.replace(/\D/g, '');
      if (phoneInput.classList.contains('has-error') && phoneDigits.length === 11) {
        phoneInput.classList.remove('has-error');
        if (phoneError) phoneError.textContent = '';
      }
    });

    privacyCheckbox?.addEventListener('change', () => {
      if (privacyCheckbox.checked) {
        privacyCheckbox.classList.remove('has-error');
        if (privacyError) privacyError.textContent = '';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initContactForm);
  initContactForm();
</script>

<style>
  .contacts {
    position: relative;
    padding-block: clamp(4rem, 7vw, 7.5rem);
    color: var(--ink-primary);
    background:
      radial-gradient(ellipse 90% 70% at 50% 50%, rgba(253, 75, 50, 0.28) 0%, rgba(163, 42, 23, 0.18) 45%, transparent 75%),
      linear-gradient(to bottom, #0b0b0c 0%, #1c0a07 25%, #4a1309 50%, #1c0a07 75%, #0b0b0c 100%);
  }

  .contacts.theme-light {
    color: var(--ink-primary);
    background:
      radial-gradient(ellipse 90% 70% at 50% 50%, rgba(253, 75, 50, 0.16) 0%, rgba(253, 75, 50, 0.05) 45%, transparent 75%),
      linear-gradient(to bottom, #EAE5DF 0%, #F5EFEB 25%, #FFF0EB 50%, #F5EFEB 75%, #EAE5DF 100%);
  }

  .contacts.theme-light .contacts-cover {
    background: #FFFFFF;
    color: #1D1D1D;
    border: 1px solid #D5D2CE;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.06);
  }

  .contacts.theme-light .contacts-cover .display-title {
    color: #1D1D1D;
  }

  .contacts.theme-light .contacts-cover-lead {
    color: #66635F;
  }

  .contacts.theme-light .contact-link-pill {
    background: #F6F4F2;
    border: 1px solid #E2DED9;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-pill:hover {
    background: #EDEAE6;
    border-color: #1D1D1D;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-arrow {
    color: var(--accent);
  }

  .contacts.theme-light .feedback-card {
    border: 1px solid #D5D2CE;
  }

  .contacts-grid {
    display: grid;
    gap: var(--grid-gap, clamp(0.75rem, 1.2vw, 1.5rem));
    align-items: stretch;
  }

  @media (min-width: 58rem) {
    .contacts-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contacts-cover {
      grid-column: 1 / span 8;
    }

    .feedback-panel {
      grid-column: 9 / span 4;
    }
  }

  /* Left Cover (cols 1-8) */
  .contacts-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(24rem, 38vw, 36rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    background: #0B0B0C;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: transform var(--duration-pushback, 1575ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                opacity var(--duration-pushback, 1575ms) ease;
    transform-origin: left center;
  }

  /* Inverse Parallax on cover when hovering submit button */
  .contacts-grid:has(.submit-button:hover:not(:disabled)) .contacts-cover,
  .contacts-grid:has(.submit-button:focus-visible:not(:disabled)) .contacts-cover {
    transform: scale(0.99) translateY(-2px);
    opacity: 0.92;
  }

  .contacts-cover-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 2rem;
  }

  .contacts-cover-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contacts-cover .display-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
  }

  .contacts-cover-lead {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.3;
    color: #A0A0A0;
    max-width: 32rem;
  }

  .contacts-cover-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem clamp(0.65rem, 1.2vw, 1rem);
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .contact-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .contact-link-pill:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  .contact-link-arrow {
    color: var(--accent);
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .contact-link-pill:hover .contact-link-arrow {
    transform: translate(2px, -2px);
  }

  /* Feedback Form Card (Light background, cols 9-12) */
  .feedback-panel {
    position: relative;
    perspective: 1000px;
    width: 100%;
    display: flex;
    container-type: inline-size;
  }

  .feedback-card {
    position: relative;
    background: #FFFFFF;
    color: #1D1D1D;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid var(--ink-primary);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.12);
    transform-style: preserve-3d;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    flex: 1;
    justify-content: space-between;
  }

  .form-group,
  .form-row,
  .consent-group,
  .form-disclaimer {
    transform-origin: center center;
    transition: transform var(--duration-pushback, 1575ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                opacity var(--duration-pushback, 1575ms) ease;
  }

  .feedback-card:has(.submit-button:hover:not(:disabled)) .form-group,
  .feedback-card:has(.submit-button:hover:not(:disabled)) .form-row,
  .feedback-card:has(.submit-button:hover:not(:disabled)) .consent-group,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .form-group,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .form-row,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .consent-group {
    transform: scale(0.988) translateY(-1px);
    opacity: 0.92;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-row {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
  }

  @container (min-width: 28rem) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
  }

  .required-star {
    color: var(--accent);
  }

  /* Chips */
  .service-chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
    width: 100%;
  }

  @container (max-width: 22rem) {
    .service-chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .chip {
    cursor: pointer;
    user-select: none;
    display: flex;
    width: 100%;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip-label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.65rem 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-primary);
    background: #F6F4F2;
    border: 1px solid #E2DED9;
    transition: all 0.15s ease;
    text-align: center;
    white-space: nowrap;
  }

  .chip:hover .chip-label {
    border-color: var(--ink-primary);
    background: #EDEAE6;
  }

  .chip input:checked + .chip-label {
    background: var(--ink-primary);
    color: #FFFFFF;
    border-color: var(--ink-primary);
  }

  .chip input:focus-visible + .chip-label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Input fields */
  .form-control {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink-primary);
    background: #FFFFFF;
    border: 1px solid #D5D2CE;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-control::placeholder {
    color: #A09D98;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .form-control.has-error {
    border-color: #DC2626;
    background: #FFFBFB;
  }

  .form-textarea {
    resize: vertical;
    min-height: 5.5rem;
    line-height: 1.45;
  }

  .field-error {
    font-size: 0.78rem;
    color: #DC2626;
    min-height: 1rem;
  }

  /* Form actions */
  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* 2. Submit Button Container Scaling & Elastic Spring Easing */
  .submit-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.05rem 2.2rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: #FFFFFF;
    background: var(--ink-primary);
    border: 1px solid var(--ink-primary);
    cursor: pointer;
    transform-origin: center center;
    will-change: transform, box-shadow, background;
    transition:
      transform var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      background var(--duration-btn-color, 770ms) ease,
      border-color var(--duration-btn-color, 770ms) ease,
      box-shadow var(--duration-btn, 1330ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .submit-button:hover:not(:disabled),
  .submit-button:focus-visible:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.055) translateY(-2px);
    box-shadow: 0 14px 28px -6px rgba(253, 75, 50, 0.36), 0 4px 12px rgba(0, 0, 0, 0.12);
  }

  .submit-button:active:not(:disabled) {
    transform: scale(0.99) translateY(0);
