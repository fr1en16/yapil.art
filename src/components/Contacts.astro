---
import type { LeadSource } from '../lib/crmTypes';
import { getWhatsAppUrl } from '../utils/messengerLinks';
import ContactFormCard from './ContactFormCard.astro';

interface Props {
  theme?: 'dark' | 'light';
  title?: string;
  lead?: string;
  successText?: string;
  source?: LeadSource;
  sourceDetails?: string;
  selectedService?: string;
  blendFromAccent?: boolean;
  gradientToDark?: boolean;
  lang?: 'ru' | 'en';
}

const {
  theme = 'dark',
  title,
  lead,
  successText,
  source = 'contacts_form',
  sourceDetails,
  selectedService,
  blendFromAccent = false,
  gradientToDark = false,
  lang = 'ru',
} = Astro.props;
const isLight = theme === 'light';
const isEn = lang === 'en';

const displayTitle = title ?? (isEn ? 'Have a project<br />in mind?' : 'Нашли задачу,<br />похожую на вашу?');
const displayLead = lead ?? (isEn
  ? 'Tell me about your task or fill out the form — I will reply within 2 hours with a proposal.'
  : 'Расскажите о задаче или заполните форму — ответим в течение 2 часов и подготовим предложение.');
const displaySuccessText = successText ?? (isEn
  ? 'Thank you for reaching out. I will review your project and reply within 2 hours.'
  : 'Спасибо за обращение. Мы изучим вашу задачу и ответим в течение 2 часов.');
const displaySourceDetails = sourceDetails ?? (isEn ? 'Contact form' : 'Форма контактов на странице');

const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, Astro.site).href;
const whatsappHref = getWhatsAppUrl({
  pageUrl: currentUrl,
  sourceContext: source,
});
---

<section
  class:list={[
    'contacts section',
    {
      'theme-light': isLight,
      'blend-from-accent': blendFromAccent && !isLight,
      'gradient-to-dark': gradientToDark,
    },
  ]}
  id="contacts"
  aria-labelledby="contacts-title"
>
  <div class="container">
    <div class="contacts-grid">
      <!-- Left side: Cover (columns 1-8) -->
      <div class="contacts-cover" id="contacts-cover">
        <div class="contacts-cover-inner">
          <div class="contacts-cover-header">
            <h2 class="display-title" id="contacts-title">
              <Fragment set:html={displayTitle} />
            </h2>
          </div>
          <p class="contacts-cover-lead">
            {displayLead}
          </p>
          <div class="contacts-cover-links">
            <a href="https://t.me/yakov_pil" target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">Telegram</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">WhatsApp</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="mailto:hi@yapil.art" class="contact-link-pill">
              <span class="contact-link-label">hi@yapil.art</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right side: Feedback Form (columns 9-12) -->
      <div class="feedback-panel">
        <ContactFormCard
          source={source}
          sourceDetails={displaySourceDetails}
          selectedService={selectedService}
          successText={displaySuccessText}
          lang={lang}
          bordered={!gradientToDark}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .contacts {
    position: relative;
    padding-top: clamp(4rem, 7vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--ink-primary);
    scroll-margin-top: 4rem;
    background: linear-gradient(
      to bottom,
      #000000 0%,
      #0B0B0C 35%,
      #0B0B0C 100%
    );
  }

  .contacts.theme-light {
    color: var(--ink-primary);
    background: var(--page-neutral-surface, #EAE5DF);
  }

  .contacts.gradient-to-dark {
    background: linear-gradient(
      to bottom,
      #f5f5f5 0%,
      #f5f5f5 14%,
      var(--bg-section-dark) 78%,
      var(--bg-section-dark) 100%
    );
  }

  .contacts.blend-from-accent {
    padding-top: clamp(7rem, 12vw, 12rem);
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.22) 24%,
      rgba(0, 0, 0, 0.58) 56%,
      rgba(0, 0, 0, 0.86) 82%,
      #000000 100%
    );
  }

  .contacts.theme-light .contacts-cover {
    background: var(--page-neutral-surface, #FFFFFF);
    color: #1D1D1D;
    border: 1px solid #D5D2CE;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.06);
  }

  .contacts.theme-light .contacts-cover .display-title {
    color: #1D1D1D;
  }

  .contacts.theme-light .contacts-cover-lead {
    color: #66635F;
  }

  .contacts.theme-light .contact-link-pill {
    background: var(--page-neutral-surface, #F6F4F2);
    border: 1px solid #E2DED9;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-pill:hover {
    background: var(--page-neutral-surface, #EDEAE6);
    border-color: #1D1D1D;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-arrow {
    color: var(--accent);
  }

  .contacts.gradient-to-dark .contacts-cover {
    border: 0;
  }

  .contacts-grid {
    display: grid;
    gap: var(--grid-gap, clamp(0.75rem, 1.2vw, 1.5rem));
    align-items: stretch;
  }

  @media (min-width: 58rem) {
    .contacts-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contacts-cover {
      grid-column: 1 / span 8;
    }

    .feedback-panel {
      grid-column: 9 / span 4;
    }
  }

  /* Left Cover (cols 1-8) */
  .contacts-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(24rem, 38vw, 36rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    background: #0B0B0C;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: transform var(--duration-pushback, 1575ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                opacity var(--duration-pushback, 1575ms) ease;
    transform-origin: left center;
  }

  /* Inverse Parallax on cover when hovering submit button */
  .contacts-grid:has(:global(.submit-button):hover:not(:disabled)) .contacts-cover,
  .contacts-grid:has(:global(.submit-button):focus-visible:not(:disabled)) .contacts-cover {
    transform: scale(0.99) translateY(-2px);
    opacity: 0.92;
  }

  .contacts-cover-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 2rem;
  }

  .contacts-cover-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contacts-cover .display-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
  }

  .contacts-cover-lead {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.3;
    color: #A0A0A0;
    max-width: 32rem;
  }

  .contacts-cover-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem clamp(0.65rem, 1.2vw, 1rem);
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .contact-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .contact-link-pill:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  .contact-link-arrow {
    color: var(--accent);
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .contact-link-pill:hover .contact-link-arrow {
    transform: translate(2px, -2px);
  }

  /* Feedback Form Card (Light background, cols 9-12) */
  .feedback-panel {
    position: relative;
    perspective: 1000px;
    width: 100%;
    display: flex;
    container-type: inline-size;
  }

  @media (prefers-reduced-motion: reduce) {
    .contacts-cover {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
