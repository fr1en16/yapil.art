---
import type { LeadSource } from '../lib/crmTypes';
import { getWhatsAppUrl } from '../utils/messengerLinks';

interface Props {
  theme?: 'dark' | 'light';
  title?: string;
  lead?: string;
  successText?: string;
  source?: LeadSource;
  sourceDetails?: string;
  selectedService?: string;
  blendFromAccent?: boolean;
  lang?: 'ru' | 'en';
}

const {
  theme = 'dark',
  title,
  lead,
  successText,
  source = 'contacts_form',
  sourceDetails,
  selectedService,
  blendFromAccent = false,
  lang = 'ru',
} = Astro.props;
const isLight = theme === 'light';
const isEn = lang === 'en';

const displayTitle = title ?? (isEn ? 'Have a project<br />in mind?' : 'Нашли задачу,<br />похожую на вашу?');
const displayLead = lead ?? (isEn
  ? 'Tell me about your task or fill out the form — I will reply within 2 hours with a proposal.'
  : 'Расскажите о задаче или заполните форму — ответим в течение 2 часов и подготовим предложение.');
const displaySuccessText = successText ?? (isEn
  ? 'Thank you for reaching out. I will review your project and reply within 2 hours.'
  : 'Спасибо за обращение. Мы изучим вашу задачу и ответим в течение 2 часов.');
const displaySourceDetails = sourceDetails ?? (isEn ? 'Contact form' : 'Форма контактов на странице');

const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, Astro.site).href;
const whatsappHref = getWhatsAppUrl({
  pageUrl: currentUrl,
  sourceContext: source,
});
---

<section
  class:list={['contacts section', { 'theme-light': isLight, 'blend-from-accent': blendFromAccent && !isLight }]}
  id="contacts"
  aria-labelledby="contacts-title"
>
  <div class="container">
    <div class="contacts-grid">
      <!-- Left side: Cover (columns 1-8) -->
      <div class="contacts-cover" id="contacts-cover">
        <div class="contacts-cover-inner">
          <div class="contacts-cover-header">
            <h2 class="display-title" id="contacts-title">
              <Fragment set:html={displayTitle} />
            </h2>
          </div>
          <p class="contacts-cover-lead">
            {displayLead}
          </p>
          <div class="contacts-cover-links">
            <a href="https://t.me/yakov_pil" target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">Telegram</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="contact-link-pill">
              <span class="contact-link-label">WhatsApp</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="mailto:hi@yapil.art" class="contact-link-pill">
              <span class="contact-link-label">hi@yapil.art</span>
              <span class="contact-link-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right side: Feedback Form (columns 9-12) -->
      <div class="feedback-panel">
        <div class="feedback-card">
          <form class="feedback-form" data-source={source} data-source-details={displaySourceDetails} data-lang={lang} novalidate>
            <!-- 1. Name -->
            <div class="form-group">
              <label class="form-label" for="client-name">
                {isEn ? 'Name' : 'Имя'}
              </label>
              <input
                type="text"
                id="client-name"
                name="name"
                class="form-control"
                placeholder={isEn ? 'How to address you' : 'Как к вам обращаться'}
                autocomplete="name"
              />
              <span class="field-error field-error-name" id="name-error" aria-live="polite"></span>
            </div>

            <!-- 2. Phone with automatic mask -->
            <div class="form-group">
              <label class="form-label" for="client-phone">
                {isEn ? 'Phone number' : 'Номер телефона'} <span class="required-star" aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="client-phone"
                name="phone"
                class="form-control"
                placeholder={isEn ? '+1 (___) ___ ____' : '+7 (___) ___-__-__'}
                required
                autocomplete="tel"
                inputmode="tel"
              />
              <span class="field-error field-error-phone" id="phone-error" aria-live="polite"></span>
            </div>

            <!-- 3. What interests you (Service Chips) -->
            <div class="form-group" hidden style="display: none;">
              <label class="form-label" id="services-label">{isEn ? 'What interests you?' : 'Что вас интересует?'}</label>
              <div class="service-chips" role="group" aria-labelledby="services-label">
                <label class="chip">
                  <input type="checkbox" name="services" value={isEn ? 'Websites' : 'Сайты'} checked={selectedService === 'Сайты' || selectedService === 'Websites'} />
                  <span class="chip-label">{isEn ? 'Websites' : 'Сайты'}</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value={isEn ? 'Identity' : 'Айдентика'} checked={selectedService === 'Айдентика' || selectedService === 'Identity'} />
                  <span class="chip-label">{isEn ? 'Identity' : 'Айдентика'}</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value={isEn ? 'Print' : 'Полиграфия'} checked={selectedService === 'Полиграфия' || selectedService === 'Print'} />
                  <span class="chip-label">{isEn ? 'Print' : 'Полиграфия'}</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value="SMM" checked={selectedService === 'SMM'} />
                  <span class="chip-label">SMM</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value={isEn ? 'Presentations' : 'Презентации'} checked={selectedService === 'Презентации' || selectedService === 'Presentations'} />
                  <span class="chip-label">{isEn ? 'Presentations' : 'Презентации'}</span>
                </label>
                <label class="chip">
                  <input type="checkbox" name="services" value={isEn ? 'Support' : 'Сопровождение'} checked={selectedService === 'Сопровождение' || selectedService === 'Support'} />
                  <span class="chip-label">{isEn ? 'Support' : 'Сопровождение'}</span>
                </label>
              </div>
            </div>

            <!-- 4. Message (About task) -->
            <div class="form-group">
              <label class="form-label" for="client-message">{isEn ? 'About the task' : 'О задаче'}</label>
              <textarea
                id="client-message"
                name="message"
                class="form-control form-textarea"
                rows="3"
                placeholder={isEn
                  ? 'Briefly describe your task, preferred timeline, or include links to materials'
                  : 'Кратко расскажите о вашей задаче, пожеланиях по срокам или приложите ссылки'}
              ></textarea>
            </div>

            <!-- 5. Consent Checkbox -->
            <div class="consent-group">
              <label class="form-consent" for="privacy-consent">
                <input
                  type="checkbox"
                  name="privacy"
                  id="privacy-consent"
                  class="consent-checkbox"
                  checked
                />
                <span class="consent-custom-box" aria-hidden="true">
                  <svg class="consent-check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square">
                    <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
                  </svg>
                </span>
                <span class="form-disclaimer">
                  {isEn ? (
                    <>By clicking "Send request", you agree to the <a href="/privacy" target="_blank" rel="noopener noreferrer">privacy policy</a>.</>
                  ) : (
                    <>Нажимая «Отправить заявку», вы соглашаетесь с условиями <a href="/privacy" target="_blank" rel="noopener noreferrer">конфиденциальности</a>.</>
                  )}
                </span>
              </label>
              <span class="field-error field-error-privacy" id="privacy-error" aria-live="polite"></span>
            </div>

            <!-- 6. Submit Button -->
            <div class="form-actions">
              <button type="submit" class="submit-button">
                <span class="btn-inner">
                  <span class="btn-text">{isEn ? 'Send request' : 'Отправить заявку'}</span>
                  <span class="btn-icon" aria-hidden="true">→</span>
                </span>
              </button>
            </div>
          </form>

          <!-- Success State Overlay -->
          <div class="form-success-state" aria-hidden="true">
            <div class="success-icon-wrap">
              <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h4 class="success-title">{isEn ? 'Request sent successfully!' : 'Заявка успешно отправлена!'}</h4>
            <p class="success-text">
              {displaySuccessText}
            </p>
            <button type="button" class="reset-button">
              <span class="reset-btn-inner">
                <span class="reset-btn-text">{isEn ? 'Send another request' : 'Отправить ещё одну заявку'}</span>
                <span class="reset-btn-icon" aria-hidden="true">↺</span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { submitLead } from '../lib/crmStore';
  import type { LeadSource } from '../lib/crmTypes';

  function setupPhoneMask(phoneInput: HTMLInputElement) {
    const formatPhone = () => {
      const digits = phoneInput.value.replace(/\D/g, '');
      if (!digits) {
        phoneInput.value = '';
        return;
      }

      let raw = digits;
      if (raw.startsWith('8') || raw.startsWith('7')) {
        raw = '7' + raw.slice(1);
      } else {
        raw = '7' + raw;
      }

      raw = raw.slice(0, 11);

      let res = '+7';
      if (raw.length > 1) {
        res += ' (' + raw.slice(1, 4);
      }
      if (raw.length > 4) {
        res += ') ' + raw.slice(4, 7);
      }
      if (raw.length > 7) {
        res += '-' + raw.slice(7, 9);
      }
      if (raw.length > 9) {
        res += '-' + raw.slice(9, 11);
      }

      phoneInput.value = res;
    };

    phoneInput.addEventListener('input', formatPhone);

    phoneInput.addEventListener('focus', () => {
      if (!phoneInput.value) {
        phoneInput.value = '+7 (';
      }
    });

    phoneInput.addEventListener('blur', () => {
      if (phoneInput.value === '+7' || phoneInput.value === '+7 (' || phoneInput.value === '+7 ()') {
        phoneInput.value = '';
      }
    });

    phoneInput.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && phoneInput.value.length <= 4) {
        phoneInput.value = '';
      }
    });
  }

  function initContactForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.feedback-form');
    forms.forEach((form) => {
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const card = form.closest('.feedback-card') || form.parentElement;
      const successState = card?.querySelector('.form-success-state') as HTMLElement | null;
      const resetBtn = card?.querySelector('.reset-button') as HTMLButtonElement | null;
      const nameInput = form.querySelector('input[name="name"]') as HTMLInputElement | null;
      const phoneInput = form.querySelector('input[name="phone"]') as HTMLInputElement | null;
      const privacyCheckbox = form.querySelector('input[name="privacy"]') as HTMLInputElement | null;
      const nameError = form.querySelector('.field-error-name, #name-error') as HTMLElement | null;
      const phoneError = form.querySelector('.field-error-phone, #phone-error') as HTMLElement | null;
      const privacyError = form.querySelector('.field-error-privacy, #privacy-error') as HTMLElement | null;
      const submitBtn = form.querySelector('.submit-button') as HTMLButtonElement | null;

      const isEn = form.dataset.lang === 'en';

      if (!nameInput || !phoneInput) return;

      if (!isEn) {
        setupPhoneMask(phoneInput);
      }

      function clearErrors() {
        if (nameError) nameError.textContent = '';
        if (phoneError) phoneError.textContent = '';
        if (privacyError) privacyError.textContent = '';
        nameInput?.classList.remove('has-error');
        phoneInput?.classList.remove('has-error');
        privacyCheckbox?.classList.remove('has-error');
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        clearErrors();

        let hasError = false;
        const phoneVal = phoneInput.value.trim();
        const phoneDigits = phoneVal.replace(/\D/g, '');

        if (isEn) {
          if (!phoneVal || phoneDigits.length < 7 || phoneDigits.length > 15) {
            if (phoneError) phoneError.textContent = 'Please enter your full phone number';
            phoneInput.classList.add('has-error');
            if (!hasError) phoneInput.focus();
            hasError = true;
          }
        } else {
          if (!phoneVal || phoneDigits.length < 11) {
            if (phoneError) phoneError.textContent = 'Пожалуйста, укажите полный номер телефона';
            phoneInput.classList.add('has-error');
            if (!hasError) phoneInput.focus();
            hasError = true;
          }
        }

        if (hasError) return;

        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = isEn ? 'Sending...' : 'Отправка...';
        }

        const formData = new FormData(form);
        const services = formData.getAll('services') as string[];
        const name = String(formData.get('name') || '').trim();
        const phone = String(formData.get('phone') || '').trim();
        const message = String(formData.get('message') || '').trim();
        const source = (form.dataset.source || 'contacts_form') as LeadSource;
        const sourceDetails = form.dataset.sourceDetails || (isEn ? 'Contact form' : 'Форма контактов на странице');

        // Submit to central CRM lead receiver
        submitLead({
          name,
          phone,
          services: services.length > 0 ? services : [isEn ? 'Consultation' : 'Консультация'],
          message,
          source,
          sourceDetails,
        }).catch((err) => {
          console.error('CRM submit error:', err);
        });

        // Legacy storage fallback
        try {
          const stored = JSON.parse(localStorage.getItem('yapil_inquiries') || '[]');
          stored.push({ name, phone, services, message, date: new Date().toISOString() });
          localStorage.setItem('yapil_inquiries', JSON.stringify(stored));
        } catch {
          // ignore localStorage errors
        }

        setTimeout(() => {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = isEn ? 'Send request' : 'Отправить заявку';
          }
          form.style.display = 'none';
          if (successState) {
            successState.classList.add('is-visible');
            successState.setAttribute('aria-hidden', 'false');
          }
        }, 400);
      });

      if (resetBtn && successState) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          clearErrors();
          form.style.display = 'flex';
          successState.classList.remove('is-visible');
          successState.setAttribute('aria-hidden', 'true');
        });
      }

      nameInput.addEventListener('input', () => {
        if (nameInput.classList.contains('has-error') && nameInput.value.trim()) {
          nameInput.classList.remove('has-error');
          if (nameError) nameError.textContent = '';
        }
      });

      phoneInput.addEventListener('input', () => {
        const phoneDigits = phoneInput.value.replace(/\D/g, '');
        if (phoneInput.classList.contains('has-error') && phoneDigits.length === 11) {
          phoneInput.classList.remove('has-error');
          if (phoneError) phoneError.textContent = '';
        }
      });

      privacyCheckbox?.addEventListener('change', () => {
        if (privacyCheckbox.checked) {
          privacyCheckbox.classList.remove('has-error');
          if (privacyError) privacyError.textContent = '';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initContactForms);
  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>

<style>
  .contacts {
    position: relative;
    padding-top: clamp(4rem, 7vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--ink-primary);
    scroll-margin-top: 4rem;
    background: linear-gradient(
      to bottom,
      #000000 0%,
      #0B0B0C 35%,
      #0B0B0C 100%
    );
  }

  .contacts.theme-light {
    color: var(--ink-primary);
    background: var(--page-neutral-surface, #EAE5DF);
  }

  .contacts.blend-from-accent {
    padding-top: clamp(7rem, 12vw, 12rem);
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.22) 24%,
      rgba(0, 0, 0, 0.58) 56%,
      rgba(0, 0, 0, 0.86) 82%,
      #000000 100%
    );
  }

  .contacts.theme-light .contacts-cover {
    background: var(--page-neutral-surface, #FFFFFF);
    color: #1D1D1D;
    border: 1px solid #D5D2CE;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.06);
  }

  .contacts.theme-light .contacts-cover .display-title {
    color: #1D1D1D;
  }

  .contacts.theme-light .contacts-cover-lead {
    color: #66635F;
  }

  .contacts.theme-light .contact-link-pill {
    background: var(--page-neutral-surface, #F6F4F2);
    border: 1px solid #E2DED9;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-pill:hover {
    background: var(--page-neutral-surface, #EDEAE6);
    border-color: #1D1D1D;
    color: #1D1D1D;
  }

  .contacts.theme-light .contact-link-arrow {
    color: var(--accent);
  }

  .contacts.theme-light .feedback-card {
    border: 1px solid #D5D2CE;
  }

  .contacts-grid {
    display: grid;
    gap: var(--grid-gap, clamp(0.75rem, 1.2vw, 1.5rem));
    align-items: stretch;
  }

  @media (min-width: 58rem) {
    .contacts-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contacts-cover {
      grid-column: 1 / span 8;
    }

    .feedback-panel {
      grid-column: 9 / span 4;
    }
  }

  /* Left Cover (cols 1-8) */
  .contacts-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(24rem, 38vw, 36rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    background: #0B0B0C;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: transform var(--duration-pushback, 1575ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                opacity var(--duration-pushback, 1575ms) ease;
    transform-origin: left center;
  }

  /* Inverse Parallax on cover when hovering submit button */
  .contacts-grid:has(.submit-button:hover:not(:disabled)) .contacts-cover,
  .contacts-grid:has(.submit-button:focus-visible:not(:disabled)) .contacts-cover {
    transform: scale(0.99) translateY(-2px);
    opacity: 0.92;
  }

  .contacts-cover-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 2rem;
  }

  .contacts-cover-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contacts-cover .display-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #FFFFFF;
  }

  .contacts-cover-lead {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.3;
    color: #A0A0A0;
    max-width: 32rem;
  }

  .contacts-cover-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem clamp(0.65rem, 1.2vw, 1rem);
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .contact-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .contact-link-pill:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  .contact-link-arrow {
    color: var(--accent);
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .contact-link-pill:hover .contact-link-arrow {
    transform: translate(2px, -2px);
  }

  /* Feedback Form Card (Light background, cols 9-12) */
  .feedback-panel {
    position: relative;
    perspective: 1000px;
    width: 100%;
    display: flex;
    container-type: inline-size;
  }

  .feedback-card {
    --ink-primary: #1D1D1D;
    --ink-muted: #66635F;
    position: relative;
    background: var(--page-neutral-surface, #FFFFFF);
    color: #1D1D1D;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid #D5D2CE;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.12);
    transform-style: preserve-3d;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    flex: 1;
    justify-content: space-between;
  }

  .form-group,
  .form-row,
  .consent-group,
  .form-disclaimer {
    transform-origin: center center;
    transition: transform var(--duration-pushback, 1575ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
                opacity var(--duration-pushback, 1575ms) ease;
  }

  .feedback-card:has(.submit-button:hover:not(:disabled)) .form-group,
  .feedback-card:has(.submit-button:hover:not(:disabled)) .form-row,
  .feedback-card:has(.submit-button:hover:not(:disabled)) .consent-group,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .form-group,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .form-row,
  .feedback-card:has(.submit-button:focus-visible:not(:disabled)) .consent-group {
    transform: scale(0.988) translateY(-1px);
    opacity: 0.92;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-row {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
  }

  @container (min-width: 28rem) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.014em;
    color: #1D1D1D;
  }

  .required-star {
    color: var(--accent);
  }

  /* Chips */
  .service-chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
