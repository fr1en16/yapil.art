---
import ServicesAnimatedModal from './ui/services-animated-modal.tsx';

interface Props {
  theme?: 'dark' | 'light';
  personal?: boolean;
  cards?: boolean;
  currency?: 'kzt' | 'usd';
  lang?: 'ru' | 'en';
  homepage?: boolean;
}

const {
  theme = 'dark',
  personal = false,
  cards = false,
  currency = 'kzt',
  lang = 'ru',
  homepage = false,
} = Astro.props;
---

<ServicesAnimatedModal
  client:visible
  theme={theme}
  personal={personal}
  cards={cards}
  currency={currency}
  lang={lang}
  homepage={homepage}
/>
