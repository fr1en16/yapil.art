---
const services = [
  ['01', 'Дизайн лендинга', 'от $350'],
  ['02', 'Лендинг на Tilda под ключ', 'от $600'],
  ['03', 'Брендинг', 'от $700'],
  ['04', 'Логотип', 'от $300'],
  ['05', 'Дизайн-поддержка', 'от $250/месяц'],
  ['06', 'Отдельные задачи', 'от $80'],
];
---

<section class="services section" id="services" aria-labelledby="services-title">
  <div class="container">
    <span class="section-label">Что делаем</span>
    <div class="services-heading">
      <h2 class="display-title" id="services-title">Услуги</h2>
    </div>

    <ol class="service-list">
      {services.map(([number, name, price]) => (
        <li>
          <span class="service-number" aria-hidden="true">{number}</span>
          <h3>{name}</h3>
          <span class="service-price">{price}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .services-heading .display-title {
    max-width: 16ch;
    margin-bottom: 0;
  }

  .service-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink-primary);
    list-style: none;
  }

  .service-list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .service-number {
    grid-row: 1 / span 2;
    color: var(--accent-deep);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .service-price {
    grid-column: 2;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .service-list li {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 1.5rem;
    }

    .service-number {
      grid-row: auto;
    }

    .service-price {
      grid-column: auto;
      color: var(--ink-primary);
      font-family: var(--font-display);
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      font-weight: 700;
    }

    .service-list li:hover h3 {
      color: var(--accent-deep);
    }
  }
</style>
