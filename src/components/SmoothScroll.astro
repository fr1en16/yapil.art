<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  function isMobileOrReducedMotion() {
    return (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(max-width: 768px)').matches ||
      window.matchMedia('(pointer: coarse)').matches
    );
  }

  function initLenis() {
    if (isMobileOrReducedMotion()) {
      if ((window as any).__lenisInstance) {
        (window as any).__lenisInstance.destroy();
        (window as any).__lenisInstance = null;
        (window as any).lenis = null;
      }
      return;
    }

    // Prevent duplicate instances on page reloads/transitions
    if ((window as any).__lenisInstance) {
      (window as any).__lenisInstance.destroy();
    }

    const lenis = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.95,
      touchMultiplier: 1.5,
      infinite: false,
    });

    (window as any).__lenisInstance = lenis;
    (window as any).lenis = lenis;

    let rafId = 0;
    function raf(time: number) {
      lenis.raf(time);
      rafId = requestAnimationFrame(raf);
    }

    rafId = requestAnimationFrame(raf);

    // Smooth anchor navigation handling for #hash and /#hash
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('a');
      if (!target) return;

      const href = target.getAttribute('href');
      if (!href) return;

      const isCurrentPage =
        window.location.pathname === '/' || window.location.pathname === '';

      if (href.startsWith('#') && href.length > 1) {
        const el = document.querySelector(href);
        if (el) {
          e.preventDefault();
          lenis.scrollTo(el as HTMLElement, { offset: -20, duration: 1.2 });
        }
      } else if (href.startsWith('/#') && href.length > 2 && isCurrentPage) {
        const el = document.querySelector(href.slice(1));
        if (el) {
          e.preventDefault();
          lenis.scrollTo(el as HTMLElement, { offset: -20, duration: 1.2 });
        }
      }
    });

    // Pause momentum when lightbox or full-screen dialogs open
    const observer = new MutationObserver(() => {
      if (
        document.body.classList.contains('has-open-lightbox') ||
        document.body.classList.contains('overflow-hidden') ||
        document.documentElement.classList.contains('overflow-hidden')
      ) {
        lenis.stop();
      } else {
        lenis.start();
      }
    });

    observer.observe(document.body, { attributes: true, attributeFilter: ['class', 'style'] });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] });
  }

  function initParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const containers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax-media]'));
    if (!containers.length) return;

    interface ParallaxItem {
      container: HTMLElement;
      target: HTMLElement;
      currentY: number;
      targetY: number;
      isVisible: boolean;
    }

    const items: ParallaxItem[] = [];

    containers.forEach((container) => {
      const target = container.querySelector<HTMLElement>('[data-parallax-target]');
      if (target) {
        items.push({
          container,
          target,
          currentY: 0,
          targetY: 0,
          isVisible: false,
        });
      }
    });

    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const item = items.find((it) => it.container === entry.target);
          if (item) {
            item.isVisible = entry.isIntersecting;
            if (item.isVisible) {
              requestTick();
            }
          }
        });
      },
      { rootMargin: '100px 0px' }
    );

    items.forEach((it) => observer.observe(it.container));

    let isRunning = false;
    const lerpFactor = 0.085; // Organic physical inertia smoothing

    function update() {
      let isMoving = false;
      const windowHeight = window.innerHeight;

      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        if (!item.isVisible) continue;

        const rect = item.container.getBoundingClientRect();
        const cardCenter = rect.top + rect.height / 2;
        const progress = (cardCenter - windowHeight / 2) / (windowHeight / 2 + rect.height / 2);
        const clampedProgress = Math.max(-1.15, Math.min(1.15, progress));

        const maxShift = rect.height * 0.12;
        item.targetY = clampedProgress * maxShift;

        const diff = item.targetY - item.currentY;
        if (Math.abs(diff) > 0.04) {
          item.currentY += diff * lerpFactor;
          isMoving = true;
        } else {
          item.currentY = item.targetY;
        }

        item.target.style.transform = `translate3d(0, ${item.currentY.toFixed(2)}px, 0)`;
      }

      if (isMoving) {
        requestAnimationFrame(update);
      } else {
        isRunning = false;
      }
    }

    function requestTick() {
      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', requestTick, { passive: true });
    window.addEventListener('resize', requestTick, { passive: true });

    // Connect with Lenis instance
    const checkLenis = () => {
      const lenis = (window as any).lenis;
      if (lenis?.on) {
        lenis.on('scroll', requestTick);
      } else {
        setTimeout(checkLenis, 250);
      }
    };
    checkLenis();

    requestTick();
  }

  const startEffects = () => {
    initParallax();
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => initLenis(), { timeout: 1000 });
    } else {
      setTimeout(initLenis, 100);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startEffects);
  } else {
    startEffects();
  }

  window.addEventListener('resize', () => {
    initLenis();
  }, { passive: true });

  document.addEventListener('astro:page-load', startEffects);
</script>
