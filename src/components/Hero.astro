---
import { Image } from 'astro:assets';

const heroImage = 'https://media.yapil.art/me.d04a3d1afc9c1316.webp?v=2';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Дизайн-студия</p>
      <h1 id="hero-title"><span>Yapil</span>, дизайн-студия</h1>
      <p class="hero-description">
        Делаем айдентику, сайты и полиграфию. Логотип, брендбук, многостраничный сайт,
        презентация, рекламный макет: берём проект целиком и доводим до печати или до релиза.
      </p>
      <a class="hero-link" href="#cases">Смотреть кейсы <span aria-hidden="true">↘</span></a>
    </div>

    <div class="hero-visual" aria-label="Портрет дизайнера студии Yapil">
      <span class="hero-note" aria-hidden="true">дизайн<br />с характером</span>
      <Image
        src={heroImage}
        alt="Яков Пиль, дизайнер студии Yapil"
        width={1000}
        height={1200}
        widths={[400, 700, 1000]}
        sizes="(max-width: 767px) calc(100vw - 2rem), 45vw"
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - 4.5rem);
    padding-block: clamp(2rem, 6vw, 5rem);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 8rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin-bottom: clamp(2rem, 7vw, 5.5rem);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 10ch;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  h1 span {
    color: var(--accent-deep);
  }

  .hero-description {
    max-width: 42rem;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 1.2vw, 1.25rem);
    line-height: 1.55;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 2px solid var(--ink-primary);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .hero-link span {
    color: var(--accent-deep);
    font-size: 1.5rem;
  }

  .hero-visual {
    position: relative;
    max-width: 34rem;
    justify-self: center;
  }

  .hero-visual::before {
    position: absolute;
    z-index: -1;
    inset: 10% -12% -8% 18%;
    border-radius: 48% 52% 45% 55% / 52% 38% 62% 48%;
    background: var(--accent-tint);
    content: '';
    transform: rotate(-5deg);
  }

  .hero-visual :global(img) {
    width: 100%;
    height: auto;
    border-radius: 50% 50% 42% 58% / 44% 45% 55% 56%;
    object-fit: cover;
  }

  .hero-note {
    position: absolute;
    z-index: 2;
    right: -0.5rem;
    bottom: 9%;
    color: var(--accent-deep);
    font-family: var(--font-accent);
    font-size: clamp(1.7rem, 4vw, 3.5rem);
    line-height: 0.8;
    transform: rotate(-8deg);
  }

  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr);
    }

    .hero-copy {
      padding-bottom: 2rem;
    }
  }
</style>
