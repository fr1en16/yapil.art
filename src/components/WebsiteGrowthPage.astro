---
import Base from '../layouts/Base.astro';
import AdLeadForm from './ads/AdLeadForm.astro';
import Footer from './Footer.astro';
import { websiteFormatCopy, websiteTopics, websiteCities, websitePath, websiteHeading, websiteDescription, websiteFaq, type WebsiteTopic } from '../data/websiteGrowth';
import type { CityData } from '../data/citiesData';
import '../styles/website-growth.css';
import { sectionCopy, topicOffer, topicCase, formatBoundary, cityRequirements } from '../data/websiteContent';
import {websiteAdOffers} from '../data/websiteAdOffers';
interface Props { topic: WebsiteTopic; city?: CityData; }
const {topic,city}=Astro.props;
const offer=topicOffer(topic);
const proof=topicCase(topic);
const local=city?cityRequirements(topic,city):undefined;
const heading=websiteHeading(topic,city);
const description=websiteDescription(topic,city);
const faq=websiteFaq(topic,city);
const url=new URL(websitePath(topic,city),Astro.site).href;
const related=websiteTopics.filter(t=>t.slug!==topic.slug&&t.group===topic.group);
const message=`Здравствуйте! Хочу обсудить ${topic.subject}${city?` в ${city.prepositional}`:''}.`;
const jsonLd={'@context':'https://schema.org','@graph':[
  {'@type':'Service',name:heading,description,url,provider:{'@id':'https://yapil.art/#organization'},areaServed:{'@type':city?'City':'Country',name:city?.name??'Казахстан'}},
  {'@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Главная',item:'https://yapil.art'},{'@type':'ListItem',position:2,name:'Разработка сайтов',item:'https://yapil.art/websites'},{'@type':'ListItem',position:3,name:heading,item:url}]},
  {'@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))},
]};
---
<Base title={heading} {description} {jsonLd} theme="light" bodyClass="wg-page" whatsappMessage={message}>
  <article class="wg">
    <header class="wg-hero">
      <h1>{heading}</h1>
      <div class="wg-intro"><p>{topic.goal} Обсудим задачу, спроектируем решение и согласуем состав работ до начала проекта.</p><a class="wg-button" href="#contacts">Обсудить проект <span aria-hidden="true">↗</span></a></div>
      <nav class="wg-nav" aria-label="На странице"><a href="#scope">Состав проекта</a><a href="#cost">Стоимость и условия</a><a href="#questions">Вопросы</a><a href="/websites">Все направления</a></nav>
    </header>
    <section class="wg-section" id="scope"><h2>Что проработаем</h2>{websiteFormatCopy[topic.slug]&&<p>{websiteFormatCopy[topic.slug]}</p>}<div class="wg-grid">{topic.sections.map((section,i)=><article class="wg-card"><h3>{section}</h3><p>{sectionCopy[topic.slug][i]}</p></article>)}</div></section>
    <section class="wg-section wg-split"><h2>От задачи<br/>к готовому решению</h2><div><p>{formatBoundary(topic)}</p><h3>Что подготовить</h3><p>{topic.inputs}</p><h3>Как принимаем результат</h3><p>{topic.acceptance}</p><h3>Материалы и содержание</h3><p>Используем согласованные тексты, фотографии и сведения о бизнесе. Реальные проекты и отзывы публикуем с разрешения владельца; состав новых материалов фиксируем в предложении.</p></div></section>
    {city&&<section class="wg-section wg-split"><h2>Проект для бизнеса<br/>в {city.prepositional}</h2><div><p>{city.workFormat}</p><h3>{local?.title}</h3><p>{local?.context}</p><ul>{local?.questions.map(question=><li>{question}</li>)}</ul><p>{local?.check}</p><p>{local?.scenario}</p><a href={`/services/websites/${city.slug}`}>Разработка сайтов в {city.prepositional} →</a></div></section>}
    <section class="wg-section wg-split" id="cost"><h2>Стоимость<br/>и условия заказа</h2><div><p>Чтобы заказать {topic.subject}{city?` в ${city.prepositional}`:''}, начните с короткого описания задачи. Оценка зависит от количества экранов и материалов, сложности дизайна, функций и интеграций.</p><div class="wg-offer">{offer&&<><h3>Ориентир: {offer.name}</h3><p><strong>Tilda — от {offer.tildaPrice.toLocaleString('ru-RU')} ₸</strong>{!topic.slug.startsWith('tilda')&&<><br/><strong>Код + CMS — от {offer.codePrice.toLocaleString('ru-RU')} ₸</strong></>}</p><p>{offer.scope}. Срок: {offer.term}.</p><p>В базовый формат входят: {offer.included.join('; ')}.</p><p>Отдельно оцениваются: {offer.extras.join('; ')}.</p><p>Это ориентир базового формата, а не цена всех функций, перечисленных для вашей задачи. Итоговую комплектацию, стоимость и срок согласуем после брифа.</p></>}</div><ol><li>Уточняем задачу и исходные данные.</li><li>Согласуем состав работ, стоимость и этапы.</li><li>Проверяем результат по согласованным сценариям.</li><li>Передаём доступы и инструкции по работе с результатом.</li></ol><p>Домен, хостинг, тариф Tilda и другие платные сервисы — отдельные статьи расходов, если они нужны проекту. Условия оплаты и дополнительных правок фиксируем до старта.</p>{topic.slug==='pricing'?<><h3>Базовые форматы</h3><table class="wg-price-table"><thead><tr><th>Формат</th><th>Tilda</th><th>Код + CMS</th></tr></thead><tbody>{Object.values(websiteAdOffers).map(offer=><tr><td>{offer.name}</td><td>от {offer.tildaPrice.toLocaleString('ru-RU')} ₸</td><td>от {offer.codePrice.toLocaleString('ru-RU')} ₸</td></tr>)}</tbody></table><p>Это стартовые цены базовых форматов. Итоговый расчёт зависит от комплектации; интеграции и дополнительные материалы обсуждаются отдельно.</p></>:<a href={websitePath(websiteTopics.find(t=>t.slug==='pricing')!,city)}>Расчёт стоимости сайта →</a>}</div></section>
    <section class="wg-section" id="questions"><h2>Вопросы перед стартом</h2><div class="wg-faq">{faq.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
    <section class="wg-section"><h2>Обсудим ваш проект</h2>{proof&&<article class="wg-card wg-proof"><h3>{proof.title} — {proof.type}</h3><p>Пример выполненной работы по формату сайта; он не означает опыт в вашей нише или городе.</p><p><strong>Задача.</strong> {proof.task}</p><p><strong>Что сделали.</strong> {proof.work}</p><p><strong>Результат.</strong> {proof.result}</p></article>}<p>Посмотрите <a href="/cases">портфолио Yapil</a> и расскажите, какой результат нужен вашему бизнесу. Подберём формат и согласуем техническую реализацию.</p></section>
    <section class="wg-section"><h2>Города и направления</h2><nav class="wg-links" aria-label="География услуги"><a href={websitePath(topic)}>{topic.name} — Казахстан</a>{websiteCities.filter(c=>c.slug!==city?.slug).map(c=><a href={websitePath(topic,c)}>{c.name}</a>)}</nav><details class="wg-related"><summary>Другие направления: {topic.group.toLowerCase()}</summary><nav class="wg-links" aria-label="Связанные услуги">{related.map(t=><a href={websitePath(t,city)}>{t.name}</a>)}</nav></details><a href="/websites">Открыть весь каталог →</a></section>
  </article>
  <section class="wg wg-contact" id="contacts"><div class="wg-section wg-split"><div><h2>Расскажите<br/>о вашем проекте</h2><p>Пришлите задачу, пожелания и материалы. Обсудим состав работ, сроки и стоимость.</p></div><AdLeadForm city={city?.slug??'kazakhstan'} offer={{slug:topic.slug,name:topic.name}} websiteContext={`Направление: ${topic.name}; город: ${city?.name??'Казахстан'}; страница: ${url}`} /></div></section>
  <Footer slot="footer" theme="dark" />
</Base>
