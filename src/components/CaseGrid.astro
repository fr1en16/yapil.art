---
import { getCases } from '../lib/sanity';
import CaseCard from './CaseCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import { serviceTags } from '../data/service-tags';

interface Props {
  pageHeading?: boolean;
  lang?: 'ru' | 'en';
}

const { pageHeading = false, lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const cases = await getCases();
const preferredTagOrder: string[] = [...serviceTags];
const allTags = Array.from(new Set(cases.flatMap((item) => item.tags)));
const tags = [
  ...preferredTagOrder.filter((tag) => allTags.includes(tag)),
  ...allTags.filter((tag) => !preferredTagOrder.includes(tag)).sort((a, b) => a.localeCompare(b, 'ru')),
];
const sectors = Array.from(new Set(cases.map((item) => item.sector).filter((sector): sector is string => Boolean(sector))))
  .sort((a, b) => a.localeCompare(b, 'ru'));

// 3 чётких размера карточек (sm: span 4, md: span 6, lg: span 7-8)
// в 10-позиционном асимметричном ритме швейцарской верстки
const layoutPattern = [
  'project--size-lg project--pos-0', // Large:  col 1 / span 7
  'project--size-sm project--pos-1', // Small:  col 9 / span 4 (смещение вниз)
  'project--size-md project--pos-2', // Medium: col 4 / span 6 (центрированный)
  'project--size-sm project--pos-3', // Small:  col 1 / span 4
  'project--size-lg project--pos-4', // Large:  col 6 / span 7 (смещение вниз)
  'project--size-md project--pos-5', // Medium: col 2 / span 6
  'project--size-sm project--pos-6', // Small:  col 9 / span 4 (смещение вниз)
  'project--size-lg project--pos-7', // Large:  col 3 / span 8 (панорамный)
  'project--size-sm project--pos-8', // Small:  col 2 / span 4
  'project--size-md project--pos-9', // Medium: col 7 / span 6 (смещение вниз)
];
---

<section class="cases" id="cases" aria-labelledby="cases-title" data-project-filter-scope>
  <div class="container">
    <div class="cases__header">
      {pageHeading
        ? <h1 class="display-title" id="cases-title">{isEn ? 'Cases' : 'Кейсы'}</h1>
        : <h2 class="display-title" id="cases-title">{isEn ? 'Cases' : 'Кейсы'}</h2>}
      <p>
        {pageHeading ? (
          isEn ? (
            <>Detailed case studies and project breakdowns. All work is in the <a href="/portfolio">portfolio</a>.</>
          ) : (
            <>Подробные разборы проектов. Все работы, включая отдельные макеты, — в <a href="/portfolio">портфолио</a>.</>
          )
        ) : (
          isEn ? 'Every project was built from scratch.' : 'Каждый проект начинали с нуля.'
        )}
      </p>
    </div>

    {pageHeading && <ProjectFilters items={cases} tags={tags} sectors={sectors} class="case-filters" />}

    <div class="case-grid">
      {cases.map((item, index) => (
        <CaseCard
          slug={item.slug}
          title={item.title}
          year={item.year}
          summary={item.summary}
          tags={item.tags}
          sector={item.sector}
          cover={item.cover || item.socialImage || ''}
          index={index}
          positionClass={layoutPattern[index % layoutPattern.length]}
          lang={lang}
        />
      ))}
    </div>

    {pageHeading && (
      <p class="case-empty" data-project-empty hidden>
        {isEn ? 'No cases found for these filters.' : 'По этим фильтрам кейсов пока нет.'}
      </p>
    )}
  </div>
</section>

{pageHeading && (
  <script>
    function initCaseFilters() {
      const scope = document.querySelector<HTMLElement>('.cases[data-project-filter-scope]');
      const filters = scope?.querySelector<HTMLElement>('[data-project-filters]');
      if (!scope || !filters || filters.dataset.ready === 'true') return;
      filters.dataset.ready = 'true';
      const cards = Array.from(scope.querySelectorAll<HTMLElement>('[data-project-card]'));
      const empty = scope.querySelector<HTMLElement>('[data-project-empty]');
      const active = { tag: 'all', sector: 'all' };

      const update = () => {
        let visible = 0;
        cards.forEach((card) => {
          const tagMatches = active.tag === 'all' || (card.dataset.tags ?? '').split('|').includes(active.tag);
          const sectorMatches = active.sector === 'all' || card.dataset.sector === active.sector;
          card.hidden = !(tagMatches && sectorMatches);
          if (!card.hidden) visible += 1;
        });
        if (empty) empty.hidden = visible > 0;
      };

      filters.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-filter-kind]');
        if (!button || !filters.contains(button)) return;
        const kind = button.dataset.filterKind as 'tag' | 'sector';
        active[kind] = button.dataset.filterValue ?? 'all';
        filters.querySelectorAll<HTMLButtonElement>(`[data-filter-kind="${kind}"]`).forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        update();
        const params = new URLSearchParams(location.search);
        for (const [key, value] of Object.entries(active)) value === 'all' ? params.delete(key) : params.set(key, value);
        history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
      });

      const params = new URLSearchParams(location.search);
      (['tag', 'sector'] as const).forEach((kind) => {
        const value = params.get(kind);
        if (value) filters.querySelector<HTMLButtonElement>(`[data-filter-kind="${kind}"][data-filter-value="${CSS.escape(value)}"]`)?.click();
      });
      update();
    }

    initCaseFilters();
    document.addEventListener('astro:page-load', initCaseFilters);
  </script>
)}

<style>
  .cases {
    padding-top: clamp(6.5rem, 11vw, 9.5rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    color: #f2f2f2;
    background: #0b0b0c;
  }

  .cases__header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .8fr);
    gap: 2rem clamp(2rem, 7vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cases__header h1,
  .cases__header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    color: #fff;
  }

  .cases__header p {
    max-width: 42rem;
    margin: 0;
    color: rgba(242, 242, 242, .7);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.45;
  }

  .cases__header p a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .cases__header p a:hover {
    color: var(--accent, #FD4B32);
  }

  :global(.case-filters) {
    --filters-ink: #fff;
    --filters-muted: rgba(255, 255, 255, .68);
    --filters-active: #bff3ff;
    --filters-rule: rgba(255, 255, 255, .3);
    margin: 0 0 clamp(3rem, 6vw, 5rem);
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(4rem, 9vw, 7.5rem) var(--grid-gap, clamp(0.75rem, 1vw, 1.25rem));
    grid-auto-flow: row dense;
  }

  .case-grid :global(.project[hidden]) {
    display: none !important;
  }

  /* 3 размера карточек по типографической шкале */
  .case-grid :global(.project--size-sm) {
    --card-title-size: clamp(1.35rem, 1.6vw, 1.75rem);
  }

  .case-grid :global(.project--size-md) {
    --card-title-size: clamp(1.6rem, 2.1vw, 2.25rem);
  }

  .case-grid :global(.project--size-lg) {
    --card-title-size: clamp(1.9rem, 2.7vw, 2.85rem);
  }

  /* 10-позиционный ритм швейцарской асимметрии */
  /* Position 0: Large (span 7, слева) */
  .case-grid :global(.project--pos-0) {
    grid-column: 1 / span 7;
  }

  /* Position 1: Small (span 4, справа со смещением вниз) */
  .case-grid :global(.project--pos-1) {
    grid-column: 9 / span 4;
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  /* Position 2: Medium (span 6, центрированный) */
  .case-grid :global(.project--pos-2) {
    grid-column: 4 / span 6;
  }

  /* Position 3: Small (span 4, слева) */
  .case-grid :global(.project--pos-3) {
    grid-column: 1 / span 4;
  }

  /* Position 4: Large (span 7, справа со смещением вниз) */
  .case-grid :global(.project--pos-4) {
    grid-column: 6 / span 7;
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  /* Position 5: Medium (span 6, со смещением от левого края) */
  .case-grid :global(.project--pos-5) {
    grid-column: 2 / span 6;
  }

  /* Position 6: Small (span 4, справа со смещением вниз) */
  .case-grid :global(.project--pos-6) {
    grid-column: 9 / span 4;
    margin-top: clamp(2.5rem, 5vw, 5rem);
  }

  /* Position 7: Large (span 8, панорамный центрированный) */
  .case-grid :global(.project--pos-7) {
    grid-column: 3 / span 8;
  }

  /* Position 8: Small (span 4, со смещением от левого края) */
  .case-grid :global(.project--pos-8) {
    grid-column: 2 / span 4;
  }

  /* Position 9: Medium (span 6, справа со смещением вниз) */
  .case-grid :global(.project--pos-9) {
    grid-column: 7 / span 6;
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  /* Peer Hover Focus: размытие соседей при наведении */
  .case-grid:has(:global(.project:hover)) :global(.project:not(:hover)) {
    filter: blur(4px);
    opacity: 0.35;
    transform: scale(0.985);
  }

  .case-empty {
    padding: 6rem 0;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
    font-size: 1.15rem;
  }

  @media (max-width: 63.99rem) {
    .cases__header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .case-grid {
      gap-block: clamp(3.5rem, 8vw, 5.5rem);
    }

    .case-grid :global(.project),
    .case-grid :global(.project:nth-child(n)) {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
      margin-top: 0 !important;
    }

    /* 3 градации размера на планшете */
    .case-grid :global(.project--size-lg) {
      width: 70%;
    }

    .case-grid :global(.project--size-md) {
      width: 60%;
    }

    .case-grid :global(.project--size-sm) {
      width: 50%;
    }

    /* Сохранение швейцарского ритма смещений на планшете */
    .case-grid :global(.project--pos-0),
    .case-grid :global(.project--pos-3),
    .case-grid :global(.project--pos-5),
    .case-grid :global(.project--pos-8) {
      margin-left: 6%;
    }

    .case-grid :global(.project--pos-2),
    .case-grid :global(.project--pos-7) {
      justify-self: center;
    }

    .case-grid :global(.project--pos-1),
    .case-grid :global(.project--pos-4),
    .case-grid :global(.project--pos-6),
    .case-grid :global(.project--pos-9) {
      justify-self: end;
      margin-right: 6%;
    }
  }

  @media (max-width: 47.99rem) {
    .cases {
      padding-top: 5rem;
      padding-bottom: 4rem;
    }

    .cases__header {
      margin-bottom: 2rem;
    }

    .cases__header h1,
    .cases__header h2 {
      font-size: clamp(2.4rem, 12vw, 3.8rem);
    }

    .case-grid {
      display: flex;
      flex-direction: column;
      gap: 3.5rem;
    }

    /* 3 градации размера на смартфонах */
    .case-grid :global(.project--size-lg) {
      width: 100% !important;
      max-width: 100% !important;
    }

    .case-grid :global(.project--size-md) {
      width: 100% !important;
      max-width: 90% !important;
    }

    .case-grid :global(.project--size-sm) {
      width: 100% !important;
      max-width: 82% !important;
    }

    /* Зигзагообразное смещение */
    .case-grid :global(.project--pos-0),
    .case-grid :global(.project--pos-3),
    .case-grid :global(.project--pos-5),
    .case-grid :global(.project--pos-8) {
      align-self: flex-start !important;
      margin-inline: 0 auto !important;
    }

    .case-grid :global(.project--pos-1),
    .case-grid :global(.project--pos-4),
    .case-grid :global(.project--pos-6),
    .case-grid :global(.project--pos-9) {
      align-self: flex-end !important;
      margin-inline: auto 0 !important;
    }

    .case-grid :global(.project--pos-2),
    .case-grid :global(.project--pos-7) {
      align-self: center !important;
      margin-inline: auto !important;
    }

    .case-grid:has(:global(.project:hover)) :global(.project:not(:hover)) {
      filter: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
