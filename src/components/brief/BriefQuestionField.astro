---
import type { BriefQuestion } from '../../data/briefsData';

interface Props { question: BriefQuestion; idPrefix: string; }
const { question, idPrefix } = Astro.props;
const fieldId = `${idPrefix}-${question.name}`;
---

<div
  class="question"
  data-question={question.name}
  data-branch-field={question.showWhen?.field}
  data-branch-values={question.showWhen?.values.join('|')}
  hidden={Boolean(question.showWhen)}
>
  <label class="question-label" for={fieldId}>
    {question.label}{question.required && <span aria-hidden="true"> *</span>}
  </label>
  {question.hint && <p class="question-hint">{question.hint}</p>}

  {question.type === 'textarea' && <textarea id={fieldId} name={question.name} rows="4" placeholder={question.placeholder} required={question.required}></textarea>}
  {(question.type === 'text' || question.type === 'url' || question.type === 'number') && <input id={fieldId} name={question.name} type={question.type} placeholder={question.placeholder} required={question.required} />}
  {question.type === 'select' && (
    <select id={fieldId} name={question.name} required={question.required}>
      <option value="">Выберите вариант</option>
      {question.options?.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  )}
  {(question.type === 'radio' || question.type === 'checkbox') && (
    <div class="option-grid" role={question.type === 'radio' ? 'radiogroup' : 'group'} data-required-group={question.required ? question.name : undefined}>
      {question.options?.map((option, optionIndex) => (
        <label class="option-card">
          <input type={question.type} name={question.name} value={option.value} required={question.type === 'radio' && question.required && optionIndex === 0} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  )}
  <p class="question-error" data-question-error aria-live="polite"></p>
</div>

<style>
  .question { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); padding: 2rem 0; border-bottom: 1px solid rgba(23, 23, 23, .18); }
  .question[hidden] { display: none; }
  .question-label { grid-column: 1 / 5; padding-right: 2rem; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.25; }
  .question-label span { color: #fd4b32; }
  .question-hint { grid-column: 1 / 5; margin: .5rem 0 0; color: #6d6963; font-size: .8rem; }
  .question > input,.question > textarea,.question > select,.option-grid { grid-column: 5 / 13; }
  .question > input,.question > textarea,.question > select { width: 100%; padding: 0 0 .8rem; border: 0; border-bottom: 1px solid rgba(23, 23, 23, .35); border-radius: 0; color: inherit; background: transparent; font: inherit; font-size: clamp(1rem, 1.4vw, 1.2rem); }
  .question > textarea { resize: vertical; line-height: 1.4; }
  .question > input:focus,.question > textarea:focus,.question > select:focus { border-bottom-color: #fd4b32; outline: 0; }
  .option-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .option-card { position: relative; display: block; cursor: pointer; }
  .option-card input { position: absolute; opacity: 0; pointer-events: none; }
  .option-card span { display: block; min-height: 3.75rem; padding: 1rem 1.1rem; border: 1px solid rgba(23, 23, 23, .18); line-height: 1.25; }
  .option-card input:checked + span { color: #fff; border-color: #fd4b32; background: #fd4b32; }
  .option-card input:focus-visible + span { outline: 2px solid #fd4b32; outline-offset: 3px; }
  .question-error { grid-column: 5 / 13; min-height: 1em; margin: .6rem 0 0; color: #b3261e; font-size: .8rem; }
  @media (max-width: 40rem) {
    .question { display: block; }
    .question-label { display: block; margin-bottom: 1.25rem; padding: 0; }
    .option-grid { grid-template-columns: 1fr; }
    .question-error { min-height: 0; }
  }
</style>
