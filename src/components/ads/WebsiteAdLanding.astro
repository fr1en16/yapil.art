---
import Base from '../../layouts/Base.astro';
import Footer from '../Footer.astro';
import Hero from '../Hero.astro';
import AboutCompact from '../AboutCompact.astro';
import ReviewsSlider from '../ReviewsSlider.astro';
import AdLeadForm from './AdLeadForm.astro';
import { formatKzt, type WebsiteAdOffer } from '../../data/websiteAdOffers';
import { getSiteSettings } from '../../lib/sanity';
import { getWhatsAppUrl } from '../../utils/messengerLinks';
import '../../styles/ad-website-pages.css';

interface Props {
  offer: WebsiteAdOffer;
}

const { offer } = Astro.props;
const settings = await getSiteSettings();
const whatsappMessage = `Здравствуйте! Нужен ${offer.name.toLocaleLowerCase('ru')}. Подскажите, пожалуйста, стоимость и сроки.`;
const whatsappHref = getWhatsAppUrl({
  message: whatsappMessage,
  pageUrl: Astro.url.href,
  sourceContext: 'ad_hero',
  phone: settings?.whatsappPhone,
});
const tildaWhatsappHref = getWhatsAppUrl({
  message: `Здравствуйте! Нужен ${offer.name.toLocaleLowerCase('ru')} на Tilda. Подскажите, пожалуйста, стоимость и сроки.`,
  pageUrl: Astro.url.href,
  sourceContext: 'ad_platform_tilda',
  phone: settings?.whatsappPhone,
});
const codeWhatsappHref = getWhatsAppUrl({
  message: `Здравствуйте! Нужен ${offer.name.toLocaleLowerCase('ru')} на чистом коде с CMS. Подскажите, пожалуйста, стоимость и сроки.`,
  pageUrl: Astro.url.href,
  sourceContext: 'ad_platform_code',
  phone: settings?.whatsappPhone,
});
const recommendationWhatsappHref = getWhatsAppUrl({
  message: `Здравствуйте! Нужен ${offer.name.toLocaleLowerCase('ru')}. Помогите, пожалуйста, выбрать подходящую платформу и рассчитать стоимость.`,
  pageUrl: Astro.url.href,
  sourceContext: 'ad_platform_recommendation',
  phone: settings?.whatsappPhone,
});
const whatsappIconPath = 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48a9 9 0 0 1-1.66-2.07c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.51-.23-.36A9.44 9.44 0 0 1 2.5 12C2.5 6.76 6.78 2.5 12.04 2.5a9.45 9.45 0 0 1 6.74 2.79A9.43 9.43 0 0 1 21.56 12c0 5.24-4.28 9.5-9.52 9.5m8.1-17.57A11.38 11.38 0 0 0 12.05.58C5.75.58.63 5.7.63 12c0 2.01.52 3.98 1.52 5.72L.53 23.63l6.05-1.59a11.43 11.43 0 0 0 5.46 1.39h.01c6.3 0 11.42-5.12 11.42-11.42 0-3.05-1.18-5.92-3.34-8.08';

const conditions = [
  { title: 'Оплата', text: '50% перед стартом, 50% после приёмки и до публикации или передачи исходников.' },
  { title: 'Правки', text: 'Два комплексных раунда на каждом согласуемом этапе. Новый функционал оцениваем отдельно до начала работ.' },
  { title: 'Доступы и права', text: 'Передаём домен, хостинг, аналитику, CMS и исходники по договору после полной оплаты.' },
  { title: 'Управление', text: 'На чистом коде подключаем CMS с понятными полями. Для Tilda показываем, как работать с доступными разделами.' },
  { title: 'После запуска', text: '30 календарных дней поддержки: наблюдение, исправление технических ошибок и консультации входят в стоимость.' },
  { title: 'Регулярные расходы', text: 'Tilda — 36 000–72 000 ₸ в год; хостинг в зоне .KZ — ориентировочно 5 000–50 000 ₸ в год; домен — от 5 000 ₸.' },
];

const process = [
  { title: 'Бриф и оценка', text: 'Фиксируем задачу, платформу, состав, стоимость и календарь проекта.' },
  { title: 'Структура и прототип', text: 'Собираем логику страниц и путь посетителя до обращения.' },
  { title: 'Дизайн', text: 'Создаём ключевые экраны и адаптивную визуальную систему.' },
  { title: 'Разработка', text: 'Собираем сайт, подключаем формы, CMS, аналитику и интеграции.' },
  { title: 'Проверка и запуск', text: 'Тестируем мобильные устройства, публикуем сайт и передаём доступы.' },
];

const pagePresentation = {
  landing: {
    heroTitle: 'Лендинги,<br />которые приводят<br />заявки с запуска',
    term: 'Срок: от 3 дней до 2 недель, в зависимости от объёма',
    dialogTitle: 'Рассчитаем стоимость лендинга',
    dialogTerm: 'От 3 дней до 2 недель',
    cards: [
      { title: 'Оффер<br />и структура', text: 'Собираем предложение под рекламный запрос и выстраиваем путь от первого экрана до заявки.', icon: 'shapes' },
      { title: 'Дизайн<br />без шаблонов', text: 'Создаём визуальную систему под бренд и адаптируем каждый экран для смартфонов и компьютеров.', icon: 'award' },
      { title: 'Форма<br />и аналитика', text: 'Подключаем рабочую форму, цели и рекламные метки, чтобы считать реальные обращения, а не клики.', icon: 'refresh-cw' },
      { title: 'Запуск<br />под ключ', text: 'Проверяем страницу, подключаем домен и остаёмся на связи в течение 30 дней после запуска.', icon: 'briefcase' },
    ],
  },
  'corporate-site': {
    heroTitle: 'Корпоративные сайты,<br />которые понятно<br />представляют бизнес',
    term: 'Срок: от 14 до 21 рабочего дня для сайта до 5 страниц',
    dialogTitle: 'Рассчитаем стоимость корпоративного сайта',
    dialogTerm: 'От 14 до 21 рабочего дня',
    cards: [
      { title: 'Структура<br />компании', text: 'Раскладываем услуги, направления и преимущества так, чтобы клиент быстро понял ценность предложения.', icon: 'shapes' },
      { title: 'Дизайн<br />под бренд', text: 'Создаём цельную визуальную систему и адаптируем страницы для смартфонов, планшетов и компьютеров.', icon: 'award' },
      { title: 'CMS<br />и аналитика', text: 'Подключаем понятное управление контентом, рабочие формы и цели для учёта реальных обращений.', icon: 'refresh-cw' },
      { title: 'Передача<br />под ключ', text: 'Тестируем сайт, подключаем домен, передаём доступы и поддерживаем проект после запуска.', icon: 'briefcase' },
    ],
  },
  'online-store': {
    heroTitle: 'Интернет-магазины,<br />в которых удобно<br />покупать',
    term: 'Срок: от 7 до 21 рабочего дня для магазина до 50 товаров',
    dialogTitle: 'Рассчитаем стоимость интернет-магазина',
    dialogTerm: 'От 7 до 21 рабочего дня',
    cards: [
      { title: 'Каталог<br />и карточки', text: 'Проектируем понятную структуру ассортимента, фильтры и карточки, которые помогают выбрать товар.', icon: 'shapes' },
      { title: 'Корзина<br />и заказ', text: 'Собираем короткий и понятный путь от выбора товара до оформления заказа на любом устройстве.', icon: 'award' },
      { title: 'Управление<br />товарами', text: 'Настраиваем удобное добавление товаров, цен, остатков и характеристик без правок в коде.', icon: 'refresh-cw' },
      { title: 'Запуск<br />и аналитика', text: 'Подключаем формы, цели и домен, тестируем заказы и остаёмся на связи после публикации.', icon: 'briefcase' },
    ],
  },
} satisfies Record<WebsiteAdOffer['slug'], {
  heroTitle: string;
  term: string;
  dialogTitle: string;
  dialogTerm: string;
  cards: Array<{ title: string; text: string; icon: string }>;
}>;

const presentation = pagePresentation[offer.slug];
const priceStatement = `Разработка под ключ от ${formatKzt(offer.tildaPrice)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: offer.title,
      description: offer.description,
      provider: { '@type': 'ProfessionalService', name: 'Yapil', url: 'https://yapil.art' },
      areaServed: ['KZ', 'Worldwide'],
      offers: [
        { '@type': 'Offer', name: `${offer.name} на Tilda`, priceCurrency: 'KZT', price: offer.tildaPrice },
        { '@type': 'Offer', name: `${offer.name} на чистом коде с CMS`, priceCurrency: 'KZT', price: offer.codePrice },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: offer.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<Base
  title={offer.title}
  description={offer.description}
  {jsonLd}
  theme="light"
  navOverlay
  hideNav
  noindex
  bodyClass="website-service-page ad-website-page website-service-page--websites ad-website-page--reference"
  {whatsappMessage}
>
  <article
    data-ad-page
    data-offer={offer.slug}
    data-whatsapp-default={whatsappHref}
    data-whatsapp-tilda={tildaWhatsappHref}
    data-whatsapp-code={codeWhatsappHref}
    data-whatsapp-recommendation={recommendationWhatsappHref}
  >
    <Hero
      title={presentation.heroTitle}
      description={`${priceStatement} ${presentation.term}`}
      descriptionItems={[
        { icon: 'price', text: priceStatement },
        { icon: 'time', text: presentation.term },
      ]}
      casesHref="#estimate"
      ctaText="Получить расчёт стоимости"
      secondaryHref={whatsappHref}
      secondaryText="Написать в WhatsApp"
      secondaryExternal
      ripple
    />
    <AboutCompact theme="light" websites cards={presentation.cards} />

    <div class="ad-paper">
      <section class="ad-section container" id="cases" aria-labelledby="cases-title">
        <header class="ad-heading">
          <h2 id="cases-title">Задача, работа и результат</h2>
        </header>

        <div class="ad-cases">
          {offer.cases.map((item, index) => (
            <article class="ad-case">
              <div class="ad-case__media">
                <img src={item.image} alt={`Проект ${item.title}`} width="1200" height="720" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class="ad-case__content">
                <div class="ad-case__title-row"><h3>{item.title}</h3></div>
                <p class="ad-case__type">{item.type}</p>
                <dl>
                  <div><dt>Задача</dt><dd>{item.task}</dd></div>
                  <div><dt>Что сделали</dt><dd>{item.work}</dd></div>
                  <div><dt>Результат</dt><dd>{item.result}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>

        <div class="ad-inline-cta"><a class="ad-text-link" href="#estimate" data-estimate-cta data-cta-id="cases">Получить расчёт стоимости <span aria-hidden="true">→</span></a></div>
      </section>

      <section class="ad-section container" id="price" aria-labelledby="price-title">
        <header class="ad-heading">
          <h2 id="price-title">Стоимость, комплектация и платформа</h2>
        </header>

        <div class="ad-platforms" role="radiogroup" aria-labelledby="price-title">
          <article class="ad-platform-card ad-platform-card--tilda">
            <label class="ad-platform-card__choice">
              <input type="radio" name="page-platform" value="tilda" data-platform-choice data-price={offer.tildaPrice} />
              <span class="ad-platform-card__control" aria-hidden="true"></span>
              <span class="ad-platform-card__title">Tilda</span>
              <strong>от {formatKzt(offer.tildaPrice)}</strong>
              <span class="ad-platform-card__summary">Для быстрого запуска и минимального бюджета.</span>
              <span class="ad-platform-card__label">Входит</span>
              <ul class="ad-platform-card__included">{offer.included.map((item) => <li>{item}</li>)}</ul>
              <span class="ad-platform-card__label">Плюсы</span>
              <span class="ad-platform-card__text">Быстрее, базовая цена ниже, простой магазин можно вести через штатный каталог.</span>
              <span class="ad-platform-card__label">Минусы</span>
              <span class="ad-platform-card__text">Сложными Zero Block-страницами неудобно управлять; есть ограничения и зависимость от тарифа.</span>
            </label>
            <div class="ad-platform-card__actions">
              <button class="ad-button ad-button--primary" type="button" data-platform-estimate="tilda">Рассчитать стоимость <span aria-hidden="true">→</span></button>
              <a class="ad-platform-whatsapp" href={tildaWhatsappHref} target="_blank" rel="noopener noreferrer" data-whatsapp-link data-platform-context="tilda" data-cta-id="platform-tilda" aria-label={`Написать в WhatsApp: ${offer.name} на Tilda`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={whatsappIconPath} /></svg>
              </a>
            </div>
          </article>

          <article class="ad-platform-card ad-platform-card--code">
            <label class="ad-platform-card__choice">
              <input type="radio" name="page-platform" value="code" data-platform-choice data-price={offer.codePrice} />
              <span class="ad-platform-card__control" aria-hidden="true"></span>
              <span class="ad-platform-card__title">Чистый код + CMS</span>
              <strong>от {formatKzt(offer.codePrice)}</strong>
              <span class="ad-platform-card__summary">Для удобного управления и развития проекта.</span>
              <span class="ad-platform-card__label">Входит</span>
              <ul class="ad-platform-card__included">{offer.included.map((item) => <li>{item}</li>)}</ul>
              <span class="ad-platform-card__label">Плюсы</span>
              <span class="ad-platform-card__text">Понятные поля CMS, больше свободы в дизайне, SEO, скорости и интеграциях.</span>
              <span class="ad-platform-card__label">Минусы</span>
              <span class="ad-platform-card__text">Для изменения функционала нужен разработчик.</span>
            </label>
            <div class="ad-platform-card__actions">
              <button class="ad-button ad-button--primary" type="button" data-platform-estimate="code">Рассчитать стоимость <span aria-hidden="true">→</span></button>
              <a class="ad-platform-whatsapp" href={codeWhatsappHref} target="_blank" rel="noopener noreferrer" data-whatsapp-link data-platform-context="code" data-cta-id="platform-code" aria-label={`Написать в WhatsApp: ${offer.name} на чистом коде`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={whatsappIconPath} /></svg>
              </a>
            </div>
          </article>

          <article class="ad-platform-card ad-platform-card--compact">
            <label class="ad-platform-card__choice">
              <input type="radio" name="page-platform" value="recommendation" data-platform-choice />
              <span class="ad-platform-card__control" aria-hidden="true"></span>
              <span class="ad-platform-card__title">Нужна рекомендация</span>
              <span class="ad-platform-card__text">Уточним задачу и предложим вариант без переплаты за ненужные возможности.</span>
            </label>
            <div class="ad-platform-card__actions">
              <button class="ad-button ad-button--primary" type="button" data-platform-estimate="recommendation">Получить рекомендацию <span aria-hidden="true">→</span></button>
              <a class="ad-platform-whatsapp" href={recommendationWhatsappHref} target="_blank" rel="noopener noreferrer" data-whatsapp-link data-platform-context="recommendation" data-cta-id="platform-recommendation" aria-label="Написать в WhatsApp для выбора платформы">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={whatsappIconPath} /></svg>
              </a>
            </div>
          </article>
        </div>

        <div class="ad-extras">
          <h3>Оплачивается отдельно</h3>
          <ul>{offer.extras.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class="ad-section container" id="conditions" aria-labelledby="conditions-title">
        <header class="ad-heading">
          <h2 id="conditions-title">Условия работы</h2>
        </header>
        <div class="ad-condition-grid">
          {conditions.map((item) => (
            <article><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </section>

      <section class="ad-section container" id="process" aria-labelledby="process-title">
        <header class="ad-heading">
          <h2 id="process-title">Как проходит работа</h2>
        </header>
        <ol class="ad-process">
          {process.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ol>
      </section>
    </div>

    <section class="ad-reviews-shell">
      <div class="container ad-reviews-heading"><h2>Отзывы о разработке сайтов</h2></div>
      <ReviewsSlider theme="light" />
    </section>

    <div class="ad-paper">
      <section class="ad-section container" id="faq" aria-labelledby="faq-title">
        <header class="ad-heading"><h2 id="faq-title">Ответы на вопросы</h2></header>
        <div class="ad-faq">
          {offer.faq.map((item, index) => (
            <details open={index === 0}><summary><span>{item.question}</span><span aria-hidden="true">+</span></summary><div class="ad-faq__answer"><div><p>{item.answer}</p></div></div></details>
          ))}
        </div>
      </section>

      <section class="ad-section ad-estimate container" id="estimate" aria-labelledby="estimate-title">
        <header class="ad-heading"><h2 id="estimate-title">Получите расчёт стоимости</h2></header>
        <div class="ad-estimate__grid">
          <div class="ad-estimate__copy">
            <p>Свяжемся в течение 10 минут, уточним задачу и подготовим стоимость и сроки.</p>
            <dl>
              <div><dt>Услуга</dt><dd>{offer.name}</dd></div>
              <div><dt>Стоимость</dt><dd data-current-price>Tilda — от {formatKzt(offer.tildaPrice)} · Код + CMS — от {formatKzt(offer.codePrice)}</dd></div>
              <div><dt>Срок</dt><dd>{offer.term}</dd></div>
            </dl>
            <a class="ad-text-link" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-whatsapp-link data-contextual-whatsapp data-cta-id="form">Написать в WhatsApp <span aria-hidden="true">↗</span></a>
          </div>
          <AdLeadForm {offer} instance="estimate" />
        </div>
      </section>
    </div>

    <dialog class="ad-lead-dialog" data-lead-dialog aria-labelledby="ad-lead-dialog-title">
      <button class="ad-lead-dialog__close" type="button" data-close-lead-dialog aria-label="Закрыть форму">×</button>
      <div class="container ad-lead-dialog__inner">
        <div class="ad-lead-dialog__copy">
          <h2 id="ad-lead-dialog-title">{presentation.dialogTitle}</h2>
          <p>Оставьте номер телефона. Свяжемся в течение 10 минут, уточним задачу и подготовим стоимость и сроки.</p>
          <dl>
            <div><dt>Стоимость</dt><dd data-current-price>Tilda — от {formatKzt(offer.tildaPrice)} · Код + CMS — от {formatKzt(offer.codePrice)}</dd></div>
            <div><dt>Срок</dt><dd>{presentation.dialogTerm}</dd></div>
          </dl>
        </div>
        <AdLeadForm {offer} instance="dialog" />
      </div>
    </dialog>
  </article>
  <Footer slot="footer" theme="dark" />
</Base>

<script>
  const initAdPage = () => {
    const page = document.querySelector<HTMLElement>('[data-ad-page]');
    if (!page || page.dataset.ready === 'true') return;
    page.dataset.ready = 'true';

    const track = (name: string, params: Record<string, unknown> = {}) => {
      const analyticsWindow = window as typeof window & { gtag?: (...args: unknown[]) => void };
      analyticsWindow.gtag?.('event', name, { offer: page.dataset.offer, ...params });
    };

    track('ad_landing_view', { landing_path: window.location.pathname });

    const formPlatforms = document.querySelectorAll<HTMLSelectElement>('[data-platform-select]');
    const formPlatform = formPlatforms[0];
    const priceOutputs = document.querySelectorAll<HTMLElement>('[data-current-price]');
    const defaultPrice = priceOutputs[0]?.textContent || '';
    const leadDialog = page.querySelector<HTMLDialogElement>('[data-lead-dialog]');

    const syncWhatsappContext = (platform: string) => {
      const href = platform === 'tilda'
        ? page.dataset.whatsappTilda
        : platform === 'code'
          ? page.dataset.whatsappCode
          : platform === 'recommendation'
            ? page.dataset.whatsappRecommendation
            : page.dataset.whatsappDefault;
      if (!href) return;
      page.querySelectorAll<HTMLAnchorElement>('[data-contextual-whatsapp], [data-hero-secondary-cta]').forEach((link) => {
        link.href = href;
        link.dataset.platformContext = platform || 'unset';
      });
    };

    formPlatforms.forEach((select) => {
      select.addEventListener('change', () => syncWhatsappContext(select.value));
    });
    syncWhatsappContext(formPlatform?.value || '');

    const openLeadDialog = (source: string) => {
      if (!leadDialog) return;
      if (!leadDialog.open) leadDialog.showModal();
      document.body.classList.add('ad-dialog-open');
      track('lead_dialog_open', { source, platform: formPlatform?.value || 'unset' });
      window.setTimeout(() => leadDialog.querySelector<HTMLElement>('input[name="phone"]')?.focus(), 50);
    };

    const closeLeadDialog = () => {
      if (!leadDialog?.open) return;
      leadDialog.close();
      document.body.classList.remove('ad-dialog-open');
    };

    document.querySelectorAll<HTMLInputElement>('[data-platform-choice]').forEach((choice) => {
      choice.addEventListener('change', () => {
        if (!choice.checked) return;
        formPlatforms.forEach((select) => { select.value = choice.value; });
        syncWhatsappContext(choice.value);
        const label = choice.value === 'tilda'
          ? `Tilda — от ${choice.dataset.price ? new Intl.NumberFormat('ru-RU').format(Number(choice.dataset.price)) : ''} ₸`
          : choice.value === 'code'
            ? `Чистый код + CMS — от ${choice.dataset.price ? new Intl.NumberFormat('ru-RU').format(Number(choice.dataset.price)) : ''} ₸`
            : 'Подберём платформу после короткого разговора';
        priceOutputs.forEach((output) => { output.textContent = label || defaultPrice; });
        track('platform_select', { platform: choice.value, displayed_price: choice.dataset.price || null });
        openLeadDialog('platform_choice');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-platform-estimate]').forEach((button) => {
      button.addEventListener('click', () => {
        const platform = button.dataset.platformEstimate;
        const choice = platform
          ? page.querySelector<HTMLInputElement>(`[data-platform-choice][value="${platform}"]`)
          : null;
        track('estimate_cta_click', { platform: platform || 'unset', cta_id: 'platform_card' });
        if (!choice) {
          openLeadDialog('platform_card');
          return;
        }
        if (choice.checked) {
          formPlatforms.forEach((select) => { select.value = choice.value; });
          syncWhatsappContext(choice.value);
          openLeadDialog('platform_card');
          return;
        }
        choice.checked = true;
        choice.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    document.querySelectorAll<HTMLElement>('[data-estimate-cta]').forEach((link) => {
      link.addEventListener('click', (event) => {
        track('estimate_cta_click', {
          platform: formPlatform?.value || 'unset',
          cta_id: link.dataset.ctaId || 'unknown',
        });
        if (!leadDialog) return;
        event.preventDefault();
        openLeadDialog(link.dataset.ctaId || 'estimate_cta');
      });
    });

    page.querySelector<HTMLElement>('[data-hero-primary-cta]')?.addEventListener('click', (event) => {
      if (!leadDialog) return;
      event.preventDefault();
      track('estimate_cta_click', { platform: formPlatform?.value || 'unset', cta_id: 'hero' });
      openLeadDialog('hero');
    });

    page.querySelector<HTMLAnchorElement>('[data-hero-secondary-cta]')?.addEventListener('click', (event) => {
      const link = event.currentTarget as HTMLAnchorElement;
      track('whatsapp_click', { platform: link.dataset.platformContext || formPlatform?.value || 'unset', cta_id: 'hero' });
    });

    page.querySelector<HTMLElement>('[data-open-lead-dialog]')?.addEventListener('click', () => openLeadDialog('estimate_section'));
    leadDialog?.querySelector<HTMLElement>('[data-close-lead-dialog]')?.addEventListener('click', closeLeadDialog);
    leadDialog?.addEventListener('click', (event) => {
      if (event.target === leadDialog) closeLeadDialog();
    });
    leadDialog?.addEventListener('close', () => document.body.classList.remove('ad-dialog-open'));

    document.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-link]').forEach((link) => {
      link.addEventListener('click', () => track('whatsapp_click', {
        platform: link.dataset.platformContext || formPlatform?.value || 'unset',
        cta_id: link.dataset.ctaId || 'unknown',
      }));
    });
  };

  document.addEventListener('DOMContentLoaded', initAdPage);
  document.addEventListener('astro:page-load', initAdPage);
  initAdPage();
</script>
