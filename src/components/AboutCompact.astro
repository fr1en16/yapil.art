---
interface Props {
  theme?: 'dark' | 'light';
  personal?: boolean;
  lang?: 'ru' | 'en';
  websites?: boolean;
  catalog?: boolean;
}

const { theme = 'dark', personal = false, lang = 'ru', websites = false, catalog = false } = Astro.props;
const isLight = theme === 'light';
const isFeaturePage = websites || catalog;

const cardsStudioRu = [
  {
    id: 'experience',
    title: '8\u00A0лет<br />в\u00A0дизайне',
    text: 'Ведём проекты в\u00A0инфобизнесе и\u00A0в\u00A0корпоративном секторе. Лендинг для\u00A0трейдера и\u00A0полиграфия для\u00A0сети стрит-фуда требуют разного, мы\u00A0умеем и\u00A0то, и\u00A0другое.',
    icon: 'award',
  },
  {
    id: 'full-cycle',
    title: 'Полный<br />цикл',
    text: 'Один проект ведёт один дизайнер: от\u00A0первой концепции до\u00A0финальной правки в\u00A0типографии. Ничего не\u00A0отдаём на\u00A0аутсорс.',
    icon: 'refresh-cw',
  },
  {
    id: 'agency',
    title: 'Опыт<br />агентства',
    text: 'Яков был ключевым дизайнером в\u00A0thePeak, которое делало визуал для LUKOIL, Cadillac и\u00A0PUMA, Gippo. Оттуда\u00A0— процессы, по\u00A0которым мы\u00A0держим сроки на\u00A0больших проектах.',
    icon: 'briefcase',
  },
  {
    id: 'three-directions',
    title: 'Три направления<br />в\u00A0одних руках',
    text: 'Бренд, сайт и\u00A0печать делает одна команда, поэтому логотип не\u00A0разъезжается с\u00A0сайтом, а\u00A0сайт\u00A0— с\u00A0буклетом.',
    icon: 'shapes',
  },
];

const cardsPersonalRu = [
  {
    id: 'experience',
    title: '8\u00A0лет<br />в\u00A0дизайне',
    text: 'Веду проекты в\u00A0инфобизнесе и\u00A0в\u00A0корпоративном секторе. Лендинг для\u00A0трейдера и\u00A0полиграфия для\u00A0стрит-фуда требуют разного подхода. Умею и\u00A0то, и\u00A0другое.',
    icon: 'award',
  },
  {
    id: 'full-cycle',
    title: 'Полный<br />цикл',
    text: 'Каждый проект веду сам: от\u00A0первой концепции до\u00A0финальной правки в\u00A0типографии. Ничего не\u00A0отдаю на\u00A0аутсорс.',
    icon: 'refresh-cw',
  },
  {
    id: 'agency',
    title: 'Опыт<br />агентства',
    text: 'Был ключевым дизайнером в\u00A0thePeak, которое делало визуал для LUKOIL, Cadillac, PUMA и\u00A0Gippo. Оттуда взял процессы, которые держат сроки на\u00A0больших проектах.',
    icon: 'briefcase',
  },
  {
    id: 'three-directions',
    title: 'Три направления<br />в\u00A0одних руках',
    text: 'Бренд, сайт и\u00A0печать делаю сам. Логотип, сайт и\u00A0буклет получаются в\u00A0одном стиле, потому что их\u00A0делает один человек.',
    icon: 'shapes',
  },
];

const cardsPersonalEn = [
  {
    id: 'experience',
    title: '8\u00A0years<br />in\u00A0design',
    text: 'Leading projects in\u00A0digital products and the\u00A0corporate sector. A\u00A0fintech landing page and\u00A0street-food packaging require different approaches. I\u00A0master both.',
    icon: 'award',
  },
  {
    id: 'full-cycle',
    title: 'Full<br />cycle',
    text: 'Every project is handled end-to-end personally: from the\u00A0initial concept to\u00A0the\u00A0final print-ready file. Zero outsourcing.',
    icon: 'refresh-cw',
  },
  {
    id: 'agency',
    title: 'Agency<br />background',
    text: 'Key designer at\u00A0thePeak, creating visuals for\u00A0LUKOIL, Cadillac, PUMA, and\u00A0Gippo. That shaped the\u00A0processes I\u00A0use to\u00A0guarantee solid deadlines.',
    icon: 'briefcase',
  },
  {
    id: 'three-directions',
    title: 'Three disciplines<br />in\u00A0one hand',
    text: 'Branding, websites, and\u00A0print handled together. Your logo, website, and\u00A0presentation deck stay seamlessly unified because one person designs them all.',
    icon: 'shapes',
  },
];

const cardsWebsitesRu = [
  {
    id: 'structure',
    title: 'Структура<br />под заявки',
    text: 'Выстраиваем путь от первого экрана до формы: раскрываем ценность, отвечаем на вопросы и снимаем возражения.',
    icon: 'shapes',
  },
  {
    id: 'design',
    title: 'Дизайн<br />без шаблонов',
    text: 'Создаём визуальную систему под характер бренда и адаптируем каждый экран для смартфонов, планшетов и компьютеров.',
    icon: 'award',
  },
  {
    id: 'performance',
    title: 'Быстрый<br />сайт',
    text: 'Собираем сайт на современном стеке, оптимизируем загрузку и готовим техническую основу для продвижения.',
    icon: 'refresh-cw',
  },
  {
    id: 'launch',
    title: 'Запуск<br />под ключ',
    text: 'Подключаем формы, аналитику, домен и CRM, проверяем сайт перед релизом и остаёмся на связи после запуска.',
    icon: 'briefcase',
  },
];

const cards = websites
  ? cardsWebsitesRu
  : lang === 'en'
  ? cardsPersonalEn
  : personal
    ? cardsPersonalRu
    : cardsStudioRu;
const CardHeading = isFeaturePage ? 'h3' : 'h2';
---

<section
  id="about-compact"
  aria-label={lang === 'en' ? 'About me in details' : personal ? 'Обо мне в деталях' : 'О студии в деталях'}
  class:list={[
    'relative z-10 pt-6 pb-16 md:pb-24 transition-colors duration-300',
    isLight ? 'text-[#1D1D1D]' : 'text-white',
  ]}
  style={
    isLight
      ? isFeaturePage
        ? 'background: linear-gradient(to bottom, transparent 0%, rgba(245, 245, 245, 0.32) 22%, rgba(245, 245, 245, 0.82) 54%, #f5f5f5 82%, #f5f5f5 100%);'
        : 'background: #F7F5F2;'
      : 'background: linear-gradient(to bottom, transparent 0%, #181818 100%);'
  }
>
  <div class="container">
    <ol class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 md:gap-[var(--grid-gap)] list-none p-0 m-0">
      {cards.map((card) => (
        <li
          class:list={[
            'group relative flex flex-col justify-between overflow-hidden rounded-none p-7 sm:p-8 backdrop-blur-2xl transition-all duration-300 min-h-[20rem] sm:min-h-[26rem] lg:min-h-[30rem]',
            isLight
              ? (isFeaturePage ? 'border-0 bg-white/80' : 'border border-black/[0.08] bg-white/80 hover:border-[#FD4B32]/50 hover:bg-white hover:shadow-[0_16px_36px_-8px_rgba(0,0,0,0.06)]')
              : 'border border-white/10 bg-white/[0.04] hover:border-white/25 hover:bg-white/[0.08]',
          ]}
        >
          <div class="flex flex-col gap-5 sm:gap-6">
            <CardHeading
              class:list={[
                'm-0 p-0 text-[2rem] sm:text-[2.25rem] font-normal leading-[1.05] tracking-[-0.035em]',
                isLight ? (isFeaturePage ? 'text-[#FD4B32]' : 'text-[#1D1D1D]') : 'text-white',
              ]}
              style="font-family: var(--font-display);"
              set:html={card.title}
            />
            <p
              class:list={[
                'm-0 p-0 text-base leading-[1.3] text-pretty',
                isLight ? 'text-[#1D1D1D]/75' : 'text-white/80',
              ]}
            >
              {card.text}
            </p>
          </div>

          <div class="mt-auto pt-8 flex items-end">
            {card.icon === 'award' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class:list={['size-6 sm:size-7 transition-transform duration-300', isLight ? (isFeaturePage ? 'text-[#1D1D1D]' : 'text-[#1D1D1D] group-hover:text-[#FD4B32] group-hover:scale-110') : 'text-white group-hover:scale-110']}>
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
            )}
            {card.icon === 'refresh-cw' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class:list={['size-6 sm:size-7 transition-transform duration-300', isLight ? (isFeaturePage ? 'text-[#1D1D1D]' : 'text-[#1D1D1D] group-hover:text-[#FD4B32] group-hover:scale-110') : 'text-white group-hover:scale-110']}>
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                <path d="M8 16H3v5" />
              </svg>
            )}
            {card.icon === 'briefcase' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class:list={['size-6 sm:size-7 transition-transform duration-300', isLight ? (isFeaturePage ? 'text-[#1D1D1D]' : 'text-[#1D1D1D] group-hover:text-[#FD4B32] group-hover:scale-110') : 'text-white group-hover:scale-110']}>
                <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                <rect width="20" height="14" x="2" y="6" rx="2" />
              </svg>
            )}
            {card.icon === 'shapes' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class:list={['size-6 sm:size-7 transition-transform duration-300', isLight ? (isFeaturePage ? 'text-[#1D1D1D]' : 'text-[#1D1D1D] group-hover:text-[#FD4B32] group-hover:scale-110') : 'text-white group-hover:scale-110']}>
                <path d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3.1a.7.7 0 0 1 1.198 0l3.726 5.82A.7.7 0 0 1 15.7 10z" />
                <circle cx="17.5" cy="17.5" r="4.5" />
                <rect width="7" height="7" x="3" y="14" rx="1" />
              </svg>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
