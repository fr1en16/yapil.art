---
import { RuixenGradientFooter } from './ui/ruixen-gradient-footer';
import { getWhatsAppUrl } from '../utils/messengerLinks';

interface Props {
  theme?: 'dark' | 'light';
  personal?: boolean;
}

const { theme = 'dark', personal = false } = Astro.props;
const isLight = theme === 'light';
const homePath = '/';

const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, Astro.site).href;
const whatsappHref = getWhatsAppUrl({
  pageTitle: 'Футер сайта',
  pageUrl: currentUrl,
  sourceContext: 'footer_link',
});

const lightStops = [
  { offset: 0, color: '#FD4B32' },
  { offset: 0.25, color: '#FE6852' },
  { offset: 0.5, color: '#FFA08E' },
  { offset: 0.75, color: '#FFC8BE' },
  { offset: 1, color: '#FFF0ED' },
];
---

<RuixenGradientFooter
  client:visible
  className={isLight ? 'site-footer theme-light' : 'site-footer'}
  gradientHeight="clamp(20rem, 52vh, 38rem)"
  blur={42}
  stops={isLight ? lightStops : undefined}
>
  <div class="footer-content">
    <div class="container footer-top">
      <div class="footer-meta">
        <a class="footer-brand" href={homePath} aria-label="Yapil.art — на главную">
          <span class="footer-brand-name">Yapil.art</span>
        </a>
        <p class="footer-brand-desc">
          {personal
            ? <>Дизайн от первого эскиза до печати или релиза.<br />Веду каждый проект сам.</>
            : <>Дизайн-студия полного цикла.<br />От первой концепции до печати или релиза.</>}
        </p>
      </div>

      <div class="footer-columns">
        <nav aria-label="Навигация в подвале">
          <h2>{personal ? 'Обо мне' : 'Студия'}</h2>
          {personal && <a href={`${homePath}#about`}>Обо мне</a>}
          <a href="/services">Услуги</a>
          <a href={`${homePath}#cases`}>Кейсы</a>
        </nav>

        <nav aria-label="Контакты">
          <h2>На связи</h2>
          <a href="https://t.me/yakov_pil" target="_blank" rel="noopener noreferrer">Telegram ↗</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <a href="mailto:hi@yapil.art">Email ↗</a>
        </nav>
      </div>
    </div>

  </div>

</RuixenGradientFooter>

<style is:global>
  .site-footer {
    position: relative;
    isolation: isolate;
    padding-top: 0;
    color: white;
    background: #0b0b0c;
  }

  .site-footer.theme-light {
    color: #1D1D1D;
    background: #EAE5DF;
  }

  .site-footer.theme-light .footer-columns h2 {
    color: #8C8882;
  }

  .site-footer.theme-light .footer-columns a {
    color: #1D1D1D;
  }

  .site-footer.theme-light .footer-columns a:hover {
    color: var(--accent);
  }

  .footer-content {
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2.5rem clamp(2rem, 5vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 280px;
    max-width: 32rem;
  }

  .footer-brand {
    text-decoration: none;
    display: inline-block;
  }

  .footer-brand-name {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #fff;
    transition: color 0.2s ease;
  }

  .footer-brand:hover .footer-brand-name {
    color: #82f2c9;
  }

  .site-footer.theme-light .footer-brand-name {
    color: #1D1D1D;
  }

  .site-footer.theme-light .footer-brand:hover .footer-brand-name {
    color: var(--accent, #FD4B32);
  }

  .footer-brand-desc {
    color: #8B8B8B;
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.5;
    margin: 0;
    white-space: normal;
    word-break: keep-all;
    hyphens: none;
  }

  .site-footer.theme-light .footer-brand-desc {
    color: #66635F;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(7rem, 1fr));
    gap: 2rem clamp(2.5rem, 5vw, 5.5rem);
  }

  .footer-columns nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .footer-columns h2 {
    margin: 0 0 0.7rem;
    color: #8b8b8b;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-columns a {
    text-decoration: none;
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
  }

  .footer-columns a:hover {
    color: var(--accent-tint);
  }

  .ruixen-gradient-band {
    position: fixed;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    transform-origin: bottom;
    will-change: transform;
  }

  .ruixen-gradient-band svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .ruixen-gradient-band {
      transform: scaleY(1) !important;
      will-change: auto;
    }
  }
</style>
