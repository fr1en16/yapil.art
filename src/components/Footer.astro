---
import { RuixenGradientFooter } from './ui/ruixen-gradient-footer';
import { getWhatsAppUrl } from '../utils/messengerLinks';

interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props;
const isLight = theme === 'light';
const homePath = isLight ? '/light' : '/';

const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, Astro.site).href;
const whatsappHref = getWhatsAppUrl({
  pageTitle: 'Футер сайта',
  pageUrl: currentUrl,
  sourceContext: 'footer_link',
});

const lightStops = [
  { offset: 0, color: '#FD4B32' },
  { offset: 0.25, color: '#FE6852' },
  { offset: 0.5, color: '#FFA08E' },
  { offset: 0.75, color: '#FFC8BE' },
  { offset: 1, color: '#FFF0ED' },
];
---

<RuixenGradientFooter
  client:visible
  className={isLight ? 'site-footer theme-light' : 'site-footer'}
  gradientHeight="clamp(20rem, 52vh, 38rem)"
  blur={42}
  stops={isLight ? lightStops : undefined}
>
  <div class="footer-content">
    <div class="container footer-top">
      <div class="footer-meta">
        <a class="footer-brand" href={homePath} aria-label="Yapil.art — на главную">
          <span class="footer-brand-name">Yapil.art</span>
        </a>
        <p class="footer-brand-desc">Дизайн-студия полного цикла.<br />От первой концепции до печати или релиза.</p>
      </div>

      <div class="footer-columns">
        <nav aria-label="Навигация в подвале">
          <h2>Студия</h2>
          <a href={`${homePath}#about`}>О студии</a>
          <a href="/services">Услуги</a>
          <a href="/solutions">Отрасли</a>
          <a href={`${homePath}#cases`}>Кейсы</a>
          <a href="/cases">Все работы</a>
          <a href="/review">Оставить отзыв</a>
        </nav>

        <nav aria-label="Контакты">
          <h2>На связи</h2>
          <a href="https://t.me/yakov_pil" target="_blank" rel="noopener noreferrer">Telegram ↗</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <a href="mailto:hi@yapil.art">Email ↗</a>
        </nav>
      </div>
    </div>

  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} yapil.art</span>
    <div class="footer-bottom-links">
      <a href="/privacy">Конфиденциальность</a>
      <span class="footer-divider" aria-hidden="true">·</span>
      <a href="/review">Оставить отзыв</a>
      <span class="footer-divider" aria-hidden="true">·</span>
      <a href="/crm" class="footer-crm-link" title="Внутренняя CRM студии">CRM</a>
    </div>
  </div>
</RuixenGradientFooter>

<style is:global>
  .site-footer {
    position: relative;
    isolation: isolate;
    padding-top: 0;
    color: white;
    background: #0b0b0c;
  }

  .site-footer.theme-light {
    color: #1D1D1D;
    background: #EAE5DF;
  }

  .site-footer.theme-light .footer-columns h2 {
    color: #8C8882;
  }

  .site-footer.theme-light .footer-columns a {
    color: #1D1D1D;
  }

  .site-footer.theme-light .footer-columns a:hover,
  .site-footer.theme-light .footer-bottom a:hover {
    color: var(--accent);
  }

  .site-footer.theme-light .footer-bottom {
    color: rgba(29, 29, 29, 0.7);
  }

  .site-footer.theme-light .footer-bottom a {
    color: rgba(29, 29, 29, 0.7);
  }

  .footer-content {
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2.5rem clamp(2rem, 5vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 280px;
    max-width: 32rem;
  }

  .footer-brand {
    text-decoration: none;
    display: inline-block;
  }

  .footer-brand-name {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #fff;
    transition: color 0.2s ease;
  }

  .footer-brand:hover .footer-brand-name {
    color: #82f2c9;
  }

  .site-footer.theme-light .footer-brand-name {
    color: #1D1D1D;
  }

  .site-footer.theme-light .footer-brand:hover .footer-brand-name {
    color: var(--accent, #FD4B32);
  }

  .footer-brand-desc {
    color: #8B8B8B;
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.5;
    margin: 0;
    white-space: normal;
    word-break: keep-all;
    hyphens: none;
  }

  .site-footer.theme-light .footer-brand-desc {
    color: #66635F;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(7rem, 1fr));
    gap: 2rem clamp(2.5rem, 5vw, 5.5rem);
  }

  .footer-columns nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .footer-columns h2 {
    margin: 0 0 0.7rem;
    color: #8b8b8b;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-columns a,
  .footer-bottom a {
    text-decoration: none;
  }

  .footer-columns a:hover,
  .footer-bottom a:hover {
    color: var(--accent-tint);
  }

  .footer-bottom {
    position: absolute;
    z-index: 2;
    bottom: clamp(1.25rem, 3vh, 2rem);
    left: 50%;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    color: rgb(255 255 255 / 82%);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    transform: translateX(-50%);
    text-transform: uppercase;
  }

  .footer-bottom > * {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .footer-bottom-links {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-divider {
    opacity: 0.4;
  }

  .footer-crm-link {
    color: var(--accent-tint, #F7C8BF);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .footer-crm-link:hover {
    color: #ffffff;
  }

  .footer-bottom > :first-child {
    margin-right: auto;
  }

  .ruixen-gradient-band {
    position: fixed;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    transform-origin: bottom;
    will-change: transform;
  }

  .ruixen-gradient-band svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (min-width: 48rem) {
    .footer-bottom {
      align-items: center;
    }
  }

  @media (max-width: 47.99rem) {
    .footer-bottom {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .footer-bottom > :first-child {
      margin-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ruixen-gradient-band {
      transform: scaleY(1) !important;
      will-change: auto;
    }
  }
</style>
