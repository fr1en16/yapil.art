---
interface ProcessStep {
  number?: string;
  title: string;
  text: string;
}

interface Props {
  embedded?: boolean;
  steps?: ProcessStep[];
}

const { embedded = false, steps: suppliedSteps } = Astro.props;
const ProcessHeading = embedded ? 'h2' : 'h1';
const StepHeading = embedded ? 'h3' : 'h2';
const defaultSteps = [
  {title:'Исследование', second:'и стратегия', text:'Разбираемся в вашем бизнесе, аудитории и задачах. Находим точку старта и строим понятный путь к результату.'},
  {title:'Дизайн', second:'и итерации', text:'Собираем визуальную систему и дизайн сайта. Обсуждаем, уточняем и доводим каждую деталь до нужного решения.'},
  {title:'Разработка', second:'и запуск', text:'Превращаем дизайн в быстрый, адаптивный сайт. Настраиваем интеграции, проверяем и готовим всё к запуску.'},
  {title:'Поддержка', second:'и развитие', text:'Остаёмся на связи после запуска. Помогаем обновлять сайт и развивать его вместе с вашим бизнесом.'},
];
const splitTitle = (title: string) => {
  const separator = title.indexOf(' и ');
  return separator > 0
    ? { title: title.slice(0, separator), second: title.slice(separator + 1) }
    : { title, second: '' };
};
const steps = suppliedSteps?.length
  ? suppliedSteps.map((step) => ({ ...step, ...splitTitle(step.title) }))
  : defaultSteps;
const projects = [
  {name:'Compass', tags:'Брендинг, дизайн, сайт', image:'https://media.yapil.art/case/compass.43224367a0a82ebc.webp', slug:'compass', alt:'Айдентика и сайт консалтинговой компании Compass'},
  {name:'Shanding', tags:'Дизайн, сайт, полиграфия', image:'https://media.yapil.art/case/shanding.d6eb5d5dc754711d.webp', slug:'shanding', alt:'Сайт и визуальный стиль логистической компании Shanding'},
  {name:'Kirpi', tags:'Интернет-магазин', image:'https://media.yapil.art/case/kirpi-cover.182cc9120e9bbe71.webp', slug:'kirpi', alt:'Интернет-магазин модного бренда Kirpi'},
];
---
<div class="process-work">
<section class="process-section" id="process" aria-labelledby="pw-process-title" style={`--process-screens: ${steps.length + 1}; --process-columns: ${steps.length};`}>
  <div class="process-pin">
    <div class="process-heading"><div class="route" aria-hidden="true"><span>А</span><span>→</span><span>Б</span></div><p data-reveal>Путь бывает непростым.<br />Мы помогаем двигаться вперёд.</p><ProcessHeading class="process-title" id="pw-process-title" data-reveal>Наш <span class="process-title-break">процесс</span></ProcessHeading></div>
    <div class="process-stage">
      <div class="process-grid">{steps.map((step,i)=><article class="process-card"><span class="step-number">{step.number ?? String(i + 1).padStart(2, '0')}</span><div class="step-copy"><StepHeading class="step-title">{step.title}{step.second && <><br/><em>{step.second}</em></>}</StepHeading><p>{step.text}</p></div></article>)}</div>
      <canvas class="road-canvas" aria-hidden="true"></canvas>
    </div>
  </div>
</section>
{!embedded && <section class="work-section" id="work" aria-labelledby="work-title">
  <div class="work-pin">
    <div class="work-left"><h2 id="work-title" data-reveal>Избранные<br/><em>проекты</em></h2><div class="work-list" aria-label="Выбор проекта">{projects.map((project,i)=><button class="work-item" type="button" data-project={i} aria-controls={`project-${i}`} aria-label={`Показать проект ${project.name}`}><span class="project-number">0{i+1}.</span><span class="project-name">{project.name}</span><span class="project-tags">{project.tags}</span></button>)}</div></div>
    <div class="work-images">{projects.map((project,i)=><a class="work-slide" id={`project-${i}`} href={`/case/${project.slug}`} aria-label={`Смотреть кейс ${project.name}`}><img src={project.image} alt={project.alt} loading="eager" decoding="async"/><span class="project-cta"><svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id={`circle-${i}`} d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs><text><textPath href={`#circle-${i}`} textLength="289">СМОТРЕТЬ ПРОЕКТ · СМОТРЕТЬ ПРОЕКТ · </textPath></text></svg><span>↗</span></span><span class="mobile-caption">0{i+1}. {project.name} ↗</span></a>)}</div>
  </div>
</section>}
</div>
<script>
  import { initProcessWork } from './motion';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessWork, { once: true });
  } else {
    initProcessWork();
  }
  document.addEventListener('astro:page-load', initProcessWork);
  window.addEventListener('pageshow', (event) => { if (event.persisted) initProcessWork(); });
</script>
<style>
.process-work{background:var(--page-neutral-surface,#fff);color:#FD4B32;font-family:'Inter Tight Variable',Arial,sans-serif;line-height:1.3;letter-spacing:normal}.process-work :is(h1,h2,h3){font-family:Oranienbaum,Georgia,serif;font-weight:400;margin:0}.process-work p{margin:0}.process-work a{text-decoration:none}.process-work button{font:inherit}.process-work :is(a,button):focus-visible{outline:2px solid currentColor;outline-offset:4px}

.process-section,.work-section{width:min(calc(100% - var(--container-inline-space,4rem)),var(--container-max,88rem));margin-inline:auto}.process-section{height:calc(var(--process-screens,5) * 100vh)}.process-pin{height:100svh;position:sticky;top:0;padding-top:clamp(35px,8vh,85px);padding-bottom:20px;display:flex;flex-direction:column}.process-heading{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--grid-gap,12px);align-items:center;margin-bottom:32px;min-height:60px}.route{display:flex;justify-content:space-between;font-size:16px}.process-heading p{grid-column:3;font-size:18px;line-height:1.16}.process-heading .process-title{justify-self:end;font-size:26px;padding:10px 0;white-space:nowrap}.process-stage{position:relative;flex:1;min-height:0}.process-grid{display:grid;grid-template-columns:repeat(var(--process-columns,4),minmax(0,1fr));gap:var(--grid-gap,12px);height:100%}.process-card{position:relative;background:#FD4B32;color:white;padding:24px 20px;overflow:hidden}.step-number{font:16px ui-monospace,monospace}.step-copy{position:absolute;bottom:24px;left:20px;right:20px}.step-copy .step-title{font-size:clamp(24px,2.35vw,44px);line-height:1.03;margin-bottom:24px}.step-copy em{font-style:normal}.step-copy p{font-size:clamp(14px,1vw,16px);line-height:1.4;max-width:38ch}.road-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.work-section{margin-top:100px}.work-pin{height:100svh;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap,12px);overflow:hidden}.work-left{grid-column:span 5;padding:50px 0 16px;display:flex;flex-direction:column;justify-content:space-between;min-width:0}.work-left h2{font-size:clamp(64px,7.4vw,144px);line-height:.98;letter-spacing:-.035em}.work-left h2 em{font-style:normal}.work-list{margin-top:50px}.work-item{display:flex;align-items:center;gap:16px;width:100%;padding:22px 0;border:0;border-bottom:1px solid currentColor;background:transparent;color:inherit;text-align:left;cursor:pointer}.work-item:last-child{border-bottom:0}.project-number{font:14px ui-monospace,monospace}.project-name{font-family:Oranienbaum,serif;font-size:clamp(28px,2.5vw,48px)}.project-tags{margin-left:auto;font:11px ui-monospace,monospace;text-transform:uppercase;text-align:right;max-width:45%}.work-images{grid-column:span 7;position:relative;min-width:0;height:100%;background:var(--page-neutral-surface,#f6f5f3)}.work-slide{position:absolute;inset:0;overflow:hidden}.work-slide img{width:100%;height:100%;object-fit:cover;display:block}.project-cta{position:absolute;left:50%;top:60%;width:120px;height:120px;transform:translate(-50%,-50%);opacity:0;transition:opacity .25s;pointer-events:none;color:#FD4B32}.work-slide:hover .project-cta,.work-slide:focus-visible .project-cta{opacity:1}.project-cta svg{width:100%;height:100%;animation:orbit 20s linear infinite;fill:currentColor;font:10px 'Inter Tight Variable',sans-serif;letter-spacing:1px}.project-cta>span{position:absolute;inset:30px;border-radius:50%;display:grid;place-items:center;color:white;background:#FD4B32;font-size:32px}.mobile-caption{display:none}@keyframes orbit{to{transform:rotate(360deg)}}
@media(max-width:991px){.process-section{height:calc(var(--process-screens,5) * 100svh)}.process-pin{height:100svh;position:sticky;top:0;padding-top:68px;padding-bottom:24px;overflow:hidden}.process-heading{grid-template-columns:minmax(7.5rem,.75fr) minmax(0,1.25fr);grid-template-rows:auto auto;gap:16px 12px;align-items:start;margin-bottom:22px;min-height:94px}.route{display:flex;grid-column:1/-1;grid-row:2;width:100%;font-size:14px}.process-heading p{grid-column:2;grid-row:1;width:100%;max-width:none;font-size:16px;line-height:1.3}.process-heading .process-title{grid-column:1;grid-row:1;justify-self:start;align-self:start;font-size:clamp(32px,8.5vw,36px)!important;line-height:.94;padding:5px 0 7px;border:0;border-radius:0;white-space:normal}.process-title-break{display:block}.process-stage{flex:1;min-height:0;overflow:hidden}.process-grid{display:flex;grid-template-columns:none;gap:var(--grid-gap,12px);width:max-content;height:100%;will-change:transform}.process-card{flex:0 0 calc(100vw - var(--container-inline-space,2rem));width:calc(100vw - var(--container-inline-space,2rem));min-height:0;height:100%;padding:20px;overflow:hidden}.step-copy{bottom:22px}.step-copy .step-title{font-size:clamp(38px,11vw,54px);margin-bottom:20px}.step-copy p{font-size:16px;line-height:1.3;max-width:40ch}.road-canvas{display:block;inset:0 auto 0 0;height:100%;max-width:none;will-change:transform}.work-section{margin-top:60px}.work-pin{height:auto;display:block;overflow:visible}.work-left{padding:30px 0}.work-left h2{font-size:clamp(60px,12vw,110px)}.work-list{display:none}.work-images{display:grid;gap:16px;padding:0;background:var(--page-neutral-surface,white);height:auto}.work-slide{position:relative;height:75svh;min-height:360px}.mobile-caption{display:block;position:absolute;bottom:0;left:0;right:0;padding:20px;color:white;background:linear-gradient(transparent,#0009);font:30px Oranienbaum,serif}.project-cta{display:none}}
@media(max-width:520px){.process-card{flex-basis:calc(100vw - var(--container-inline-space,2rem));width:calc(100vw - var(--container-inline-space,2rem))}.step-copy .step-title{font-size:40px}.step-copy p{max-width:40ch}.work-slide{height:60svh}}
@media(prefers-reduced-motion:reduce){.process-section{height:auto}.process-pin{position:relative;min-height:760px;height:100svh}.work-pin{height:auto;min-height:100svh;overflow:visible}.work-images{display:grid;height:auto;gap:16px}.work-slide{position:relative;height:80svh}.project-cta svg{animation:none}.work-list{display:none}.mobile-caption{display:block;position:absolute;bottom:0;padding:20px;background:var(--page-neutral-surface,white)}.work-left{justify-content:flex-start}.road-canvas{display:none}}
</style>
<style>
@media(max-width:991px) and (prefers-reduced-motion:reduce){.process-pin{height:auto;min-height:0;overflow:visible}.process-stage{overflow:visible}.process-grid{display:grid;width:100%;height:auto}.process-card{width:auto;min-height:420px;height:auto}.work-pin{min-height:0}}
</style>

<style>
@media(min-width:992px) and (prefers-reduced-motion:no-preference){.work-section{height:calc(100svh * var(--work-screens,3))}.work-pin{position:sticky;top:0}.work-slide:not(:first-child){clip-path:inset(100% 0 0 100%)}.work-item:not(:first-child){opacity:.28}}
</style>
