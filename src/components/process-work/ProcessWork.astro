---
interface Props { embedded?: boolean; }
const { embedded = false } = Astro.props;
const ProcessHeading = embedded ? 'h2' : 'h1';
const StepHeading = embedded ? 'h3' : 'h2';
const steps = [
  {title:'Исследование', second:'и стратегия', text:'Разбираемся в вашем бизнесе, аудитории и задачах. Находим точку старта и строим понятный путь к результату.'},
  {title:'Дизайн', second:'и итерации', text:'Собираем визуальную систему и дизайн сайта. Обсуждаем, уточняем и доводим каждую деталь до нужного решения.'},
  {title:'Разработка', second:'и запуск', text:'Превращаем дизайн в быстрый, адаптивный сайт. Настраиваем интеграции, проверяем и готовим всё к запуску.'},
  {title:'Поддержка', second:'и развитие', text:'Остаёмся на связи после запуска. Помогаем обновлять сайт и развивать его вместе с вашим бизнесом.'},
];
const projects = [
  {name:'Compass', tags:'Брендинг, дизайн, сайт', image:'/case/compass.webp', slug:'compass', alt:'Айдентика и сайт консалтинговой компании Compass'},
  {name:'Shanding', tags:'Дизайн, сайт, полиграфия', image:'/case/shanding.webp', slug:'shanding', alt:'Сайт и визуальный стиль логистической компании Shanding'},
  {name:'Onmacabim', tags:'Дизайн, сайт', image:'/case/onmacabim.webp', slug:'onmacabim', alt:'Проект Onmacabim — профессиональная косметика'},
];
---
<div class="process-work">
<section class="process-section" id="process" aria-labelledby="pw-process-title">
  <div class="process-pin">
    <div class="process-heading"><div class="route" aria-hidden="true"><span>А</span><span>→</span><span>Б</span></div><p data-reveal>Путь бывает непростым.<br />Мы помогаем двигаться вперёд.</p><ProcessHeading class="process-title" id="pw-process-title" data-reveal>Наш процесс</ProcessHeading></div>
    <div class="process-stage">
      <div class="process-grid">{steps.map((step,i)=><article class="process-card"><span class="step-number">0{i+1}</span><div class="step-copy"><StepHeading class="step-title">{step.title}<br/><em>{step.second}</em></StepHeading><p>{step.text}</p></div></article>)}</div>
      <canvas class="road-canvas" aria-hidden="true"></canvas>
    </div>
  </div>
</section>
<section class="work-section" id="work" aria-labelledby="work-title">
  <div class="work-pin">
    <div class="work-left"><h2 id="work-title" data-reveal>Избранные<br/><em>проекты</em></h2><div class="work-list" aria-label="Выбор проекта">{projects.map((project,i)=><button class="work-item" type="button" data-project={i} aria-controls={`project-${i}`} aria-label={`Показать проект ${project.name}`}><span class="project-number">0{i+1}.</span><span class="project-name">{project.name}</span><span class="project-tags">{project.tags}</span></button>)}</div></div>
    <div class="work-images">{projects.map((project,i)=><a class="work-slide" id={`project-${i}`} href={`/case/${project.slug}`} aria-label={`Смотреть кейс ${project.name}`}><img src={project.image} alt={project.alt} loading="eager" decoding="async"/><span class="project-cta"><svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id={`circle-${i}`} d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs><text><textPath href={`#circle-${i}`} textLength="289">СМОТРЕТЬ ПРОЕКТ · СМОТРЕТЬ ПРОЕКТ · </textPath></text></svg><span>↗</span></span><span class="mobile-caption">0{i+1}. {project.name} ↗</span></a>)}</div>
  </div>
</section>
</div>
<script>
  import { initProcessWork } from './motion';
  initProcessWork();
</script>
<style>
.process-work{background:#fff;color:#FD4B32;font-family:'Inter Tight Variable',Arial,sans-serif;line-height:1.3;letter-spacing:normal}.process-work :is(h1,h2,h3){font-family:Oranienbaum,Georgia,serif;font-weight:400;margin:0}.process-work p{margin:0}.process-work a{text-decoration:none}.process-work button{font:inherit}.process-work :is(a,button):focus-visible{outline:2px solid currentColor;outline-offset:4px}

.process-section{height:500vh;padding:0 20px}.process-pin{height:100svh;position:sticky;top:0;padding-top:clamp(35px,8vh,85px);padding-bottom:20px;display:flex;flex-direction:column}.process-heading{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;align-items:center;margin-bottom:32px;min-height:60px}.route{display:flex;justify-content:space-between;font-size:16px}.process-heading p{grid-column:3;font-size:18px;line-height:1.16}.process-heading .process-title{justify-self:end;font-size:26px;border:1px solid;border-radius:50%;padding:10px 28px;white-space:nowrap}.process-stage{position:relative;flex:1;min-height:0}.process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;height:100%}.process-card{position:relative;background:#FD4B32;color:white;padding:24px 20px;overflow:hidden}.step-number{font:16px ui-monospace,monospace}.step-copy{position:absolute;bottom:24px;left:20px;right:20px}.step-copy .step-title{font-size:clamp(26px,2.8vw,48px);line-height:1.03;margin-bottom:24px}.step-copy em{font-style:normal}.step-copy p{font-size:clamp(14px,1vw,16px);line-height:1.4;max-width:38ch}.road-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.work-section{margin-top:100px}.work-pin{height:100svh;display:grid;grid-template-columns:40% 60%;overflow:hidden}.work-left{padding:50px 20px 16px;display:flex;flex-direction:column;justify-content:space-between;min-width:0}.work-left h2{font-size:clamp(64px,7.4vw,144px);line-height:.98;letter-spacing:-.035em}.work-left h2 em{font-style:normal}.work-list{margin-top:50px}.work-item{display:flex;align-items:center;gap:16px;width:100%;padding:22px 0;border:0;border-bottom:1px solid currentColor;background:transparent;color:inherit;text-align:left;cursor:pointer}.work-item:last-child{border-bottom:0}.project-number{font:14px ui-monospace,monospace}.project-name{font-family:Oranienbaum,serif;font-size:clamp(28px,2.5vw,48px)}.project-tags{margin-left:auto;font:11px ui-monospace,monospace;text-transform:uppercase;text-align:right;max-width:45%}.work-images{position:relative;min-width:0;height:100%;background:#f6f5f3}.work-slide{position:absolute;inset:0;overflow:hidden}.work-slide img{width:100%;height:100%;object-fit:cover;display:block}.project-cta{position:absolute;left:50%;top:60%;width:120px;height:120px;transform:translate(-50%,-50%);opacity:0;transition:opacity .25s;pointer-events:none;color:#FD4B32}.work-slide:hover .project-cta,.work-slide:focus-visible .project-cta{opacity:1}.project-cta svg{width:100%;height:100%;animation:orbit 20s linear infinite;fill:currentColor;font:10px 'Inter Tight Variable',sans-serif;letter-spacing:1px}.project-cta>span{position:absolute;inset:30px;border-radius:50%;display:grid;place-items:center;color:white;background:#FD4B32;font-size:32px}.mobile-caption{display:none}@keyframes orbit{to{transform:rotate(360deg)}}
@media(max-width:991px){.process-section{height:auto;padding:0 16px}.process-pin{height:auto;position:relative;padding-top:50px}.process-heading{grid-template-columns:1fr 1fr;margin-bottom:28px}.route{display:none}.process-heading p{grid-column:1;font-size:16px}.process-heading .process-title{font-size:24px;padding:10px 18px}.process-stage{min-height:720px}.process-grid{grid-template-columns:repeat(2,minmax(0,1fr));height:auto}.process-card{min-height:350px}.step-copy .step-title{font-size:34px}.step-copy p{font-size:15px}.road-canvas{display:none}.work-section{margin-top:60px}.work-pin{height:auto;display:block;overflow:visible}.work-left{padding:30px 16px}.work-left h2{font-size:clamp(60px,12vw,110px)}.work-list{display:none}.work-images{display:grid;gap:16px;padding:0 16px;background:white;height:auto}.work-slide{position:relative;height:75svh;min-height:360px}.mobile-caption{display:block;position:absolute;bottom:0;left:0;right:0;padding:20px;color:white;background:linear-gradient(transparent,#0009);font:30px Oranienbaum,serif}.project-cta{display:none}}
@media(max-width:520px){.process-heading{display:flex;flex-direction:column-reverse;align-items:flex-start;gap:20px}.process-heading .process-title{border:0;padding:0;font-size:44px}.process-grid{grid-template-columns:1fr}.process-stage{min-height:0}.process-card{min-height:320px}.step-copy{bottom:24px}.step-copy .step-title{font-size:40px}.step-copy p{max-width:40ch}.work-slide{height:60svh}}
@media(prefers-reduced-motion:reduce){.process-section{height:auto}.process-pin{position:relative;min-height:760px;height:100svh}.work-pin{height:auto;min-height:100svh;overflow:visible}.work-images{display:grid;height:auto;gap:16px}.work-slide{position:relative;height:80svh}.project-cta svg{animation:none}.work-list{display:none}.mobile-caption{display:block;position:absolute;bottom:0;padding:20px;background:white}.work-left{justify-content:flex-start}.road-canvas{display:none}}
</style>
<style>
@media(max-width:991px) and (prefers-reduced-motion:reduce){.process-pin{height:auto;min-height:0}.work-pin{min-height:0}}
</style>
