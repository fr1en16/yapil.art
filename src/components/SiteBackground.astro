<div class="site-background" aria-hidden="true">
  <canvas data-site-shader></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-site-shader]');

  const vertexShaderGLSL = `
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = position * 0.5 + 0.5;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const fragmentShaderGLSL = `
    precision highp float;
    varying vec2 vUv;

    uniform vec2 u_resolution;
    uniform float u_time;
    uniform float u_grain;
    uniform vec3 u_colors[4];
    uniform vec3 u_bg;

    vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }

    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
      vec2 i = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
      m = m * m;
      m = m * m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
      vec3 g;
      g.x = a0.x * x0.x + h.x * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    void main() {
      vec2 uv = vUv;
      float ratio = u_resolution.x / u_resolution.y;
      vec2 p = uv - 0.5;
      p.x *= ratio;

      float t = u_time * 0.1;
      float n1 = snoise(p * 0.4 + vec2(t * 0.2, -t * 0.3));
      float n2 = snoise(p * 0.55 + vec2(-t * 0.15, t * 0.25) + n1 * 0.25);
      float n3 = snoise(p * 0.75 + vec2(t * 0.1, -t * 0.2) + n2 * 0.2);

      vec3 col = u_bg;
      float dist = length(p) * 1.5;
      float vignette = 1.0 - smoothstep(0.4, 1.3, dist);

      col = mix(col, u_colors[0], smoothstep(-0.2, 0.6, n1) * 0.65);
      col = mix(col, u_colors[1], smoothstep(-0.1, 0.6, n2) * 0.6);
      col = mix(col, u_colors[2], smoothstep(-0.3, 0.4, n3) * 0.6);
      col = mix(col, u_colors[3], smoothstep(0.0, 0.7, n1 * n2) * 0.5);

      col = mix(col * 0.35, col, vignette);

      float grain = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453 + u_time);
      col += (grain - 0.5) * u_grain * 0.06;
      gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
    }
  `;

  const hexToRgb = (hex: string): [number, number, number] => {
    const value = hex.replace('#', '');
    return [
      Number.parseInt(value.slice(0, 2), 16) / 255,
      Number.parseInt(value.slice(2, 4), 16) / 255,
      Number.parseInt(value.slice(4, 6), 16) / 255,
    ];
  };

  if (canvas) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });

    if (gl) {
      const createShader = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
      };

      const vertexShader = createShader(gl.VERTEX_SHADER, vertexShaderGLSL);
      const fragmentShader = createShader(gl.FRAGMENT_SHADER, fragmentShaderGLSL);
      const program = gl.createProgram();

      if (vertexShader && fragmentShader && program) {
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.useProgram(program);

        const buffer = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

        const position = gl.getAttribLocation(program, 'position');
        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

        const resolutionLocation = gl.getUniformLocation(program, 'u_resolution');
        const timeLocation = gl.getUniformLocation(program, 'u_time');
        const grainLocation = gl.getUniformLocation(program, 'u_grain');
        const colorsLocation = gl.getUniformLocation(program, 'u_colors[0]');
        const backgroundLocation = gl.getUniformLocation(program, 'u_bg');
        const brandBackground = hexToRgb('#FD4B32');
        const brandColors = ['#FF6044', '#FD4B32', '#A32A17', '#310B06'].flatMap(hexToRgb);
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let shaderFrame = 0;
        let lastFrameTime = 0;
        let cachedWidth = 1;
        let cachedHeight = 1;
        let isMobileDevice = false;

        const resize = () => {
          isMobileDevice = window.innerWidth < 768 || window.matchMedia('(pointer: coarse)').matches;
          const dpr = isMobileDevice ? 1 : Math.min(window.devicePixelRatio || 1, 1.5);
          cachedWidth = Math.max(1, Math.round(window.innerWidth * dpr));
          cachedHeight = Math.max(1, Math.round(window.innerHeight * dpr));
          canvas.width = cachedWidth;
          canvas.height = cachedHeight;
          gl.viewport(0, 0, cachedWidth, cachedHeight);
        };

        const draw = (time: number) => {
          const minFrameDelta = isMobileDevice ? 40 : 16; // ~25fps on mobile, 60fps on desktop

          if (time - lastFrameTime < minFrameDelta) {
            if (!document.hidden && !reduceMotion) shaderFrame = requestAnimationFrame(draw);
            return;
          }
          lastFrameTime = time;

          gl.uniform2f(resolutionLocation, cachedWidth, cachedHeight);
          gl.uniform1f(timeLocation, time * 0.002);
          gl.uniform1f(grainLocation, 0.3);
          gl.uniform3f(backgroundLocation, ...brandBackground);
          gl.uniform3fv(colorsLocation, new Float32Array(brandColors));
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

          if (!document.hidden && !reduceMotion) shaderFrame = requestAnimationFrame(draw);
        };

        const startShader = () => {
          if (!shaderFrame && !reduceMotion) shaderFrame = requestAnimationFrame(draw);
        };

        const stopShader = () => {
          cancelAnimationFrame(shaderFrame);
          shaderFrame = 0;
        };

        window.addEventListener('resize', () => {
          resize();
          draw(0);
        }, { passive: true });

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopShader();
          else startShader();
        });

        // Pause shader when scrolled past hero cover to save 100% GPU/CPU on long page
        const heroSection = document.querySelector('.hero-cover');
        if (heroSection && 'IntersectionObserver' in window) {
          const heroObserver = new IntersectionObserver(
            ([entry]) => {
              if (entry.isIntersecting) {
                startShader();
              } else {
                stopShader();
              }
            },
            { threshold: 0.01 }
          );
          heroObserver.observe(heroSection);
        }

        resize();
        draw(0);

        if (!reduceMotion) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => startShader(), { timeout: 2000 });
          } else {
            setTimeout(startShader, 500);
          }
        }
      }
    }
  }
</script>

<style>
  .site-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: #fd4b32;
    pointer-events: none;
  }

  canvas {
    width: 100%;
    height: 100%;
  }
</style>
