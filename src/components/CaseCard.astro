---
interface Props {
  slug: string;
  title: string;
  year: string;
  summary: string;
  services: string[];
  cover: string;
  index: number;
}

const { slug, title, year, summary, services, cover, index } = Astro.props;
const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(cover);
const poster = isVideo
  ? cover.replace(/\.(mp4|webm)(?:\?.*)?$/i, '.webp')
  : cover;
---

<article class="case-card">
  <a href={`/case/${slug}`} aria-label={`${title} — смотреть кейс`}>
    <div class="case-media" data-parallax-media>
      <div class="case-parallax" data-parallax-target>
        <div class="case-image">
          {isVideo ? (
            <>
              <img
                src={poster}
                alt={`${title} — ${summary}`}
                width="800"
                height="800"
                loading={index < 2 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                class="case-poster"
              />
              <video
                data-lazy-video
                data-src={cover}
                poster={poster}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                class="case-video"
              >
                <track kind="captions" src="data:text/vtt,WEBVTT" label="Без звука" default />
              </video>
            </>
          ) : cover.startsWith('/') ? (
            <img
              src={cover}
              alt={`${title} — ${summary}`}
              width="800"
              height="800"
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <img
              src={cover}
              alt={`${title} — ${summary}`}
              width="800"
              height="800"
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          )}
        </div>
      </div>
      <span class="case-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="case-info">
      <div>
        <h3>{title}</h3>
        <p>{summary}</p>
      </div>
      <div class="case-meta">
        <span>{year}</span>
        <span>{services.join(' · ')}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .case-card {
    min-width: 0;
  }

  a {
    display: block;
    text-decoration: none;
  }

  .case-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--border-subtle);
  }

  @media (min-width: 40rem) {
    .case-media {
      aspect-ratio: 5 / 4;
    }
  }

  .case-parallax {
    position: absolute;
    inset: -14% 0;
    width: 100%;
    height: 128%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .case-image {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .case-image :global(img),
  .case-image img,
  .case-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .case-image video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease, transform 450ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .case-image video.is-playing {
    opacity: 1;
  }

  a:hover .case-image :global(img),
  a:hover .case-image img,
  a:hover .case-image video {
    transform: scale(1.025);
  }

  .case-arrow {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    color: white;
    background: var(--accent-deep);
    font-size: 1.35rem;
    transform: translateY(0.4rem);
    transition: transform 200ms ease;
  }

  a:hover .case-arrow {
    transform: translateY(0);
  }

  .case-info {
    display: grid;
    gap: 1rem;
    padding-block: 1.2rem 2.4rem;
  }

  h3 {
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p,
  .case-meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.3;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-parallax,
    .case-image :global(img),
    .case-image img,
    .case-image video,
    .case-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
