---
import { videoPoster } from '../lib/media';

interface Props {
  slug: string;
  title: string;
  year?: string;
  summary: string;
  tags?: string[];
  sector?: string;
  cover?: string;
  index: number;
  positionClass?: string;
  class?: string;
  lang?: 'ru' | 'en';
}

const {
  slug,
  title,
  year,
  summary,
  tags = [],
  sector,
  cover = '',
  index,
  positionClass = '',
  class: className = '',
  lang = 'ru',
} = Astro.props;

const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(cover);
const poster = isVideo ? videoPoster(cover) : cover;
const isEn = lang === 'en';
---

<article
  class:list={['project', positionClass, className]}
  data-project-card
  data-tags={tags.join('|')}
  data-sector={sector ?? ''}
  data-slug={slug}
>
  <a class="project__link" href={`/case/${slug}`} aria-label={`${title} — ${isEn ? 'view case' : 'смотреть кейс'}`}>
    <div class="project__media" data-parallax-media>
      <div class="project__parallax" data-parallax-target>
        <div class="project__image">
          {!cover ? (
            <div class="project__fallback" aria-hidden="true">{title}</div>
          ) : isVideo ? (
            <>
              <img
                src={poster}
                alt={`${title} — ${summary}`}
                width="1440"
                height="900"
                loading={index < 2 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                class="project__poster"
              />
              <video
                data-lazy-video
                data-src={cover}
                poster={poster}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                class="project__video"
              >
                <track kind="captions" src="data:text/vtt,WEBVTT" label={isEn ? 'No audio' : 'Без звука'} default />
              </video>
            </>
          ) : cover.startsWith('/') ? (
            <img
              src={cover}
              alt={`${title} — ${summary}`}
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <img
              src={cover}
              alt={`${title} — ${summary}`}
              width="1440"
              height="900"
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          )}
        </div>
      </div>

      {tags.length > 0 && (
        <div class="project__tags" aria-hidden="true">
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </div>

    <div class="project__info">
      <span class="project__marker" aria-hidden="true"></span>
      <div class="project__copy">
        <h3>{title}</h3>
        <p>{summary}</p>
      </div>
      <div class="project__action" aria-hidden="true">
        <span class="project__arrow">↗</span>
        <span>{isEn ? 'View project' : 'Смотреть проект'}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .project {
    min-width: 0;
    align-self: start;
    transition: filter 400ms ease, opacity 400ms ease, transform 400ms ease;
  }

  .project__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project__media {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #1d1d1f;
  }

  .project__parallax {
    position: absolute;
    inset: -14% 0;
    width: 100%;
    height: 128%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .project__image {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 800ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .project__image :global(img),
  .project__image img,
  .project__image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__image video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .project__image video.is-playing {
    opacity: 1;
  }

  .project__fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 2rem;
    background: var(--accent-deep, #FD4B32);
    color: white;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .project__link:hover .project__image,
  .project__link:focus-visible .project__image {
    transform: scale(1.055);
  }

  .project__tags {
    position: absolute;
    right: clamp(0.75rem, 1.4vw, 1.5rem);
    bottom: clamp(0.75rem, 1.4vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    z-index: 2;
  }

  .project__tags span {
    padding: 0.45rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 8%);
    color: #f2f2f2;
    background: rgb(0 0 0 / 48%);
    backdrop-filter: blur(10px);
    font-size: clamp(0.62rem, 0.75vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.035em;
    opacity: 0;
    text-transform: uppercase;
    transform: translateY(1rem);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .project__link:hover .project__tags span,
  .project__link:focus-visible .project__tags span {
    opacity: 1;
    transform: translateY(0);
  }

  .project__tags span:nth-child(2) {
    transition-delay: 50ms;
  }

  .project__tags span:nth-child(3) {
    transition-delay: 100ms;
  }

  .project__info {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem;
    padding-top: clamp(1rem, 1.6vw, 1.5rem);
  }

  .project__marker {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.65);
    transition: width 300ms ease, margin 300ms ease, opacity 250ms ease;
  }

  .project__copy h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: var(--card-title-size, clamp(1.5rem, 2.1vw, 2.25rem));
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
  }

  .project__copy p {
    max-width: 32rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1rem, 0.9vw, 1.05rem);
    line-height: 1.3;
  }

  .project__action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.2rem;
    overflow: hidden;
    font-size: clamp(0.65rem, 0.75vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0;
    text-transform: uppercase;
    transform: translateX(-0.75rem);
    transition: opacity 300ms ease, transform 350ms cubic-bezier(0.25, 1, 0.5, 1);
    white-space: nowrap;
    color: #fff;
  }

  .project__arrow {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    color: #0b0b0c;
    background: #f2f2f2;
    font-size: 0.85rem;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .project__link:hover .project__arrow,
  .project__link:focus-visible .project__arrow {
    background: var(--accent, #FD4B32);
    color: #fff;
  }

  .project__link:hover .project__marker,
  .project__link:focus-visible .project__marker {
    width: 0;
    margin-inline: -0.375rem 0;
    opacity: 0;
  }

  .project__link:hover .project__action,
  .project__link:focus-visible .project__action {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 47.99rem) {
    .project__tags,
    .project__action,
    .project__marker {
      display: none;
    }

    .project__info {
      display: block;
    }

    .project__copy h3 {
      font-size: 1.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project__parallax,
    .project__image,
    .project__tags span,
    .project__action,
    .project__marker {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
