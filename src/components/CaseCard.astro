---
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  title: string;
  year: string;
  summary: string;
  services: string[];
  cover: string;
  index: number;
}

const { slug, title, year, summary, services, cover, index } = Astro.props;
const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(cover);
---

<article class:list={['case-card', { 'case-card--wide': index % 7 === 2 }] }>
  <a href={`/case/${slug}`} aria-label={`${title}: открыть кейс`}>
    <div class="case-media">
      {isVideo ? (
        <video src={cover} muted loop playsinline autoplay preload="none" aria-hidden="true"></video>
      ) : (
        <Image
          src={cover}
          alt={`${title} — ${summary}`}
          inferSize
          widths={[400, 800]}
          sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1199px) 50vw, 33vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      )}
      <span class="case-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="case-info">
      <div>
        <h3>{title}</h3>
        <p>{summary}</p>
      </div>
      <div class="case-meta">
        <span>{year}</span>
        <span>{services.join(' · ')}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .case-card {
    min-width: 0;
  }

  a {
    display: block;
    text-decoration: none;
  }

  .case-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--border-subtle);
  }

  .case-media :global(img),
  .case-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  a:hover .case-media :global(img),
  a:hover .case-media video {
    transform: scale(1.025);
  }

  .case-arrow {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: var(--accent-deep);
    font-size: 1.35rem;
    transform: translateY(0.4rem);
    transition: transform 200ms ease;
  }

  a:hover .case-arrow {
    transform: translateY(0);
  }

  .case-info {
    display: grid;
    gap: 1rem;
    padding-block: 1.2rem 2.4rem;
  }

  h3 {
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  p,
  .case-meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  @media (min-width: 75rem) {
    .case-card--wide {
      grid-column: span 2;
    }

    .case-card--wide .case-media {
      aspect-ratio: 2 / 1;
    }
  }
</style>
