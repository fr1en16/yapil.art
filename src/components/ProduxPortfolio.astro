---
import { getCollection } from 'astro:content';

interface Props {
  theme?: 'dark' | 'light';
  projectSlugs?: string[];
  title?: string;
  seamless?: boolean;
}

const { theme = 'dark', projectSlugs, title, seamless = false } = Astro.props;
const isLight = theme === 'light';

const defaultSlugs = [
  'onmacabim',
  'compass',
  'yatut',
  'rv',
  'boya',
  'shanding',
  'bebble',
];
const targetSlugs = projectSlugs?.length ? projectSlugs : defaultSlugs;

const allCases = await getCollection('cases');
const caseMap = new Map(allCases.map((c) => [c.id, c]));

const projects = targetSlugs
  .map((slug) => caseMap.get(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const positions = [
  'project--lead',
  'project--side',
  'project--center',
  'project--small',
  'project--wide',
  'project--lead',
  'project--side',
];
---

<section class:list={['portfolio', { 'theme-light': isLight, 'is-seamless': seamless }]} id="cases" aria-labelledby="portfolio-title">
  <div class="portfolio__header container">
    <h2 id="portfolio-title">{title ?? <Fragment>Избранные<br />проекты</Fragment>}</h2>
  </div>

  <div class="portfolio__grid container">
    {projects.map((project, index) => {
      const isVideo = /\.(webm|mp4)(?:\?|$)/i.test(project.data.cover);
      const poster = isVideo
        ? project.data.cover.replace(/\.(mp4|webm)(?:\?.*)?$/i, '.webp')
        : project.data.cover;

      return (
        <article class:list={['project', positions[index]]} data-slug={project.id}>
          <a class="project__link" href={`/case/${project.id}`}>
            <div class="project__media" data-parallax-media>
              <div class="project__parallax" data-parallax-target>
                <div class="project__image">
                  {isVideo ? (
                    <>
                      <img
                        src={poster}
                        alt={`${project.data.title} — ${project.data.summary}`}
                        loading="lazy"
                        decoding="async"
                        class="project__poster"
                      />
                      <video
                        data-lazy-video
                        data-src={project.data.cover}
                        poster={poster}
                        muted
                        loop
                        playsinline
                        preload="none"
                        aria-hidden="true"
                        class="project__video"
                      >
                        <track kind="captions" src="data:text/vtt,WEBVTT" label="Без звука" default />
                      </video>
                    </>
                  ) : project.data.cover.startsWith('/') ? (
                    <img
                      src={project.data.cover}
                      alt={`${project.data.title} — ${project.data.summary}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <img
                      src={project.data.cover}
                      alt={`${project.data.title} — ${project.data.summary}`}
                      width="1440"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </div>

              <div class="project__tags" aria-hidden="true">
                {project.data.services.map((service) => <span>{service}</span>)}
              </div>
            </div>

            <div class="project__info">
              <span class="project__marker" aria-hidden="true"></span>
              <div class="project__copy">
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
              </div>
              <div class="project__action" aria-hidden="true">
                <span class="project__arrow">↗</span>
                <span>Смотреть проект</span>
              </div>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</section>

<style>
  .portfolio {
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 10rem);
    color: #f2f2f2;
    background: linear-gradient(to bottom, #0b0b0c 0%, #0b0b0c 15%, rgba(11, 11, 12, 0.55) 45%, transparent 85%);
  }

  .portfolio.theme-light {
    color: #1D1D1D;
    background: linear-gradient(to bottom, #EAE5DF 0%, #EAE5DF 15%, rgba(234, 229, 223, 0.55) 45%, transparent 85%);
  }

  .portfolio.theme-light.is-seamless {
    background: #f5f1e9;
  }

  .portfolio.theme-light h2 {
    color: #1D1D1D;
  }

  .portfolio.theme-light .project__media {
    background: #D8D2CA;
  }

  .portfolio.theme-light .project__tags span {
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #1D1D1D;
    background: rgba(255, 255, 255, 0.88);
  }

  .portfolio.theme-light .project__marker {
    border: 1px solid rgba(29, 29, 29, 0.45);
  }

  .portfolio.theme-light .project__copy h3 {
    color: #1D1D1D;
  }

  .portfolio.theme-light .project__copy p {
    color: rgba(29, 29, 29, 0.78);
  }

  .portfolio.theme-light .project__action {
    color: #1D1D1D;
  }

  .portfolio.theme-light .project__arrow {
    color: #FFFFFF;
    background: #1D1D1D;
  }

  .portfolio.theme-light .project__link:hover .project__arrow,
  .portfolio.theme-light .project__link:focus-visible .project__arrow {
    background: #FD4B32;
  }

  .portfolio.theme-light .portfolio__grid:has(.project:hover) .project:not(:hover) {
    filter: blur(3px);
    opacity: 0.45;
    transform: scale(0.985);
  }

  .portfolio__header {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(4rem, 11vw, 9rem) var(--grid-gap, clamp(0.5rem, 0.75vw, 0.75rem));
  }

  .project {
    min-width: 0;
    align-self: start;
    transition: filter 400ms ease, opacity 400ms ease, transform 400ms ease;
  }

  .project--lead {
    grid-column: 1 / span 7;
  }

  .project--side {
    grid-column: 9 / span 4;
    align-self: end;
  }

  .project--center {
    grid-column: 2 / span 10;
  }

  .project--small {
    grid-column: 1 / span 4;
  }

  .project--wide {
    grid-column: 6 / span 7;
  }

  .project__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project__media {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #1d1d1f;
  }

  .project__parallax {
    position: absolute;
    inset: -14% 0;
    width: 100%;
    height: 128%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .project__image {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 800ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .project__image :global(img),
  .project__image img,
  .project__image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__image video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .project__image video.is-playing {
    opacity: 1;
  }

  .project__link:hover .project__image,
  .project__link:focus-visible .project__image {
    transform: scale(1.055);
  }

  .project__tags {
    position: absolute;
    right: clamp(0.75rem, 1.4vw, 1.5rem);
    bottom: clamp(0.75rem, 1.4vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .project__tags span {
    padding: 0.45rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 8%);
    color: #f2f2f2;
    background: rgb(0 0 0 / 48%);
    backdrop-filter: blur(10px);
    font-size: clamp(0.62rem, 0.75vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.035em;
    opacity: 0;
    text-transform: uppercase;
    transform: translateY(1rem);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .project__link:hover .project__tags span,
  .project__link:focus-visible .project__tags span {
    opacity: 1;
    transform: translateY(0);
  }

  .project__tags span:nth-child(2) {
    transition-delay: 50ms;
  }

  .project__tags span:nth-child(3) {
    transition-delay: 100ms;
  }

  .project__info {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem;
    padding-top: clamp(1rem, 1.6vw, 1.5rem);
  }

  .project__marker {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.65);
    transition: width 300ms ease, margin 300ms ease, opacity 250ms ease;
  }

  .project__copy h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.1vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .project__copy p {
    max-width: 32rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1rem, 0.9vw, 1.05rem);
    line-height: 1.3;
  }

  .project__action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.2rem;
    overflow: hidden;
    font-size: clamp(0.65rem, 0.75vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0;
    text-transform: uppercase;
    transform: translateX(-0.75rem);
    transition: opacity 300ms ease, transform 350ms cubic-bezier(0.25, 1, 0.5, 1);
    white-space: nowrap;
  }

  .project__arrow {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    color: #0b0b0c;
    background: #f2f2f2;
    font-size: 0.85rem;
  }

  .project__link:hover .project__marker,
  .project__link:focus-visible .project__marker {
    width: 0;
    margin-inline: -0.375rem 0;
    opacity: 0;
  }

  .project__link:hover .project__action,
  .project__link:focus-visible .project__action {
    opacity: 1;
    transform: translateX(0);
  }

  .portfolio__grid:has(.project:hover) .project:not(:hover) {
    filter: blur(4px);
    opacity: 0.35;
    transform: scale(0.985);
  }

  @media (max-width: 63.99rem) {
    .portfolio__grid {
      gap-block: clamp(4rem, 9vw, 6rem);
    }

    .project--lead,
    .project--side,
    .project--center,
    .project--small,
    .project--wide {
      grid-column: 1 / -1;
    }

    .project--side,
    .project--small {
      width: 60%;
    }

    .project--side {
      justify-self: end;
    }

    .project__media {
      height: auto;
      aspect-ratio: 5 / 4;
    }
  }

  @media (max-width: 47.99rem) {
    .portfolio {
      padding-block: 4.5rem 6rem;
    }

    .portfolio__header {
      align-items: flex-end;
      margin-bottom: 3.5rem;
    }

    h2 {
      font-size: clamp(2.6rem, 14vw, 4.2rem);
    }

    .portfolio__grid {
      display: flex;
      flex-direction: column;
      gap: 3.5rem;
    }

    .project {
      min-width: 0;
    }

    /* Крупные карточки (90%) */
    .project--lead,
    .project--center,
    .project--wide {
      width: 90%;
      max-width: 90%;
    }

    /* Мелкие карточки (60%) */
    .project--side,
    .project--small {
      width: 60%;
      max-width: 60%;
    }

    /* Позиционирование и смещение карточек */
    .project--lead {
      align-self: flex-start;
      margin-inline: 0 auto;
    }

    .project--side {
      align-self: flex-end;
      margin-inline: auto 0;
    }

    .project--center {
      align-self: center;
      margin-inline: auto;
    }

    .project--small {
      align-self: flex-start;
      margin-inline: 0 auto;
    }

    .project--wide {
      align-self: flex-end;
      margin-inline: auto 0;
    }

    .project__media {
      aspect-ratio: 5 / 4;
    }

    .project__tags,
    .project__action,
    .project__marker {
      display: none;
    }

    .project__info {
      display: block;
    }

    .project__copy h3 {
      font-size: 1.65rem;
    }

    .portfolio__grid:has(.project:hover) .project:not(:hover) {
      filter: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project__parallax,
    .project__image,
    .project__tags span,
    .project__action,
    .project__marker {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
