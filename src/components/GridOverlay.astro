---
// Interactive Dev Grid Overlay for Yapil
if (!import.meta.env.DEV) {
  return;
}
---

<div id="yapil-grid-overlay" class="grid-overlay" aria-hidden="true">
  <!-- Container boundary guides -->
  <div class="grid-overlay-margins"></div>

  <!-- Main 12-Column Grid inside Container -->
  <div class="grid-overlay-container">
    <div class="grid-columns">
      {Array.from({ length: 12 }).map((_, i) => (
        <div class="grid-col" data-col={i + 1}>
          <span class="col-num top">{i + 1}</span>
          <span class="col-num bottom">{i + 1}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Horizontal baseline grid (optional layer) -->
  <div class="grid-baseline" id="grid-baseline-layer"></div>

  <!-- Center axis line -->
  <div class="grid-center-axis"></div>
</div>

<!-- Text Typography Inspector (Hover Layer) -->
<div id="yapil-typo-inspector" class="grid-typo-inspector" aria-hidden="true">
  <div class="grid-typo-box" id="grid-typo-box"></div>
  <div class="grid-typo-badge" id="grid-typo-badge">
    <span class="typo-tag" id="grid-typo-tag">H1</span>
    <span class="typo-size" id="grid-typo-size">32px</span>
    <span class="typo-slash">/</span>
    <span class="typo-lh" id="grid-typo-lh">40px</span>
    <span class="typo-ratio" id="grid-typo-ratio">1.25×</span>
  </div>
</div>

<!-- Floating HUD Toolbar -->
<div class="grid-hud" id="yapil-grid-hud">
  <!-- Minimized trigger button -->
  <button
    type="button"
    class="grid-hud-toggle"
    id="grid-hud-toggle-btn"
    title="Показать/скрыть сетку (Горячая клавиша: G)"
    aria-label="Сетка: переключить оверлей"
  >
    <svg class="grid-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="0"></rect>
      <line x1="9" y1="3" x2="9" y2="21"></line>
      <line x1="15" y1="3" x2="15" y2="21"></line>
      <line x1="3" y1="9" x2="21" y2="9"></line>
      <line x1="3" y1="15" x2="21" y2="15"></line>
    </svg>
    <span class="hud-label">Сетка</span>
    <span class="hud-indicator" id="hud-status-dot"></span>
  </button>

  <!-- Expanded Controls Panel -->
  <div class="grid-hud-panel" id="grid-hud-panel">
    <div class="hud-header">
      <div class="hud-title-group">
        <strong class="hud-title">Сетка и Направляющие</strong>
        <span class="hud-badge" id="hud-breakpoint-tag">Desktop</span>
      </div>
      <button type="button" class="hud-close-btn" id="hud-close-panel-btn" title="Свернуть панель" aria-label="Свернуть">
        ×
      </button>
    </div>

    <div class="hud-stats">
      <div class="stat-item">
        <span class="stat-label">Вьюпорт</span>
        <span class="stat-value" id="hud-viewport-size">1440 × 900</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Контейнер</span>
        <span class="stat-value" id="hud-container-size">max 88rem (1408px)</span>
      </div>
    </div>

    <div class="hud-toggles">
      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-columns" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">12 Колонок</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-container-outline" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">Границы контейнера</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-baseline" />
        <span class="custom-check"></span>
        <span class="toggle-text">Базовая сетка (24px)</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-center-axis" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">Центральная ось</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-typography" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">Размеры текста (hover)</span>
      </label>
    </div>

    <div class="hud-opacity">
      <div class="opacity-header">
        <span>Прозрачность</span>
        <span id="opacity-val-label">50%</span>
      </div>
      <input type="range" id="grid-opacity-range" min="10" max="100" value="50" step="5" />
    </div>

    <div class="hud-footer">
      <span class="hud-hint">Клавиша <kbd>G</kbd> — вкл/выкл сетку</span>
    </div>
  </div>
</div>

<script>
  let isWindowBound = false;
  let currentTarget: HTMLElement | null = null;
  let pendingEvent: PointerEvent | null = null;
  let moveRafId: number | null = null;
  let scrollRafId: number | null = null;

  let isInspectorActive = () => false;
  let updatePosition = (_target: HTMLElement) => {};
  let hideHighlighter = () => {};

  function formatPx(val: number): string {
    const rounded = Math.round(val * 10) / 10;
    return Number.isInteger(rounded) ? `${rounded}px` : `${rounded.toFixed(1)}px`;
  }

  function getLineHeight(style: CSSStyleDeclaration, fontPx: number): { text: string; ratio: string } {
    const lhStr = style.lineHeight;

    if (!lhStr || lhStr === 'normal') {
      const approx = Math.round(fontPx * 1.2 * 10) / 10;
      return {
        text: formatPx(approx),
        ratio: '1.2',
      };
    }

    const parsed = parseFloat(lhStr);
    if (isNaN(parsed) || parsed <= 0) {
      const approx = Math.round(fontPx * 1.2 * 10) / 10;
      return {
        text: formatPx(approx),
        ratio: '1.2',
      };
    }

    if (lhStr.endsWith('px')) {
      const ratioVal = fontPx > 0 ? (parsed / fontPx).toFixed(2).replace(/\.?0+$/, '') : '1';
      return {
        text: formatPx(parsed),
        ratio: ratioVal || '1',
      };
    }

    const computedPx = parsed * fontPx;
    const ratioVal = parsed.toFixed(2).replace(/\.?0+$/, '');
    return {
      text: formatPx(computedPx),
      ratio: ratioVal || '1',
    };
  }

  function getTextTarget(el: HTMLElement | null): HTMLElement | null {
    if (!el || !(el instanceof HTMLElement)) return null;
    if (el.closest('#yapil-grid-hud') || el.closest('#yapil-grid-overlay') || el.closest('#yapil-typo-inspector')) {
      return null;
    }

    const IGNORE_TAGS = new Set([
      'HTML', 'BODY', 'SVG', 'PATH', 'CIRCLE', 'RECT', 'POLYGON', 'LINE', 'G',
      'IMG', 'VIDEO', 'CANVAS', 'IFRAME', 'SCRIPT', 'STYLE',
      'INPUT', 'TEXTAREA', 'SELECT', 'OPTION'
    ]);
    if (IGNORE_TAGS.has(el.tagName)) return null;

    // Heading elements (h1-h6)
    const heading = el.closest('h1, h2, h3, h4, h5, h6') as HTMLElement | null;
    if (heading) {
      if (el === heading) return heading;
      const headingStyle = window.getComputedStyle(heading);
      const elStyle = window.getComputedStyle(el);
      if (headingStyle.fontSize !== elStyle.fontSize) {
        return el;
      }
      return heading;
    }

    const text = (el.textContent || '').trim();
    if (!text) return null;

    const hasDirectText = Array.from(el.childNodes).some(
      (n) => n.nodeType === Node.TEXT_NODE && Boolean(n.textContent?.trim())
    );

    const blockQuoteOrP = el.closest('p, blockquote, figcaption') as HTMLElement | null;
    if (blockQuoteOrP && blockQuoteOrP !== el) {
      const pStyle = window.getComputedStyle(blockQuoteOrP);
      const elStyle = window.getComputedStyle(el);
      if (el.tagName === 'A' || el.tagName === 'CODE' || pStyle.fontSize !== elStyle.fontSize) {
        return el;
      }
      return blockQuoteOrP;
    }

    if (hasDirectText) {
      return el;
    }

    const hasBlockChildren = Array.from(el.children).some((c) =>
      ['DIV', 'SECTION', 'ARTICLE', 'MAIN', 'NAV', 'HEADER', 'FOOTER', 'UL', 'OL', 'P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6'].includes(c.tagName)
    );

    if (!hasBlockChildren) {
      return el;
    }

    return null;
  }

  function initGridOverlay() {
    const overlay = document.getElementById('yapil-grid-overlay');
    const hud = document.getElementById('yapil-grid-hud');
    const toggleBtn = document.getElementById('grid-hud-toggle-btn');
    const closePanelBtn = document.getElementById('hud-close-panel-btn');
    const statusDot = document.getElementById('hud-status-dot');
    const viewportSizeEl = document.getElementById('hud-viewport-size');
    const breakpointTagEl = document.getElementById('hud-breakpoint-tag');
    const containerSizeEl = document.getElementById('hud-container-size');

    const typoInspector = document.getElementById('yapil-typo-inspector');
    const typoBox = document.getElementById('grid-typo-box');
    const typoBadge = document.getElementById('grid-typo-badge');
    const typoTag = document.getElementById('grid-typo-tag');
    const typoSize = document.getElementById('grid-typo-size');
    const typoLh = document.getElementById('grid-typo-lh');
    const typoRatio = document.getElementById('grid-typo-ratio');

    const toggleCols = document.getElementById('toggle-columns') as HTMLInputElement | null;
    const toggleOutline = document.getElementById('toggle-container-outline') as HTMLInputElement | null;
    const toggleBaseline = document.getElementById('toggle-baseline') as HTMLInputElement | null;
    const toggleAxis = document.getElementById('toggle-center-axis') as HTMLInputElement | null;
    const toggleTypo = document.getElementById('toggle-typography') as HTMLInputElement | null;
    const opacityRange = document.getElementById('grid-opacity-range') as HTMLInputElement | null;
    const opacityLabel = document.getElementById('opacity-val-label');

    if (!overlay || !hud || !toggleBtn) return;

    // Load saved settings
    const STORAGE_KEY = 'yapil_grid_settings';
    let settings = {
      visible: false,
      panelOpen: false,
      columns: true,
      outline: true,
      baseline: false,
      axis: true,
      typography: true,
      opacity: 50,
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        settings = { ...settings, ...JSON.parse(saved) };
      }
      if (typeof settings.typography !== 'boolean') {
        settings.typography = true;
      }
    } catch (e) {
      // ignore JSON parse error
    }

    function saveSettings() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
      } catch (e) {}
    }

    function hideHighlighterImpl() {
      currentTarget = null;
      if (typoBox) typoBox.style.display = 'none';
      if (typoBadge) typoBadge.style.display = 'none';
    }
    hideHighlighter = hideHighlighterImpl;

    function updatePositionImpl(target: HTMLElement) {
      if (!typoInspector || !typoBox || !typoBadge || !typoTag || !typoSize || !typoLh || !typoRatio) return;

      const rect = target.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) {
        hideHighlighterImpl();
        return;
      }

      if (rect.bottom < 0 || rect.top > window.innerHeight || rect.right < 0 || rect.left > window.innerWidth) {
        hideHighlighterImpl();
        return;
      }

      const style = window.getComputedStyle(target);
      const fontPx = parseFloat(style.fontSize) || 16;
      const lhData = getLineHeight(style, fontPx);

      const tagName = target.tagName.toLowerCase();
      typoTag.textContent = tagName;
      typoSize.textContent = formatPx(fontPx);
      typoLh.textContent = lhData.text;
      typoRatio.textContent = `${lhData.ratio}×`;

      typoBox.style.display = 'block';
      typoBadge.style.display = 'inline-flex';

      const pad = 2;
      const boxTop = Math.max(0, rect.top - pad);
      const boxLeft = Math.max(0, rect.left - pad);
      const boxWidth = rect.width + pad * 2;
      const boxHeight = rect.height + pad * 2;

      typoBox.style.top = `${Math.round(boxTop)}px`;
      typoBox.style.left = `${Math.round(boxLeft)}px`;
      typoBox.style.width = `${Math.round(boxWidth)}px`;
      typoBox.style.height = `${Math.round(boxHeight)}px`;

      const badgeWidth = typoBadge.offsetWidth || 150;
      const badgeHeight = typoBadge.offsetHeight || 22;
      const margin = 6;

      let bTop = rect.top - badgeHeight - 4;
      if (bTop < margin) {
        bTop = rect.bottom + 4;
        if (bTop + badgeHeight > window.innerHeight - margin) {
          bTop = Math.max(margin, rect.top + 4);
        }
      }

      let bLeft = rect.left;
      const maxLeft = window.innerWidth - badgeWidth - margin;
      if (bLeft > maxLeft) {
        bLeft = maxLeft;
      }
      if (bLeft < margin) {
        bLeft = margin;
      }

      typoBadge.style.top = `${Math.round(bTop)}px`;
      typoBadge.style.left = `${Math.round(bLeft)}px`;
    }
    updatePosition = updatePositionImpl;

    isInspectorActive = () => Boolean(settings.visible && settings.typography);

    function applyState() {
      overlay?.classList.toggle('is-active', settings.visible);
      statusDot?.classList.toggle('is-active', settings.visible);
      hud?.classList.toggle('is-panel-open', settings.panelOpen);

      overlay?.classList.toggle('hide-columns', !settings.columns);
      overlay?.classList.toggle('hide-outline', !settings.outline);
      overlay?.classList.toggle('show-baseline', settings.baseline);
      overlay?.classList.toggle('hide-axis', !settings.axis);

      const typoActive = settings.visible && settings.typography;
      typoInspector?.classList.toggle('is-active', typoActive);
      if (!typoActive) {
        hideHighlighterImpl();
      }

      overlay?.style.setProperty('--grid-opacity', (settings.opacity / 100).toString());

      if (toggleCols) toggleCols.checked = settings.columns;
      if (toggleOutline) toggleOutline.checked = settings.outline;
      if (toggleBaseline) toggleBaseline.checked = settings.baseline;
      if (toggleAxis) toggleAxis.checked = settings.axis;
      if (toggleTypo) toggleTypo.checked = settings.typography;
      if (opacityRange) opacityRange.value = settings.opacity.toString();
      if (opacityLabel) opacityLabel.textContent = `${settings.opacity}%`;
    }

    function updateViewportInfo() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (viewportSizeEl) {
        viewportSizeEl.textContent = `${w}px × ${h}px (${(w / 16).toFixed(1)}rem)`;
      }

      if (breakpointTagEl) {
        if (w >= 1200) {
          breakpointTagEl.textContent = 'Desktop (≥75rem)';
          breakpointTagEl.className = 'hud-badge is-desktop';
        } else if (w >= 768) {
          breakpointTagEl.textContent = 'Tablet (≥48rem)';
          breakpointTagEl.className = 'hud-badge is-tablet';
        } else {
          breakpointTagEl.textContent = 'Mobile (<48rem)';
          breakpointTagEl.className = 'hud-badge is-mobile';
        }
      }

      if (containerSizeEl) {
        const sideSpace = w >= 768 ? 64 : 32;
        const containerWidth = Math.min(w - sideSpace, 1408);
        containerSizeEl.textContent = `${containerWidth}px (поля: ${sideSpace / 2}px)`;
      }
    }

    // Toggle overlay visibility
    function toggleGridVisibility() {
      settings.visible = !settings.visible;
      // If opening for first time, open panel as well
      if (settings.visible && !settings.panelOpen) {
        settings.panelOpen = true;
      }
      applyState();
      saveSettings();
    }

    toggleBtn.addEventListener('click', () => {
      if (!settings.visible) {
        settings.visible = true;
        settings.panelOpen = true;
      } else {
        settings.panelOpen = !settings.panelOpen;
      }
      applyState();
      saveSettings();
    });

    closePanelBtn?.addEventListener('click', () => {
      settings.panelOpen = false;
      applyState();
      saveSettings();
    });

    // Sub-toggles
    toggleCols?.addEventListener('change', () => {
      settings.columns = toggleCols.checked;
      applyState();
      saveSettings();
    });

    toggleOutline?.addEventListener('change', () => {
      settings.outline = toggleOutline.checked;
      applyState();
      saveSettings();
    });

    toggleBaseline?.addEventListener('change', () => {
      settings.baseline = toggleBaseline.checked;
      applyState();
      saveSettings();
    });

    toggleAxis?.addEventListener('change', () => {
      settings.axis = toggleAxis.checked;
      applyState();
      saveSettings();
    });

    toggleTypo?.addEventListener('change', () => {
      settings.typography = Boolean(toggleTypo.checked);
      applyState();
      saveSettings();
    });

    opacityRange?.addEventListener('input', () => {
      settings.opacity = Number(opacityRange.value);
      applyState();
      saveSettings();
    });

    function processPointerMove() {
      moveRafId = null;
      if (!pendingEvent || !isInspectorActive()) return;

      const target = getTextTarget(pendingEvent.target as HTMLElement | null);
      if (!target) {
        hideHighlighter();
        return;
      }

      currentTarget = target;
      updatePosition(target);
    }

    if (!isWindowBound) {
      window.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement;
        if (
          target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.tagName === 'SELECT' ||
          target.isContentEditable
        ) {
          return;
        }

        if (e.key === 'g' || e.key === 'G' || e.key === 'п' || e.key === 'П') {
          if (!e.ctrlKey && !e.metaKey && !e.altKey) {
            e.preventDefault();
            toggleGridVisibility();
          }
        }
      });

      window.addEventListener('resize', () => {
        updateViewportInfo();
        if (currentTarget && document.body.contains(currentTarget)) {
          updatePosition(currentTarget);
        }
      });

      window.addEventListener(
        'pointermove',
        (e) => {
          if (!isInspectorActive()) return;
          pendingEvent = e;
          if (moveRafId === null) {
            moveRafId = requestAnimationFrame(processPointerMove);
          }
        },
        { passive: true }
      );

      window.addEventListener(
        'scroll',
        () => {
          if (!isInspectorActive() || !currentTarget) return;
          if (scrollRafId === null) {
            scrollRafId = requestAnimationFrame(() => {
              scrollRafId = null;
              if (currentTarget && document.body.contains(currentTarget)) {
                updatePosition(currentTarget);
              } else {
                hideHighlighter();
              }
            });
          }
        },
        { passive: true }
      );

      document.addEventListener('mouseleave', () => {
        hideHighlighter();
      });

      isWindowBound = true;
    }

    updateViewportInfo();
    applyState();
  }

  if (import.meta.env.DEV) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGridOverlay);
    } else {
      initGridOverlay();
    }
    document.addEventListener('astro:page-load', initGridOverlay);
  }
</script>

<style>
  :root {
    --grid-guide-color: #fd4b32;
    --grid-guide-col-bg: rgba(253, 75, 50, 0.09);
    --grid-guide-border: rgba(253, 75, 50, 0.28);
    --grid-guide-outline: rgba(253, 75, 50, 0.45);
    --grid-opacity: 0.5;
  }

  /* ---------------- Typography Inspector (Hover) ---------------- */
  .grid-typo-inspector {
    position: fixed;
    inset: 0;
    z-index: 10001;
    pointer-events: none;
    display: none;
  }

  .grid-typo-inspector.is-active {
    display: block;
  }

  .grid-typo-box {
    position: fixed;
    pointer-events: none;
    display: none;
    border: 1px dashed rgba(253, 75, 50, 0.75);
    background: rgba(253, 75, 50, 0.04);
    border-radius: 2px;
    box-sizing: border-box;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    z-index: 10001;
  }

  .grid-typo-badge {
    position: fixed;
    pointer-events: none;
    display: none;
    align-items: center;
    gap: 4.5px;
    padding: 3px 6px;
    background: rgba(18, 18, 20, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    color: #f2f2f2;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 11px;
    line-height: 1.15;
    white-space: nowrap;
    z-index: 10002;
    user-select: none;
  }

  .grid-typo-badge .typo-tag {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1.5px 4px;
    background: rgba(253, 75, 50, 0.2);
    color: #ff6b57;
    border: 1px solid rgba(253, 75, 50, 0.35);
    border-radius: 2px;
    line-height: 1;
  }

  .grid-typo-badge .typo-size {
    color: #ffffff;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .grid-typo-badge .typo-slash {
    color: rgba(255, 255, 255, 0.35);
    font-size: 10px;
    font-weight: 400;
    margin-inline: 0.5px;
  }

  .grid-typo-badge .typo-lh {
    color: #d4d4d8;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .grid-typo-badge .typo-ratio {
    color: #a1a1aa;
    font-size: 9.5px;
    font-weight: 400;
    padding-left: 1px;
  }

  /* ---------------- Grid Overlay (Fixed) ---------------- */
  .grid-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: none;
    opacity: var(--grid-opacity);
    transition: opacity 0.15s ease;
  }

  .grid-overlay.is-active {
    display: block;
  }

  /* Side safety margin guides */
  .grid-overlay-margins {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .grid-overlay.hide-outline .grid-overlay-margins,
  .grid-overlay.hide-outline .grid-overlay-container {
    border-color: transparent !important;
  }

  /* Main Container Box */
  .grid-overlay-container {
    width: min(calc(100% - var(--container-inline-space)), var(--container-max));
    height: 100%;
    margin-inline: auto;
    border-left: 1px dashed var(--grid-guide-outline);
    border-right: 1px dashed var(--grid-guide-outline);
    position: relative;
    box-sizing: border-box;
  }

  /* 12-Column Grid */
  .grid-columns {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap, clamp(0.5rem, 0.75vw, 0.75rem));
    height: 100%;
    box-sizing: border-box;
  }

  .grid-overlay.hide-columns .grid-columns {
    display: none;
  }

  .grid-col {
    position: relative;
    height: 100%;
    background: var(--grid-guide-col-bg);
    border-left: 1px solid var(--grid-guide-border);
    border-right: 1px solid var(--grid-guide-border);
    box-sizing: border-box;
  }

  .col-num {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
