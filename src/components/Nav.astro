---
import PrimaryMenu from './ui/PrimaryMenu';

interface Props {
  overlay?: boolean;
  theme?: 'dark' | 'light';
  minimal?: boolean;
}

const { overlay = false, theme = 'dark', minimal = false } = Astro.props;
const homePath = '/';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pagesWithoutContacts = [
  '/404',
  '/privacy',
  '/site-map',
  '/crm',
  '/cv',
  '/anal',
];
const isBrief = pathname.startsWith('/brief');
const isProposal = pathname.startsWith('/kp/');
const hasNoLocalContacts = pagesWithoutContacts.includes(pathname) || isBrief || isProposal;
const contactsHref = hasNoLocalContacts ? `${homePath}#contacts` : '#contacts';
---

<header class:list={['site-header', { overlay, minimal, 'theme-light': theme === 'light' }]} data-site-header data-theme={theme}>
  <div class="container nav-row" data-nav-row>
    {!minimal && (
      <a class="brand" href={homePath} aria-label="Yapil.art — на главную" data-nav-brand>
        <span class="brand-text">Yapil.art</span>
      </a>
    )}
    <PrimaryMenu contactsHref={contactsHref} client:load />
  </div>
</header>

<script>
  function initHeaderAndNav() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;

    let ticking = false;
    let lastScrollY = typeof window !== 'undefined' ? window.scrollY : 0;
    let accumulatedUp = 0;
    let accumulatedDown = 0;
    const SCROLL_UP_THRESHOLD = 30; // 30px upward scroll to reveal
    const SCROLL_DOWN_THRESHOLD = 10; // 10px downward scroll to hide
    const TOP_THRESHOLD = 80; // Always visible when near top

    function update() {
      const currentScrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const maxScroll = Math.max(0, docHeight - winHeight);

      // Clamp scroll position to handle Mac rubber-band bounce safely
      const clampedScrollY = Math.max(0, Math.min(currentScrollY, maxScroll));
      const delta = clampedScrollY - lastScrollY;

      // Header top style: toggle at-top vs is-scrolled (threshold: 500px)
      if (clampedScrollY <= 500) {
        header!.classList.add('at-top');
        header!.classList.remove('is-scrolled');
      } else {
        header!.classList.remove('at-top');
        header!.classList.add('is-scrolled');
      }

      // Hide on scroll down, reveal on 30px scroll up
      if (clampedScrollY <= TOP_THRESHOLD) {
        // At the very top: always visible
        header!.classList.remove('is-hidden');
        accumulatedUp = 0;
        accumulatedDown = 0;
      } else {
        if (delta > 0) {
          // Scrolling down
          accumulatedUp = 0;
          accumulatedDown += delta;
          if (accumulatedDown >= SCROLL_DOWN_THRESHOLD) {
            header!.classList.add('is-hidden');
          }
        } else if (delta < 0) {
          // Scrolling up
          accumulatedDown = 0;
          accumulatedUp += Math.abs(delta);
          if (accumulatedUp >= SCROLL_UP_THRESHOLD) {
            header!.classList.remove('is-hidden');
          }
        }
      }

      lastScrollY = clampedScrollY;

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    // Initial update
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAndNav);
  } else {
    initHeaderAndNav();
  }

  // Support Astro view transitions / page swaps if present
  document.addEventListener('astro:page-load', initHeaderAndNav);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    padding-block: 1.1rem;
    color: #fff;
    overflow: visible;
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 2000ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 2000ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Keep navigation fixed; only the brand hides while scrolling down. */
  .site-header.is-hidden {
    transform: translateY(0);
    opacity: 1;
  }

  .site-header.is-hidden .brand {
    transform: translateY(-1rem);
    opacity: 0;
    pointer-events: none;
  }

  /* The compact action bar provides its own contrast; no full-width header backdrop. */
  .site-header::before {
    content: none;
  }

  .site-header.theme-light.is-scrolled {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled .brand,
  .site-header.theme-light.is-scrolled .brand-text {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled nav a {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled nav a:hover {
    color: var(--accent, #FD4B32);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
  }

  .site-header.minimal .nav-row {
    justify-content: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    z-index: 60;
    color: #fff;
    transition:
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .brand-text {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    transition: color 0.2s ease;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.75rem, 2.5vw, 2.25rem);
    transition: opacity 0.25s ease;
    position: relative;
  }

  nav a {
    position: relative;
    font-size: clamp(0.75rem, 1.6vw, 0.95rem);
    text-decoration: none;
    color: #fff;
    padding-block: 0.35rem;
    padding-inline: 0.15rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
    transition:
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Micro-interaction: Soft dimming of sibling menu items on hover */
  nav:hover a {
    opacity: 0.45;
  }

  nav a:hover {
    opacity: 1 !important;
    color: #82f2c9;
    transform: translateY(-1px);
  }

  .site-header.theme-light nav:hover a {
    opacity: 0.4;
  }

  .site-header.theme-light nav a:hover {
    opacity: 1 !important;
    color: var(--accent, #FD4B32);
  }

  .site-header.theme-light.at-top nav a:hover {
    color: #FFDBD7;
  }

  /* Micro-interaction: Neat dot indicator under active section */
  .nav-dot {
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%) scale(0);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #82f2c9;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 6px rgba(130, 242, 201, 0.6);
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1.2),
      opacity 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  nav a.is-active .nav-dot {
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }

  .site-header.theme-light nav a.is-active .nav-dot {
    background-color: var(--accent, #FD4B32);
    box-shadow: 0 0 6px rgba(253, 75, 50, 0.5);
  }

  .site-header.theme-light.at-top nav a.is-active .nav-dot {
    background-color: #FFDBD7;
    box-shadow: 0 0 6px rgba(255, 219, 215, 0.6);
  }

  @media (max-width: 40rem) {
    nav a[data-nav-link="services"] {
      display: none;
    }
  }

  @media (max-width: 28rem) {
    nav a[data-nav-link="reviews"] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand,
    nav,
    nav a,
    .nav-dot {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
