---
interface Props {
  overlay?: boolean;
  theme?: 'dark' | 'light';
}

const { overlay = false, theme = 'dark' } = Astro.props;
const homePath = theme === 'light' ? '/light' : '/';
---

<header class:list={['site-header', { overlay, 'theme-light': theme === 'light' }]} data-site-header data-theme={theme}>
  <div class="container nav-row" data-nav-row>
    <a class="brand" href={homePath} aria-label="Yapil.art — на главную" data-nav-brand>
      <span class="brand-text">Yapil.art</span>
    </a>
    <nav aria-label="Основная навигация" data-nav-links>
      <a href={`${homePath}#services`} data-nav-link="services">
        <span>Услуги</span>
        <span class="nav-dot" aria-hidden="true"></span>
      </a>
      <a href={`${homePath}#cases`} data-nav-link="cases">
        <span>Кейсы</span>
        <span class="nav-dot" aria-hidden="true"></span>
      </a>
      <a href={`${homePath}#reviews`} data-nav-link="reviews">
        <span>Отзывы</span>
        <span class="nav-dot" aria-hidden="true"></span>
      </a>
      <a href={`${homePath}#contacts`} data-nav-link="contacts">
        <span>Связаться с нами</span>
        <span class="nav-dot" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initHeaderAndNav() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const navLinks = document.querySelector<HTMLElement>('[data-nav-links]');
    const footer = document.querySelector<HTMLElement>('.site-footer, footer');

    if (!header) return;

    let ticking = false;

    // Cache section elements for active link tracking
    const trackedSections = [
      { id: 'services', el: document.getElementById('services') },
      { id: 'cases', el: document.getElementById('cases') },
      { id: 'reviews', el: document.getElementById('reviews') },
      { id: 'contacts', el: document.getElementById('contacts') },
    ];
    const linkElements = navLinks ? Array.from(navLinks.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')) : [];

    function updateActiveNav(currentScrollY: number, winHeight: number, maxScroll: number) {
      if (!linkElements.length) return;

      let activeSectionId: string | null = null;

      // When within top hero area, no section is active (clean hero presentation)
      if (currentScrollY > winHeight * 0.35) {
        // If scrolled close to bottom of document, activate the last section (contacts)
        if (maxScroll > 0 && maxScroll - currentScrollY < 180) {
          activeSectionId = 'contacts';
        } else {
          // Check from bottom to top of page
          for (let i = trackedSections.length - 1; i >= 0; i--) {
            const sec = trackedSections[i];
            if (sec.el) {
              const rect = sec.el.getBoundingClientRect();
              // When section top reaches upper half of viewport and bottom is still visible
              if (rect.top <= winHeight * 0.45 && rect.bottom > 80) {
                activeSectionId = sec.id;
                break;
              }
            }
          }
        }
      }

      linkElements.forEach((link) => {
        const targetId = link.getAttribute('data-nav-link');
        if (targetId && targetId === activeSectionId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    }

    function update() {
      const currentScrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const maxScroll = Math.max(0, docHeight - winHeight);

      // Header is ALWAYS visible: toggle at-top vs is-scrolled (threshold: 500px)
      if (currentScrollY <= 500) {
        header!.classList.add('at-top');
        header!.classList.remove('is-scrolled');
      } else {
        header!.classList.remove('at-top');
        header!.classList.add('is-scrolled');
      }

      // Hide header when reaching the footer
      if (footer) {
        const footerRect = footer.getBoundingClientRect();
        const headerHeight = header!.offsetHeight || 60;
        if (footerRect.top <= headerHeight) {
          header!.classList.add('is-hidden-at-footer');
        } else {
          header!.classList.remove('is-hidden-at-footer');
        }
      }

      // Active section indicator update
      updateActiveNav(currentScrollY, winHeight, maxScroll);

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    // Initial update
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAndNav);
  } else {
    initHeaderAndNav();
  }

  // Support Astro view transitions / page swaps if present
  document.addEventListener('astro:page-load', initHeaderAndNav);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    padding-block: 1.1rem;
    color: #fff;
    overflow: visible;
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 1200ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Smooth hide when reaching footer */
  .site-header.is-hidden-at-footer {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Seamless Frosted Glass Backdrop with Vertical Gradient Mask */
  .site-header::before {
    content: '';
    position: absolute;
    inset: -6px 0 -22px 0;
    z-index: -1;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    opacity: 0;
    transition: opacity 1000ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* When at top of page (overlay hero mode) */
  .site-header.at-top.overlay::before {
    opacity: 0;
  }

  /* When at top of page (non-overlay mode, e.g. case subpages) */
  .site-header.at-top:not(.overlay)::before {
    opacity: 1;
  }

  /* When scrolled down */
  .site-header.is-scrolled::before {
    opacity: 1;
  }

  /* Light Theme Overrides */
  .site-header.theme-light::before {
    background: rgba(247, 245, 242, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .site-header.theme-light.is-scrolled {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled .brand,
  .site-header.theme-light.is-scrolled .brand-text {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled nav a {
    color: #1D1D1D;
  }

  .site-header.theme-light.is-scrolled nav a:hover {
    color: var(--accent, #FD4B32);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    z-index: 60;
    color: #fff;
    transition:
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .brand-text {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    transition: color 0.2s ease;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.75rem, 2.5vw, 2.25rem);
    transition: opacity 0.25s ease;
    position: relative;
  }

  nav a {
    position: relative;
    font-size: clamp(0.75rem, 1.6vw, 0.95rem);
    text-decoration: none;
    color: #fff;
    padding-block: 0.35rem;
    padding-inline: 0.15rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
    transition:
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Micro-interaction: Soft dimming of sibling menu items on hover */
  nav:hover a {
    opacity: 0.45;
  }

  nav a:hover {
    opacity: 1 !important;
    color: #82f2c9;
    transform: translateY(-1px);
  }

  .site-header.theme-light nav:hover a {
    opacity: 0.4;
  }

  .site-header.theme-light nav a:hover {
    opacity: 1 !important;
    color: var(--accent, #FD4B32);
  }

  .site-header.theme-light.at-top nav a:hover {
    color: #FFDBD7;
  }

  /* Micro-interaction: Neat dot indicator under active section */
  .nav-dot {
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%) scale(0);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #82f2c9;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 6px rgba(130, 242, 201, 0.6);
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1.2),
      opacity 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  nav a.is-active .nav-dot {
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }

  .site-header.theme-light nav a.is-active .nav-dot {
    background-color: var(--accent, #FD4B32);
    box-shadow: 0 0 6px rgba(253, 75, 50, 0.5);
  }

  .site-header.theme-light.at-top nav a.is-active .nav-dot {
    background-color: #FFDBD7;
    box-shadow: 0 0 6px rgba(255, 219, 215, 0.6);
  }

  @media (max-width: 40rem) {
    nav a[data-nav-link="services"] {
      display: none;
    }
  }

  @media (max-width: 28rem) {
    nav a[data-nav-link="reviews"] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand,
    nav,
    nav a,
    .nav-dot {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
