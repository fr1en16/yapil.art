---
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import AboutCompact from '../AboutCompact.astro';
import ServicesAnimatedModal from '../ui/services-animated-modal';
import Contacts from '../Contacts.astro';
import Footer from '../Footer.astro';
import '../../styles/proposal-pages.css';

interface Item {
  slug: string;
  number: string;
  name: string;
  heroH1: string;
  metrics: { label: string; text: string }[];
}

interface Props {
  title: string;
  description: string;
  jsonLd: Record<string, unknown>;
  section: 'services' | 'solutions';
  heading: string;
  lead: string;
  items: Item[];
  catalogTitle: string;
  contactsTitle: string;
  contactsLead: string;
  source: 'contacts_form';
}

const { title, description, jsonLd, section, heading, lead, items, catalogTitle, contactsTitle, contactsLead, source } = Astro.props;
const isServices = section === 'services';
const serviceImages: Record<string, string> = {
  websites: 'https://media.yapil.art/services/sites.d7a0bf3e30b3f1df.webp',
  identity: 'https://media.yapil.art/services/identity.7f63efde96bd547f.webp',
  print: 'https://media.yapil.art/services/polygraphy.de6b0b9d86fc262c.webp',
  smm: 'https://media.yapil.art/services/smm.6daf973a8ce29345.webp',
  presentations: 'https://media.yapil.art/services/presentations.4d39d5565335b0b1.webp',
  support: 'https://media.yapil.art/services/support.5dc90c0aa5331630.webp',
};
const catalogItems = items.map((item) => ({
  id: item.slug,
  number: item.number,
  title: item.name,
  description: item.heroH1,
  price: '',
  caseBadge: '',
  caseLink: `/${section}/${item.slug}`,
  image: serviceImages[item.slug] ?? serviceImages.websites,
  color: '#141416',
}));
---

<Base title={title} description={description} jsonLd={jsonLd} theme="light" navOverlay={true} bodyClass={isServices ? 'services-index-page' : undefined}>
  <article class="editorial-page">
    {isServices ? (
      <>
        <Hero title={heading} description={lead} casesHref="#services-catalog" ctaText="Выбрать услугу" ripple />
        <AboutCompact theme="light" catalog />
        <ServicesAnimatedModal
          client:visible
          theme="light"
          homepage
          sectionId="services-catalog"
          typographyOff
          heading={catalogTitle}
          intro="Выберите направление — на странице каждой услуги подробно рассказали о формате, процессе и результате."
          items={catalogItems}
        />
      </>
    ) : (
    <header class="editorial-cover">
      <div class="container editorial-cover__inner">
        <div class="editorial-title-wrap">
          <h1>{heading}</h1>
        </div>
        <div class="editorial-cover__bottom">
          <p class="editorial-lead">{lead}</p>
          <dl class="editorial-meta">
            <div><dt>Формат</dt><dd>{isServices ? 'Услуги студии' : 'Решения по нишам'}</dd></div>
            <div><dt>География</dt><dd>Казахстан / Весь мир</dd></div>
            <div><dt>Связь</dt><dd>Ответим в течение 2 часов</dd></div>
          </dl>
        </div>
      </div>
    </header>
    )}

    <div class="editorial-body">
      {!isServices && <section class="editorial-section" aria-labelledby="catalog-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">01</p>
          <div class="editorial-heading__content">
            <h2 id="catalog-title">{catalogTitle}</h2>
          </div>
        </header>
        <div class="editorial-grid">
          {items.map((item) => (
            <a class="editorial-card" href={`/${section}/${item.slug}`}>
              <span class="editorial-card__number">{item.number} / ↗</span>
              <h2>{item.name}</h2>
              <p>{item.heroH1}</p>
            </a>
          ))}
        </div>
      </section>}

      <section class="editorial-section" aria-labelledby="principles-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">{isServices ? '01' : '02'}</p>
          <div class="editorial-heading__content"><h2 id="principles-title">Принципы работы</h2></div>
        </header>
        <ol class="editorial-list">
          <li class="editorial-row"><span class="editorial-row__number">01</span><h3>Погружаемся в задачу</h3><p>Разбираем продукт, аудиторию и контекст до первого визуального решения.</p></li>
          <li class="editorial-row"><span class="editorial-row__number">02</span><h3>Проектируем систему</h3><p>Связываем смысл, дизайн и технологию в цельный инструмент для бизнеса.</p></li>
          <li class="editorial-row"><span class="editorial-row__number">03</span><h3>Доводим до запуска</h3><p>Готовим все материалы, проверяем качество и сопровождаем внедрение.</p></li>
        </ol>
      </section>

      {isServices && (
        <section class="editorial-section" aria-labelledby="cities-title">
          <header class="editorial-heading">
            <p class="editorial-heading__number">02</p>
            <div class="editorial-heading__content"><h2 id="cities-title">Услуги по городам Казахстана</h2></div>
          </header>
          <div class="editorial-grid">
            <a class="editorial-card" href="/cities">
              <span class="editorial-card__number">15 городов / ↗</span>
              <h2>Выбрать город</h2>
              <p>Страницы услуг для Алматы, Астаны, Шымкента и других приоритетных рынков Казахстана.</p>
            </a>
            <a class="editorial-card" href="/cities/almaty"><span class="editorial-card__number">01 / ↗</span><h2>Алматы</h2><p>Все услуги студии, условия работы и релевантные проекты.</p></a>
            <a class="editorial-card" href="/cities/astana"><span class="editorial-card__number">02 / ↗</span><h2>Астана</h2><p>Все услуги студии, условия работы и релевантные проекты.</p></a>
            <a class="editorial-card" href="/cities/shymkent"><span class="editorial-card__number">03 / ↗</span><h2>Шымкент</h2><p>Все услуги студии, условия работы и релевантные проекты.</p></a>
          </div>
        </section>
      )}

    </div>

    <Contacts theme="light" title={contactsTitle} lead={contactsLead} source={source} sourceDetails={isServices ? 'Каталог услуг' : 'Каталог отраслевых решений'} gradientToDark />
  </article>
  <Footer slot="footer" theme="dark" />
</Base>

<style>
  :global(body.services-index-page) {
    --page-neutral-surface: #f5f5f5;
    --bg-primary: #f5f5f5;
    --bg-card: #f5f5f5;
    --bg-section-light: #f5f5f5;
  }

  :global(body.services-index-page [class~="bg-white/80"]) {
    background-color: #f5f5f5 !important;
  }

  :global(body.services-index-page .editorial-page) {
    --paper: #f5f5f5;
    --editorial-muted: #1d1d1d;
  }

  :global(body.services-index-page .hero-cover .hero-layer--title) {
    max-width: 12ch;
    margin-inline: auto;
  }

  :global(body.services-index-page #services-catalog) {
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  :global(body.services-index-page #services-catalog h2),
  :global(body.services-index-page .editorial-heading h2) {
    color: #fd4b32;
  }

  :global(body.services-index-page #services-catalog p),
  :global(body.services-index-page #services-catalog .homepage-service-description) {
    color: #1d1d1d;
  }

  :global(body.services-index-page .editorial-body) {
    display: flow-root;
  }

  :global(body.services-index-page .editorial-section:first-child) {
    padding-top: clamp(4rem, 7vw, 7rem);
  }

  :global(body.services-index-page .editorial-row) {
    min-height: clamp(8rem, 12vw, 11rem);
  }

  :global(body.services-index-page .editorial-row h3) {
    color: #fd4b32;
    font-size: clamp(1.8rem, 3vw, 3rem);
  }
</style>
