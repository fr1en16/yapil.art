---
const projects = [
  {name:'Kirpi', tags:'Интернет-магазин', image:'https://media.yapil.art/case/kirpi-cover.182cc9120e9bbe71.webp', slug:'kirpi', alt:'Интернет-магазин модного бренда Kirpi'},
  {name:'Shanding', tags:'Дизайн, сайт, полиграфия', image:'https://media.yapil.art/case/shanding.d6eb5d5dc754711d.webp', slug:'shanding', alt:'Сайт и визуальный стиль логистической компании Shanding'},
  {name:'Compass', tags:'Брендинг, дизайн, сайт', image:'https://media.yapil.art/case/compass.43224367a0a82ebc.webp', slug:'compass', alt:'Айдентика и сайт консалтинговой компании Compass'},
];
---
<section class="selected-web-projects" id="work" aria-labelledby="work-title" data-selected-work>
  <div class="work-pin">
    <div class="work-left">
      <h2 id="work-title">Избранные<br />проекты</h2>
      <p class="mobile-work-intro">От идеи до запуска — проекты, в которых дизайн решает задачу бизнеса.</p>
      <div class="work-list" aria-label="Выбор проекта">
        {projects.map((project,i)=><button class="work-item" type="button" data-project={i} aria-controls={`project-${i}`} aria-label={`Показать проект ${project.name}`}><span class="project-number">0{i+1}.</span><span class="project-name">{project.name}</span><span class="project-tags">{project.tags}</span></button>)}
      </div>
    </div>
    <div class="work-images">
      <p class="work-intro">От идеи до запуска — проекты, в которых дизайн решает задачу бизнеса.</p>
      <div class="mobile-slides">
        {projects.map((project,i)=><a class="work-slide" id={`project-${i}`} href={`/case/${project.slug}`} aria-label={`Смотреть кейс ${project.name}`} data-mobile-slide={i} data-name={project.name} data-tags={project.tags} data-slug={project.slug}><img src={project.image} alt={project.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></a>)}
      </div>
      <div class="mobile-project-meta" aria-live="polite">
        <p class="mobile-project-tags">{projects[0].tags}</p>
        <div class="mobile-project-row">
          <a class="mobile-project-link" href={`/case/${projects[0].slug}`}>{projects[0].name} ↗</a>
          <div class="mobile-project-nav" aria-label="Навигация по проектам">
            <button type="button" data-mobile-prev aria-label="Предыдущий проект">←</button>
            <span class="mobile-project-count">01</span>
            <button type="button" data-mobile-next aria-label="Следующий проект">→</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

function initSelectedWork(){
  document.querySelectorAll<HTMLElement>('[data-selected-work]').forEach((root)=>{
    if(root.dataset.ready)return;root.dataset.ready='true';
    gsap.registerPlugin(ScrollTrigger);
    const media=gsap.matchMedia();
    media.add('(max-width: 991px)',()=>{
      const slides=gsap.utils.toArray<HTMLAnchorElement>('[data-mobile-slide]',root);
      const tags=root.querySelector<HTMLElement>('.mobile-project-tags');
      const link=root.querySelector<HTMLAnchorElement>('.mobile-project-link');
      const count=root.querySelector<HTMLElement>('.mobile-project-count');
      const previous=root.querySelector<HTMLButtonElement>('[data-mobile-prev]');
      const next=root.querySelector<HTMLButtonElement>('[data-mobile-next]');
      if(!slides.length||!tags||!link||!count||!previous||!next)return;
      let active=0;
      const show=(index:number)=>{
        active=(index+slides.length)%slides.length;
        slides.forEach((slide,i)=>{
          const selected=i===active;
          slide.classList.toggle('is-active',selected);
          slide.inert=!selected;
          slide.setAttribute('aria-hidden',String(!selected));
        });
        const selected=slides[active];
        tags.textContent=selected.dataset.tags||'';
        link.textContent=`${selected.dataset.name||''} ↗`;
        link.href=`/case/${selected.dataset.slug||''}`;
        count.textContent=String(active+1).padStart(2,'0');
      };
      const onPrevious=()=>show(active-1);
      const onNext=()=>show(active+1);
      previous.addEventListener('click',onPrevious);
      next.addEventListener('click',onNext);
      let startX=0;
      const onPointerDown=(event:PointerEvent)=>{startX=event.clientX};
      const onPointerUp=(event:PointerEvent)=>{const distance=event.clientX-startX;if(Math.abs(distance)>42)show(active+(distance<0?1:-1))};
      const slideFrame=root.querySelector<HTMLElement>('.mobile-slides');
      slideFrame?.addEventListener('pointerdown',onPointerDown);
      slideFrame?.addEventListener('pointerup',onPointerUp);
      show(0);
      return()=>{previous.removeEventListener('click',onPrevious);next.removeEventListener('click',onNext);slideFrame?.removeEventListener('pointerdown',onPointerDown);slideFrame?.removeEventListener('pointerup',onPointerUp);slides.forEach(slide=>{slide.inert=false;slide.removeAttribute('aria-hidden')})};
    });
    media.add('(min-width: 992px) and (prefers-reduced-motion: no-preference)',()=>{
      const items=gsap.utils.toArray<HTMLButtonElement>('.work-item',root);
      const slides=gsap.utils.toArray<HTMLAnchorElement>('.work-slide',root);
      const images=slides.map(slide=>slide.querySelector('img')!);
      const transition=.8;
      const fade=.28;
      const dim=.28;
      const hidden='polygon(100% 100%,100% 100%,100% 100%,100% 100%)';
      const full='polygon(0% 0%,100% 0%,100% 101%,0% 101%)';
      gsap.set(items,{opacity:dim,willChange:'opacity'});
      gsap.set(slides,{clipPath:hidden,willChange:'clip-path'});
      gsap.set(images,{scale:1.1,transformOrigin:'50% 50%',force3D:true,willChange:'transform'});
      const timeline=gsap.timeline({defaults:{duration:transition,ease:'power2.inOut'}});
      timeline.addLabel('top',0)
        .to(slides[0],{clipPath:full},0)
        .to(images[0],{scale:1,ease:'none'},0)
        .to(items[0],{opacity:1,duration:fade,ease:'none'},0)
        .addLabel('s0',1);
      for(let i=1;i<slides.length;i++){
        const at=i;
        timeline.to(slides[i],{clipPath:full},at)
          .to(images[i],{scale:1,ease:'none'},at)
          .to(images[i-1],{scale:1.2,ease:'none'},at)
          .to(items[i-1],{opacity:dim,duration:fade,ease:'none'},at)
          .to(items[i],{opacity:1,duration:fade,ease:'none'},at)
          .addLabel(`s${i}`,i+1);
      }
      const end=slides.length;
      timeline.to({}, {duration:.01},end-.01);
      const duration=timeline.duration();
      const snapPoints=Object.values(timeline.labels).map(time=>time/duration).sort((a,b)=>a-b);
      let active=-1;const update=()=>{const next=Math.max(0,Math.min(slides.length-1,Math.ceil(timeline.time())-1));if(next===active)return;active=next;slides.forEach((slide,i)=>{slide.inert=i!==active;items[i].setAttribute('aria-pressed',String(i===active))})};timeline.eventCallback('onUpdate',update);update();
      const trigger=ScrollTrigger.create({trigger:root,pin:true,pinSpacing:true,anticipatePin:1,animation:timeline,start:'top top',end:()=>`+=${Math.round(innerHeight*end)}`,scrub:.8,invalidateOnRefresh:true,snap:{snapTo:(_value,self)=>{const progress=gsap.utils.clamp(0,1,(self.scroll()-self.start)/(self.end-self.start));let lower=snapPoints[0],upper=snapPoints.at(-1)!;for(let i=0;i<snapPoints.length-1;i++){if(progress>=snapPoints[i]&&progress<=snapPoints[i+1]){lower=snapPoints[i];upper=snapPoints[i+1];break}}if(lower===upper)return lower;const local=(progress-lower)/(upper-lower);return self.direction>0?(local>=.2?upper:lower):(local<=.8?lower:upper)},duration:{min:.35,max:.55},delay:.08,ease:'power1.inOut',inertia:false}});
      const handlers=items.map((item,i)=>{const listener=()=>{const time=timeline.labels[`s${i}`];const top=trigger.start+(trigger.end-trigger.start)*time/duration;window.scrollTo({top,behavior:'smooth'})};item.addEventListener('click',listener);return listener});
      return()=>{items.forEach((item,i)=>item.removeEventListener('click',handlers[i]));slides.forEach(slide=>slide.inert=false)};
    });
  });
  ScrollTrigger.refresh();
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initSelectedWork,{once:true});else initSelectedWork();
document.addEventListener('astro:page-load',initSelectedWork);
</script>

<style>
.selected-web-projects{height:100svh;margin-top:clamp(72px,8vw,120px);color:#fd4b32;font-family:'Inter Tight Variable',Arial,sans-serif}.work-pin{position:relative;height:100svh;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);overflow:hidden}.work-left{grid-column:span 5;padding:50px 0 16px;display:flex;flex-direction:column;justify-content:space-between;min-width:0}.work-left h2{margin:0;font:400 clamp(64px,7.4vw,124px)/.98 Oranienbaum,Georgia,serif;letter-spacing:-.035em}.work-list{margin-top:50px}.work-item{display:flex;align-items:center;gap:16px;width:100%;padding:22px 0;border:0;border-bottom:1px solid currentColor;background:transparent;color:inherit;text-align:left;cursor:pointer;font:inherit}.work-item:last-child{border-bottom:0}.project-number{font:14px ui-monospace,monospace}.project-name{font:400 clamp(28px,2.5vw,48px)/1 Oranienbaum,serif}.project-tags{margin-left:auto;font:11px ui-monospace,monospace;text-transform:uppercase;text-align:right;max-width:45%}.work-images{grid-column:span 7;position:relative;min-width:0;height:100%;background:#f5f5f5}.work-slide{position:absolute;inset:0;overflow:hidden;text-decoration:none;will-change:clip-path;clip-path:polygon(100% 100%,100% 100%,100% 100%,100% 100%)}.work-slide:not(:first-child){clip-path:polygon(100% 100%,100% 100%,100% 100%,100% 100%)}.work-slide img{width:100%;height:100%;object-fit:cover;display:block;will-change:transform}.project-cta{position:absolute;left:50%;top:60%;width:76px;height:76px;display:grid;place-items:center;border-radius:50%;transform:translate(-50%,-50%);opacity:0;background:#fd4b32;color:#f5f5f5;font-size:32px;transition:opacity .25s}.work-slide:hover .project-cta,.work-slide:focus-visible .project-cta{opacity:1}.mobile-caption{display:none}
.work-intro,.mobile-work-intro,.mobile-project-meta{display:none}.mobile-slides{display:contents}
@media(min-width:992px){.work-images{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:var(--grid-gap)}.work-intro{display:block;grid-column:3/span 2;margin:50px 0 0;font-size:clamp(16px,1.15vw,20px);line-height:1.16;letter-spacing:-.015em;max-width:22ch}}
@media(max-width:991px){.selected-web-projects{height:auto;margin-top:72px}.work-pin{position:relative;height:auto;display:block;overflow:visible}.work-left{padding:0}.work-left h2{font-size:clamp(58px,15vw,92px);line-height:.9}.work-list{display:none}.mobile-work-intro{display:block;width:72%;margin:28px 0 0 auto;font-size:16px;line-height:1.2}.work-images{display:block;height:auto;margin-top:30px;background:transparent}.work-intro{display:none}.mobile-slides{display:grid;position:relative;aspect-ratio:1/.96;overflow:hidden;background:#f5f5f5}.work-slide,.work-slide:not(:first-child){grid-area:1/1;position:relative;height:100%;min-height:0;opacity:0;visibility:hidden;pointer-events:none;clip-path:none!important;transition:opacity .35s ease,visibility .35s ease}.work-slide.is-active{opacity:1;visibility:visible;pointer-events:auto}.work-slide img{height:100%;object-fit:cover;transform:none!important}.mobile-project-meta{display:block;padding-top:14px}.mobile-project-tags{margin:0 0 8px;font:11px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.04em}.mobile-project-row{display:flex;align-items:center;justify-content:space-between;gap:16px}.mobile-project-link{font:400 34px/1 Oranienbaum,Georgia,serif;text-decoration:none}.mobile-project-nav{display:flex;align-items:center;gap:8px;padding:5px 9px;border:1px solid currentColor;border-radius:50%}.mobile-project-nav button{display:grid;place-items:center;width:28px;height:28px;padding:0;border:0;background:transparent;color:inherit;font-size:20px;line-height:1;cursor:pointer}.mobile-project-count{min-width:20px;text-align:center;font:13px ui-monospace,monospace}.project-cta,.mobile-caption{display:none}}
@media(max-width:520px){.mobile-slides{aspect-ratio:1/.98}}
@media(prefers-reduced-motion:reduce){.selected-web-projects{height:auto}.work-pin{position:relative;height:auto}.work-list{display:none}.work-images{display:grid;height:auto;gap:16px}.work-slide,.work-slide:not(:first-child){position:relative;height:75svh;clip-path:none!important}.mobile-caption{display:block;position:absolute;bottom:0;padding:20px;color:#f5f5f5;background:linear-gradient(transparent,#0009)}}
</style>
