---
import Base from '../../layouts/Base.astro';
import Contacts from '../Contacts.astro';
import Footer from '../Footer.astro';
import ProduxPortfolio from '../ProduxPortfolio.astro';
import '../../styles/proposal-pages.css';

interface Metric { number: string; label: string; text: string; }
interface Card { title: string; text: string; }
interface Row { number: string; title: string; text: string; }
interface Faq { question: string; answer: string; }
interface Link { slug: string; number: string; title: string; description: string; }

interface Props {
  title: string;
  description: string;
  jsonLd: Record<string, unknown>;
  section: 'services' | 'solutions';
  slug: string;
  name: string;
  heroH1: string;
  heroLead: string;
  metrics: Metric[];
  firstTitle: string;
  firstCards: Card[];
  secondTitle: string;
  secondCards: Card[];
  rowsTitle?: string;
  rows?: Row[];
  casesTitle: string;
  caseSlugs: string[];
  faqTitle: string;
  faq: Faq[];
  linksTitle?: string;
  links?: Link[];
  ctaTitle: string;
  ctaLead: string;
}

const props = Astro.props;
const { section, slug, name, heroH1, heroLead, metrics, firstTitle, firstCards, secondTitle, secondCards, rowsTitle, rows = [], casesTitle, caseSlugs, faqTitle, faq, linksTitle, links = [], ctaTitle, ctaLead } = props;
const source = 'contacts_form';
const hasProcessWork = section === 'services' && slug === 'websites' && Astro.slots.has('process-work');
const sectionName = section === 'services' ? 'Услуга' : 'Решение';
const deadline = metrics.find((metric) => /срок/iu.test(metric.label))?.text ?? 'фиксируем после короткого брифа';
const result = secondCards[0]?.title ?? secondTitle;
const processNumber = section === 'services' ? '04' : '03';
const faqNumber = section === 'services' ? (rows.length ? '05' : '04') : (rows.length ? '04' : '03');
const linksNumber = section === 'services' ? '06' : '05';
---

<Base title={props.title} description={props.description} jsonLd={props.jsonLd} theme="light" navOverlay={true}>
  <article class="editorial-page">
    <header class="editorial-cover">
      <div class="container editorial-cover__inner">
        <div class="editorial-title-wrap">
          <h1>{heroH1}</h1>
        </div>
        <div class="editorial-cover__bottom">
          <p class="editorial-lead">{heroLead}</p>
          <dl class="editorial-meta">
            {metrics.map((metric) => <div><dt>{metric.label}</dt><dd>{metric.text}</dd></div>)}
          </dl>
        </div>
      </div>
    </header>

    {hasProcessWork && <slot name="process-work" />}

    <div class="editorial-body">
      <section class="editorial-section" id="scope" aria-labelledby="scope-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">01</p>
          <div class="editorial-heading__content">
            <h2 id="scope-title">{firstTitle}</h2>
          </div>
        </header>
        <div class="editorial-grid">
          {firstCards.map((card, index) => (
            <article class="editorial-card">
              <span class="editorial-card__number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3><p>{card.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="editorial-section" aria-labelledby="result-title">
        <header class="editorial-heading">
          <p class="editorial-heading__number">02</p>
          <div class="editorial-heading__content"><h2 id="result-title">{secondTitle}</h2></div>
        </header>
        <div class="editorial-grid">
          {secondCards.map((card, index) => (
            <article class="editorial-card"><span class="editorial-card__number">{String(index + 1).padStart(2, '0')}</span><h3>{card.title}</h3><p>{card.text}</p></article>
          ))}
        </div>
      </section>

      {section === 'services' && (
        <section class="editorial-section" aria-labelledby="process-title">
          <header class="editorial-heading"><p class="editorial-heading__number">03</p><div class="editorial-heading__content"><h2 id="process-title">Цена, срок и результат</h2></div></header>
          <div class="editorial-grid">
            <article class="editorial-card"><span class="editorial-card__number">01</span><h3>Стоимость</h3><p>Готовим персональную смету после короткого брифа и фиксируем состав работ до старта.</p></article>
            <article class="editorial-card"><span class="editorial-card__number">02</span><h3>Срок</h3><p>{deadline}. Календарь и точки согласования входят в предложение.</p></article>
            <article class="editorial-card"><span class="editorial-card__number">03</span><h3>Результат</h3><p>{result}. Полный комплект и правила передачи описываем в договоре.</p></article>
          </div>
        </section>
      )}

      {!hasProcessWork && rows.length > 0 && rowsTitle && (
        <section class="editorial-section" aria-labelledby="steps-title">
          <header class="editorial-heading"><p class="editorial-heading__number">{processNumber}</p><div class="editorial-heading__content"><h2 id="steps-title">Как мы делаем: {rowsTitle.toLocaleLowerCase('ru')}</h2></div></header>
          <ol class="editorial-list">{rows.map((row) => <li class="editorial-row"><span class="editorial-row__number">{row.number}</span><h3>{row.title}</h3><p>{row.text}</p></li>)}</ol>
        </section>
      )}

    </div>
    {!hasProcessWork && <ProduxPortfolio theme="light" title={casesTitle} projectSlugs={caseSlugs} seamless />}
    <div class="editorial-body">
      <section class="editorial-section" aria-labelledby="faq-title">
        <header class="editorial-heading"><p class="editorial-heading__number">{faqNumber}</p><div class="editorial-heading__content"><h2 id="faq-title">{faqTitle}</h2></div></header>
        <div class="editorial-faq">{faq.map((item, index) => <details open={index === 0}><summary><span>{item.question}</span><span aria-hidden="true">+</span></summary><div><p>{item.answer}</p></div></details>)}</div>
      </section>

      {links.length > 0 && linksTitle && (
        <section class="editorial-section editorial-section--compact" aria-labelledby="links-title">
          <header class="editorial-compact-header">
            <span class="editorial-compact-header__number">{linksNumber}</span>
            <h2 id="links-title">{linksTitle}</h2>
          </header>
          <div class="editorial-compact-grid">
            {links.map((link) => (
              <a class="editorial-compact-card" href={`/${section}/${link.slug}`}>
                <div class="editorial-compact-card__top">
                  <span class="editorial-compact-card__number">{link.number}</span>
                  <span class="editorial-compact-card__arrow" aria-hidden="true">↗</span>
                </div>
                <h3>{link.title}</h3>
                <p>{link.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {section === 'services' && (
        <section class="editorial-section editorial-section--compact" aria-labelledby="cities-title">
          <header class="editorial-compact-header">
            <span class="editorial-compact-header__number">07</span>
            <h2 id="cities-title">Услуга по городам Казахстана</h2>
          </header>
          <div class="editorial-compact-grid">
            <a class="editorial-compact-card" href={`/services/${slug}/almaty`}>
              <div class="editorial-compact-card__top">
                <span class="editorial-compact-card__number">01</span>
                <span class="editorial-compact-card__arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Алматы</h3>
              <p>{name} для бизнеса Алматы: условия, этапы и релевантные проекты.</p>
            </a>
            <a class="editorial-compact-card" href={`/services/${slug}/astana`}>
              <div class="editorial-compact-card__top">
                <span class="editorial-compact-card__number">02</span>
                <span class="editorial-compact-card__arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Астана</h3>
              <p>{name} для компаний Астаны: условия, этапы и релевантные проекты.</p>
            </a>
            <a class="editorial-compact-card" href={`/services/${slug}/shymkent`}>
              <div class="editorial-compact-card__top">
                <span class="editorial-compact-card__number">03</span>
                <span class="editorial-compact-card__arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Шымкент</h3>
              <p>{name} для бизнеса Шымкента: условия, этапы и релевантные проекты.</p>
            </a>
            <a class="editorial-compact-card" href="/cities">
              <div class="editorial-compact-card__top">
                <span class="editorial-compact-card__number">15 городов</span>
                <span class="editorial-compact-card__arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Вся география</h3>
              <p>Выбрать один из приоритетных рынков Казахстана.</p>
            </a>
          </div>
        </section>
      )}

    </div>

    {section === 'services' && (
      <div class="editorial-body">
        <section class="brief-cta" aria-labelledby="brief-cta-title">
          <p>Расскажите о задаче</p>
          <h2 id="brief-cta-title">Подробный<br />бриф</h2>
          <a href={`/brief?service=${slug}`}>
            <span>Заполнить бриф по услуге «{name}»</span><span aria-hidden="true">→</span>
          </a>
        </section>
      </div>
    )}

    <Contacts theme="light" title={ctaTitle} lead={ctaLead} source={source} sourceDetails={`${sectionName}: ${name}`} />
  </article>
  <Footer slot="footer" theme="light" />
</Base>

<style>
  .brief-cta { padding: clamp(5rem, 9vw, 9rem) 0; border-top: 1px solid rgba(23, 23, 23, .18); }
  .brief-cta > p { margin: 0 0 2rem; color: #fd4b32; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .brief-cta h2 { margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 7.3vw, 7.5rem); font-weight: 400; line-height: .9; letter-spacing: -.045em; }
  .brief-cta a { display: flex; justify-content: space-between; align-items: center; margin-top: clamp(3rem, 7vw, 7rem); padding: 1.5rem 0; border-block: 1px solid #171717; color: inherit; font-size: clamp(1.1rem, 2vw, 1.5rem); text-decoration: none; transition: padding 220ms ease, color 220ms ease, background 220ms ease; }
  .brief-cta a:hover,.brief-cta a:focus-visible { padding-inline: 1.5rem; color: #fff; background: #fd4b32; outline-offset: 4px; }
</style>
