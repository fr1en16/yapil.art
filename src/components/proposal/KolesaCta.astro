---
import ContactFormCard from '../ContactFormCard.astro';
---

<section class="kolesa-cta" aria-labelledby="kolesa-cta-title">
  <div class="container kolesa-grid">
    <div class="kolesa-story">
      <header class="kolesa-header">
        <h2 id="kolesa-cta-title">Превращаем<br />посетителей в заявки</h2>
        <p>Проектируем лендинги и сайты, которые ведут посетителя к заявке. Улучшаем структуру, оффер и путь, считаем результат в конверсии.</p>
      </header>

      <div class="kolesa-proof">
        <a class="kolesa-preview" href="/case/taxikolesa" aria-label="Смотреть кейс Taxi Kolesa">
          <img src="https://media.yapil.art/case/taxikolesa/couriers.aee165f780266ddc.webp" alt="Лендинг Taxi Kolesa для курьеров" width="1200" height="659" loading="lazy" decoding="async" />
        </a>
        <div class="kolesa-stat">
          <p class="kolesa-metric">27,9<span>%</span></p>
          <p class="kolesa-metric-label">Средняя конверсия лендинга</p>
          <p class="kolesa-caption">Для Taxi Kolesa сделали лендинг для курьеров. Заявку оставил почти каждый третий посетитель.</p>
        </div>
        <a class="kolesa-link" href="/case/taxikolesa">Смотреть кейс <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="kolesa-form-slot">
      <ContactFormCard
        source="case_inquiry"
        sourceDetails="CTA Taxi Kolesa на странице услуги «Сайты»"
        selectedService="Сайты"
        successText="Спасибо. Изучим задачу и ответим в течение дня."
        bordered={false}
      />
    </div>
  </div>
</section>

<style>
  .kolesa-cta {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding-block: clamp(4.5rem, 8vw, 8rem);
    background: #fd4b32;
    color: #ffffff;
  }

  .kolesa-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(20rem, .95fr);
    gap: clamp(1.5rem, 3vw, 4.5rem);
  }

  .kolesa-story { display: flex; min-width: 0; flex-direction: column; }

  .kolesa-header h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -.03em;
    color: #ffffff !important;
    font-size: clamp(3.25rem, 5.6vw, 5.8rem) !important;
    line-height: .94;
  }

  .kolesa-header > p {
    max-width: 43rem;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0;
    color: rgba(255, 255, 255, .82);
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.45;
  }

  .kolesa-proof {
    display: grid;
    grid-template-columns: clamp(14rem, 24vw, 20rem) minmax(0, 1fr);
    column-gap: clamp(1.25rem, 2.5vw, 2.5rem);
    row-gap: 1.25rem;
    align-items: start;
    margin-top: auto;
    padding-top: clamp(2.5rem, 5vw, 5rem);
  }

  .kolesa-preview {
    grid-column: 1;
    grid-row: 1;
    aspect-ratio: 1200 / 659;
    overflow: hidden;
    background: #ffdb46;
  }

  .kolesa-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1);
  }

  .kolesa-preview:hover img { transform: scale(1.035); }

  .kolesa-stat {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .kolesa-metric {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(4.25rem, 7vw, 7rem);
    line-height: .8;
    letter-spacing: -.05em;
  }

  .kolesa-metric span {
    margin-left: .15em;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: .33em;
    letter-spacing: 0;
  }

  .kolesa-metric-label {
    margin: 0;
    color: rgba(255, 255, 255, .72);
    font-size: .85rem;
  }

  .kolesa-caption {
    max-width: 34rem;
    margin: .5rem 0 0;
    color: rgba(255, 255, 255, .82);
    font-size: clamp(.95rem, 1.1vw, 1.08rem);
    line-height: 1.45;
  }

  .kolesa-link {
    grid-column: 1;
    grid-row: 2;
    width: max-content;
    padding-bottom: .45rem;
    border-bottom: 1px solid rgba(255, 255, 255, .4);
    color: #ffffff;
    text-decoration: none;
    font-size: .95rem;
  }

  .kolesa-link span { margin-left: 1rem; color: #1d1d1d; }

  .kolesa-form-slot {
    align-self: stretch;
    display: flex;
    min-width: 0;
  }

  .kolesa-form-slot :global(.feedback-card) {
    flex: 1;
  }

  @media (max-width: 56rem) {
    .kolesa-cta { min-height: 0; }
    .kolesa-grid { grid-template-columns: 1fr; }
    .kolesa-story { min-height: 44rem; }
  }

  @media (max-width: 35rem) {
    .kolesa-cta { padding-block: 4.5rem; }
    .kolesa-grid { gap: 3rem; }
    .kolesa-story { min-height: 0; }
    .kolesa-header h2 { font-size: clamp(2.75rem, 13vw, 3.5rem) !important; }
    .kolesa-header > p { margin-top: 1.75rem; font-size: 1rem; }
    .kolesa-proof { grid-template-columns: 1fr; margin-top: 3.5rem; padding-top: 2rem; row-gap: 1.5rem; }
    .kolesa-preview { grid-column: 1; grid-row: 1; }
    .kolesa-stat { grid-column: 1; grid-row: 2; }
    .kolesa-link { grid-column: 1; grid-row: 3; }
    .kolesa-metric { font-size: clamp(3.5rem, 17vw, 4.75rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kolesa-preview img { transition: none; }
  }
</style>
