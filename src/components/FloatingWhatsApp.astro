---
import { getWhatsAppUrl } from '../utils/messengerLinks';

interface Props {
  lang?: string;
  pageUrl?: string;
}

const { lang = 'ru', pageUrl = Astro.url.href } = Astro.props;
const label = lang === 'en' ? 'Contact via WhatsApp' : 'Связаться в WhatsApp';
const whatsappHref = getWhatsAppUrl({
  pageUrl,
  sourceContext: 'floating_whatsapp',
});
---

<a
  class="floating-whatsapp"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48a9 9 0 0 1-1.66-2.07c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.51-.23-.36A9.44 9.44 0 0 1 2.5 12C2.5 6.76 6.78 2.5 12.04 2.5a9.45 9.45 0 0 1 6.74 2.79A9.43 9.43 0 0 1 21.56 12c0 5.24-4.28 9.5-9.52 9.5m8.1-17.57A11.38 11.38 0 0 0 12.05.58C5.75.58.63 5.7.63 12c0 2.01.52 3.98 1.52 5.72L.53 23.63l6.05-1.59a11.43 11.43 0 0 0 5.46 1.39h.01c6.3 0 11.42-5.12 11.42-11.42 0-3.05-1.18-5.92-3.34-8.08" />
  </svg>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 48;
    display: grid;
    width: 3.75rem;
    height: 3.75rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.24);
    backdrop-filter: blur(1.25rem);
    -webkit-backdrop-filter: blur(1.25rem);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 280ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-whatsapp svg {
    width: 1.65rem;
    height: 1.65rem;
    fill: currentColor;
  }

  .floating-whatsapp:hover,
  .floating-whatsapp:focus-visible {
    color: #82f2c9;
    border-color: rgb(255 255 255 / 0.34);
    background: rgb(0 0 0 / 0.62);
    box-shadow: 0 1.15rem 2.8rem rgb(0 0 0 / 0.34);
    outline: none;
    transform: translateY(-2px) scale(1.04);
  }

  .floating-whatsapp:active {
    transform: translateY(0) scale(0.97);
  }

  @media (max-width: 40rem) {
    .floating-whatsapp {
      right: max(1rem, env(safe-area-inset-right));
      bottom: max(1rem, env(safe-area-inset-bottom));
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition: none;
    }
  }
</style>
