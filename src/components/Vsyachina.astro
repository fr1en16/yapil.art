---
import galleryItems from '../data/vsyachina-gallery.json';

interface GalleryItem {
  name: string;
  width: number;
  height: number;
  isVideo: boolean;
  url: string;
  alt: string;
  title: string;
}

const labels: Record<string, string> = {
  '2gippo': 'Gippo', BrewBox: 'BrewBox', cadillac: 'Cadillac', chevrolet: 'Chevrolet',
  gippo: 'Gippo Family', iroh: 'Iroh', lukoil: 'Lukoil', ONmacabim: 'ONmacabim',
  puma: 'Puma', RV: 'Sold Out', RVgold: 'Rykunov & Kudryashov',
  shanding: 'Shanding', takara: 'Takara',
};
const grouped = new Map<string, GalleryItem[]>();
for (const item of galleryItems as GalleryItem[]) {
  const stem = item.name.replace(/\.[^.]+$/, '');
  const prefix = stem.match(/^(.+?)-?\d+$/)?.[1] ?? stem;
  grouped.set(prefix, [...(grouped.get(prefix) ?? []), item]);
}
const groups = Array.from(grouped, ([prefix, images]) => ({
  prefix, label: labels[prefix] ?? prefix, images,
}));
type GalleryGroup = (typeof groups)[number];
const initialColumns: Array<Array<{ group: GalleryGroup; groupIndex: number }>> = Array.from({ length: 6 }, () => []);
const initialColumnHeights = Array.from({ length: 6 }, () => 0);
groups.forEach((group, groupIndex) => {
  const shortestColumn = initialColumnHeights.indexOf(Math.min(...initialColumnHeights));
  const first = group.images[0];
  initialColumns[shortestColumn].push({ group, groupIndex });
  initialColumnHeights[shortestColumn] += first.height / first.width;
});
const serializedGroups = JSON.stringify(groups).replaceAll('<', '\\u003c');
---

<section class="vsyachina section" aria-labelledby="vsyachina-title">
  <div class="container">
    <div class="vsyachina-heading">
      <h2 class="display-title" id="vsyachina-title">Всячина</h2>
      <p>Рекламные макеты, визуалы для соцсетей, полиграфия, видео.</p>
    </div>

    <div class="media-gallery" data-media-gallery>
      {initialColumns.map((column) => (
        <div class="media-column">
          {column.map(({ group, groupIndex }) => {
            const first = group.images[0];
            return (
              <article class="media-group" data-gallery-group={groupIndex}>
            <button
              class="gallery-card"
              type="button"
              aria-label={`Открыть серию «${group.label}» на весь экран`}
              style={`--media-ratio: ${first.width} / ${first.height}`}
            >
              <span class="gallery-stack">
                {group.images.map((item, itemIndex) => (
                  <span
                    class:list={['gallery-slide', { 'is-active': itemIndex === 0 }]}
                    data-gallery-slide={itemIndex}
                    data-width={item.width}
                    data-height={item.height}
                  >
                    {item.isVideo ? (
                      <video
                        src={item.url}
                        width={item.width}
                        height={item.height}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label={item.alt}
                      ></video>
                    ) : (
                      <img src={item.url} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
                    )}
                  </span>
                ))}
              </span>
              <span class="gallery-glare" aria-hidden="true"></span>
            </button>
              </article>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <dialog class="media-lightbox" data-media-lightbox aria-label="Полноэкранная медиагалерея">
    <button class="lightbox-control lightbox-close" type="button" aria-label="Закрыть">×</button>
    <button class="lightbox-control lightbox-prev" type="button" aria-label="Предыдущий материал">←</button>
    <div class="lightbox-stage" data-lightbox-stage></div>
    <button class="lightbox-control lightbox-next" type="button" aria-label="Следующий материал">→</button>
    <div class="lightbox-caption" aria-live="polite">
      <span data-lightbox-title></span><span data-lightbox-count></span>
    </div>
  </dialog>
  <script is:inline type="application/json" data-vsyachina-data set:html={serializedGroups}></script>
</section>

<script>
  interface GalleryItem { name: string; width: number; height: number; isVideo: boolean; url: string; alt: string; title: string }
  interface GalleryGroup { prefix: string; label: string; images: GalleryItem[] }

  const root = document.querySelector<HTMLElement>('.vsyachina');
  const dataNode = root?.querySelector<HTMLScriptElement>('[data-vsyachina-data]');
  const dialog = root?.querySelector<HTMLDialogElement>('[data-media-lightbox]');
  const stage = dialog?.querySelector<HTMLElement>('[data-lightbox-stage]');
  const title = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const count = dialog?.querySelector<HTMLElement>('[data-lightbox-count]');
  const gallery = root?.querySelector<HTMLElement>('[data-media-gallery]');
  const galleryGroups: GalleryGroup[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  let lightboxGroup = 0;
  let lightboxIndex = 0;
  let returnFocus: HTMLElement | null = null;

  const setActiveSlide = (card: HTMLElement, nextIndex: number) => {
    const slides = Array.from(card.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    if (!slides.length) return;
    const index = (nextIndex + slides.length) % slides.length;
    slides.forEach((slide, slideIndex) => {
      slide.classList.toggle('is-active', slideIndex === index);
      const video = slide.querySelector('video');
      if (slideIndex === index) void video?.play().catch(() => undefined);
      else video?.pause();
    });
    const active = slides[index];
    card.dataset.activeIndex = String(index);
    card.style.setProperty('--media-ratio', `${active.dataset.width} / ${active.dataset.height}`);
  };

  const renderLightbox = () => {
    if (!stage || !title || !count) return;
    const group = galleryGroups[lightboxGroup];
    const item = group?.images[lightboxIndex];
    if (!group || !item) return;
    stage.replaceChildren();
    const media = document.createElement(item.isVideo ? 'video' : 'img');
    media.className = 'lightbox-media';
    if (media instanceof HTMLVideoElement) {
      media.src = item.url; media.autoplay = true; media.controls = true; media.playsInline = true; media.volume = 0.3;
    } else {
      media.src = item.url; media.alt = item.alt; media.width = item.width; media.height = item.height;
    }
    stage.append(media);
    title.textContent = item.title;
    count.textContent = `${String(lightboxIndex + 1).padStart(2, '0')} / ${String(group.images.length).padStart(2, '0')}`;
    dialog?.querySelectorAll<HTMLElement>('.lightbox-prev, .lightbox-next').forEach((button) => {
      button.hidden = group.images.length < 2;
    });
  };

  const moveLightbox = (direction: -1 | 1) => {
    const length = galleryGroups[lightboxGroup]?.images.length ?? 0;
    if (!length) return;
    lightboxIndex = (lightboxIndex + direction + length) % length;
    renderLightbox();
    const card = root?.querySelector<HTMLElement>(`[data-gallery-group="${lightboxGroup}"] .gallery-card`);
    if (card) setActiveSlide(card, lightboxIndex);
  };

  const galleryItems = gallery
    ? Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-group]'))
      .sort((a, b) => Number(a.dataset.galleryGroup) - Number(b.dataset.galleryGroup))
    : [];
  const getColumnCount = () => {
    if (window.innerWidth >= 1280) return 6;
    if (window.innerWidth >= 960) return 4;
    if (window.innerWidth >= 640) return 3;
    return 2;
  };
  const layoutGallery = () => {
    if (!gallery) return;
    const columnCount = getColumnCount();
    if (gallery.dataset.columnCount === String(columnCount)) return;
    const columns = Array.from({ length: columnCount }, () => {
      const column = document.createElement('div');
      column.className = 'media-column';
      return column;
    });
    const heights = Array.from({ length: columnCount }, () => 0);
    galleryItems.forEach((item) => {
      const active = item.querySelector<HTMLElement>('.gallery-slide.is-active')
        ?? item.querySelector<HTMLElement>('.gallery-slide');
      const width = Number(active?.dataset.width) || 1;
      const height = Number(active?.dataset.height) || 1;
      const shortestColumn = heights.indexOf(Math.min(...heights));
      columns[shortestColumn].append(item);
      heights[shortestColumn] += height / width;
    });
    gallery.replaceChildren(...columns);
    gallery.dataset.columnCount = String(columnCount);
  };

  layoutGallery();
  let resizeFrame = 0;
  window.addEventListener('resize', () => {
    window.cancelAnimationFrame(resizeFrame);
    resizeFrame = window.requestAnimationFrame(layoutGallery);
  });

  galleryItems.forEach((groupElement) => {
    const groupIndex = Number(groupElement.dataset.galleryGroup);
    const card = groupElement.querySelector<HTMLElement>('.gallery-card');
    if (!card) return;
    groupElement.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
      const applyNativeDimensions = () => {
        if (!video.videoWidth || !video.videoHeight) return;
        const slide = video.closest<HTMLElement>('[data-gallery-slide]');
        if (!slide) return;
        slide.dataset.width = String(video.videoWidth);
        slide.dataset.height = String(video.videoHeight);
        video.width = video.videoWidth;
        video.height = video.videoHeight;
        if (slide.classList.contains('is-active')) {
          card.style.setProperty('--media-ratio', `${video.videoWidth} / ${video.videoHeight}`);
        }
      };
      if (video.readyState >= HTMLMediaElement.HAVE_METADATA) applyNativeDimensions();
      else video.addEventListener('loadedmetadata', applyNativeDimensions, { once: true });
    });
    setActiveSlide(card, 0);
    const slidesCount = groupElement.querySelectorAll('[data-gallery-slide]').length;
    if (slidesCount > 1) window.setInterval(() => {
      if (!document.hidden && !card.matches(':hover') && !dialog?.open) setActiveSlide(card, Number(card.dataset.activeIndex ?? 0) + 1);
    }, 12000 + groupIndex * 500);

    card.addEventListener('click', () => {
      returnFocus = card; lightboxGroup = groupIndex; lightboxIndex = Number(card.dataset.activeIndex ?? 0);
      renderLightbox(); dialog?.showModal(); document.body.classList.add('has-open-lightbox');
    });

    let isHovered = false;
    let animId = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let currentGlareX = 50;
    let currentGlareY = 50;
    let targetGlareX = 50;
    let targetGlareY = 50;
    let cachedRect: DOMRect | null = null;

    const updateTilt = () => {
      currentTiltX += (targetTiltX - currentTiltX) * 0.12;
      currentTiltY += (targetTiltY - currentTiltY) * 0.12;
      currentGlareX += (targetGlareX - currentGlareX) * 0.12;
      currentGlareY += (targetGlareY - currentGlareY) * 0.12;

      card.style.setProperty('--tilt-x', `${currentTiltX.toFixed(2)}deg`);
      card.style.setProperty('--tilt-y', `${currentTiltY.toFixed(2)}deg`);
      card.style.setProperty('--glare-x', `${currentGlareX.toFixed(1)}%`);
      card.style.setProperty('--glare-y', `${currentGlareY.toFixed(1)}%`);

      const delta = Math.abs(targetTiltX - currentTiltX) + Math.abs(targetTiltY - currentTiltY);
      if (isHovered || delta > 0.01) {
        animId = window.requestAnimationFrame(updateTilt);
      } else {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
        currentTiltX = 0;
        currentTiltY = 0;
        animId = 0;
      }
    };

    const startAnimation = () => {
      if (!animId) {
        animId = window.requestAnimationFrame(updateTilt);
      }
    };

    groupElement.addEventListener('pointerenter', () => {
      isHovered = true;
      cachedRect = groupElement.getBoundingClientRect();
      startAnimation();
    });

    groupElement.addEventListener('pointermove', (event) => {
      if (!cachedRect) {
        cachedRect = groupElement.getBoundingClientRect();
      }
      if (!cachedRect.width || !cachedRect.height) return;

      const x = Math.max(0, Math.min(1, (event.clientX - cachedRect.left) / cachedRect.width));
      const y = Math.max(0, Math.min(1, (event.clientY - cachedRect.top) / cachedRect.height));

      targetTiltX = (0.5 - y) * 14;
      targetTiltY = (x - 0.5) * 14;
      targetGlareX = x * 100;
      targetGlareY = y * 100;

      startAnimation();
    });

    const stopTilting = () => {
      isHovered = false;
      cachedRect = null;
      targetTiltX = 0;
      targetTiltY = 0;
      targetGlareX = 50;
      targetGlareY = 50;
      startAnimation();
    };

    groupElement.addEventListener('pointerleave', stopTilting);
    groupElement.addEventListener('mouseleave', stopTilting);
  });

  dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => moveLightbox(-1));
  dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => moveLightbox(1));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => {
    stage?.replaceChildren(); document.body.classList.remove('has-open-lightbox'); returnFocus?.focus();
  });
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') moveLightbox(-1);
    if (event.key === 'ArrowRight') moveLightbox(1);
  });
</script>

<style>
  .vsyachina {
    color: white;
    background: linear-gradient(to bottom, #A32A17 0%, #7d1f11 25%, #4a130b 50%, #29120f 75%, #1D1D1D 100%);
  }
  .vsyachina-heading {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .vsyachina-heading .display-title, .vsyachina-heading p { margin-bottom: 0; }
  .vsyachina-heading p { color: #f0cfc9; line-height: 1.3; }
  @media (min-width: 48rem) {
    .vsyachina-heading {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--grid-gap, clamp(0.5rem, 0.75vw, 0.75rem));
      align-items: baseline;
    }
    .vsyachina-heading .display-title {
      grid-column: 1 / span 7;
    }
    .vsyachina-heading p {
      grid-column: 9 / span 4;
      max-width: none;
    }
  }
  .media-gallery {
    display: flex;
    align-items: flex-start;
    gap: var(--grid-gap, clamp(0.5rem, 0.75vw, 0.75rem));
  }
  .media-gallery :global(.media-column) {
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    gap: var(--grid-gap, clamp(0.5rem, 0.75vw, 0.75rem));
  }
  .media-group { width: 100%; min-width: 0; perspective: 800px; transform-style: preserve-3d; }
  .gallery-card {
    --tilt-x: 0deg; --tilt-y: 0deg; --glare-x: 50%; --glare-y: 50%;
    position: relative; display: block; width: 100%; padding: 0; border: 0; color: white; background: #7b2012;
    cursor: zoom-in; aspect-ratio: var(--media-ratio);
    transform-style: preserve-3d;
    transform: perspective(800px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transition: aspect-ratio 1200ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 250ms ease;
    will-change: transform, aspect-ratio;
  }
  .gallery-card:hover {
    z-index: 10;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.5);
  }
  .gallery-card:focus-visible { outline-color: white; }
  .gallery-stack, .gallery-slide { position: absolute; inset: 0; display: block; overflow: hidden; width: 100%; height: 100%; }
  .gallery-slide { opacity: 0; transition: opacity 1200ms cubic-bezier(0.4, 0, 0.2, 1); }
  .gallery-slide.is-active { z-index: 1; opacity: 1; }
  .gallery-slide img, .gallery-slide video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gallery-glare {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: radial-gradient(circle 220px at var(--glare-x) var(--glare-y), rgba(255, 255, 255, 0.28), transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .gallery-card:hover .gallery-glare { opacity: 1; }
  .media-lightbox { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; color: white; background: rgb(0 0 0 / 96%); overflow: hidden; }
  .media-lightbox[open] { display: grid; grid-template-columns: 5rem minmax(0, 1fr) 5rem; grid-template-rows: minmax(0, 1fr) auto; place-items: center; }
  .media-lightbox::backdrop { background: rgb(0 0 0 / 96%); }
  .lightbox-stage { display: grid; width: 100%; height: 100%; min-height: 0; padding: 2rem; place-items: center; }
  .lightbox-stage :global(.lightbox-media) { width: auto; max-width: 100%; height: auto; max-height: calc(100dvh - 7rem); object-fit: contain; }
  .lightbox-control { z-index: 2; display: grid; width: 3rem; height: 3rem; padding: 0; border: 1px solid rgb(255 255 255 / 24%); color: white; background: rgb(0 0 0 / 45%); cursor: pointer; font-size: 1.3rem; line-height: 1; place-items: center; }
  .lightbox-control:hover { color: black; background: white; }
  .lightbox-close { position: absolute; top: 1rem; right: 1rem; font-size: 1.8rem; }
  .lightbox-caption { grid-column: 1 / -1; display: flex; width: 100%; justify-content: space-between; gap: 2rem; padding: 0 1.5rem 1.25rem; color: #b5b5b8; font-size: .75rem; letter-spacing: .04em; }
  :global(body.has-open-lightbox) { overflow: hidden; }
  @media (max-width: 39.99rem) {
    .media-lightbox[open] { grid-template-columns: 3.75rem minmax(0, 1fr) 3.75rem; }
    .lightbox-stage { padding: 4.5rem .25rem 1rem; }
    .lightbox-stage :global(.lightbox-media) { max-height: calc(100dvh - 9rem); }
    .lightbox-control { width: 2.75rem; height: 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-card, .gallery-slide { transition: none; }
    .gallery-card { transform: none; }
  }
</style>
