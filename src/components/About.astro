---
const cards = [
  {
    number: '01',
    title: '8 лет в дизайне',
    text: 'Ведём проекты в инфобизнесе и в корпоративном секторе. Лендинг для трейдера и полиграфия для сети стрит-фуда требуют разного, мы умеем и то, и другое.',
  },
  {
    number: '02',
    title: 'Полный цикл',
    text: 'Один проект ведёт один дизайнер: от первой концепции до финальной правки в типографии. Ничего не отдаём на аутсорс.',
  },
  {
    number: '03',
    title: 'Опыт агентства',
    text: 'Яков — сооснователь и ключевой дизайнер thepeak.kz. Оттуда мы принесли процессы, которые держат сроки на больших проектах.',
  },
  {
    number: '04',
    title: 'Три направления в одних руках',
    text: 'Бренд, сайт и печать делает одна команда, поэтому логотип не разъезжается с сайтом, а сайт — с буклетом.',
  },
];
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container">
    <span class="section-label">О студии</span>
    <div class="about-intro">
      <h2 class="display-title" id="about-title">Работаем с 2018 года</h2>
      <p>
        Собирали визуальные системы для LUKOIL, Cadillac, PUMA, Dodo Pizza, FAW, УАЗ и Gippo,
        а до этого выпустили бренды с нуля для Kenfasad, Boya и Compass.
      </p>
    </div>

    <ol class="about-cards">
      {cards.map((card) => (
        <li>
          <span class="card-number" aria-hidden="true">{card.number}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </li>
      ))}
    </ol>

    <div class="directions" aria-labelledby="directions-title">
      <p id="directions-title">Что делаем</p>
      <ul>
        <li>Айдентика</li>
        <li>Сайты</li>
        <li>Полиграфия</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    color: white;
    background: var(--ink-primary);
  }

  .about .section-label {
    color: var(--accent-tint);
  }

  .about-intro {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .about-intro .display-title {
    margin-bottom: 0;
    color: white;
  }

  .about-intro > p {
    max-width: 45rem;
    margin: 0;
    color: #c9c9c9;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
  }

  .about-cards {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid #444;
    list-style: none;
  }

  .about-cards li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding-block: 1.8rem;
    border-bottom: 1px solid #444;
  }

  .card-number {
    grid-row: 1 / span 2;
    color: var(--accent-tint);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    line-height: 1.15;
  }

  .about-cards p {
    max-width: 40rem;
    margin: 0;
    color: #bdbdbd;
  }

  .directions {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 8rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    color: var(--ink-primary);
    background: var(--accent-tint);
  }

  .directions > p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .directions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directions li {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .directions li:not(:last-child)::after {
    margin-left: 1.5rem;
    color: var(--accent-deep);
    content: '×';
  }

  @media (min-width: 48rem) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
      align-items: end;
    }

    .about-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-cards li:nth-child(odd) {
      padding-right: clamp(2rem, 5vw, 5rem);
      border-right: 1px solid #444;
    }

    .about-cards li:nth-child(even) {
      padding-left: clamp(2rem, 5vw, 5rem);
    }

    .directions {
      grid-template-columns: 10rem 1fr;
      align-items: start;
    }
  }
</style>
