---
import Nav from '../components/Nav.astro';
import SiteBackground from '../components/SiteBackground.astro';
import GridOverlay from '../components/GridOverlay.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  theme?: 'dark' | 'light';
}

const {
  title,
  description,
  image = 'https://media.yapil.art/me.d04a3d1afc9c1316.webp?v=2',
  type = 'website',
  jsonLd,
  theme = 'dark',
} = Astro.props;
const documentTitle = title === 'Yapil' ? 'Yapil — дизайн-студия' : `${title} — Yapil`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/light' || Astro.url.pathname === '/light/';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/oranienbaum-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/hero-cover/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Yapil" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{documentTitle}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class:list={{ 'is-home': isHome, 'theme-light': theme === 'light' }} data-theme={theme}>
    <a class="skip-link" href="#main-content">К основному содержанию</a>
    <SiteBackground />
    <Nav overlay={isHome} theme={theme} />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
    <GridOverlay />
    <SmoothScroll />
  </body>
</html>
