---
import Nav from '../components/Nav.astro';
import SiteBackground from '../components/SiteBackground.astro';
import GridOverlay from '../components/GridOverlay.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import Analytics from '@vercel/analytics/astro';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  theme?: 'dark' | 'light';
  noindex?: boolean;
  navOverlay?: boolean;
  navMinimal?: boolean;
  bodyClass?: string;
  lang?: string;
}

const defaultImage = new URL('/social-cover.webp', Astro.site).href;

const {
  title,
  description,
  image = defaultImage,
  type = 'website',
  jsonLd,
  theme = 'dark',
  noindex = false,
  navOverlay,
  navMinimal = false,
  bodyClass,
  lang = 'ru',
} = Astro.props;
const documentTitle = title.includes('Yapil')
  ? title
  : `${title} — Yapil`;
const normalizedPathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(normalizedPathname, Astro.site);
const resolvedImage = new URL(image, Astro.site).href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/light' || Astro.url.pathname === '/light/';
const isNavOverlay = navOverlay !== undefined ? navOverlay : isHome;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="Yapil" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content={theme === 'light' ? '#F7F5F2' : '#0B0B0C'} />
    <link rel="preload" href="/fonts/oranienbaum-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/hero-cover/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:site_name" content="Yapil" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:type" content={resolvedImage.endsWith('.png') ? 'image/png' : resolvedImage.endsWith('.jpg') || resolvedImage.endsWith('.jpeg') ? 'image/jpeg' : resolvedImage.endsWith('.svg') ? 'image/svg+xml' : 'image/webp'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={documentTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <title>{documentTitle}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      window.webAnalyticsBeforeSend = (event) => event.url.includes('/anal') ? null : event;
    </script>
    <Analytics />
  </head>
  <body class:list={[bodyClass, { 'is-home': isHome, 'theme-light': theme === 'light' }]} data-theme={theme}>
    <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to main content' : 'К основному содержанию'}</a>
    <SiteBackground />
    <Nav overlay={isNavOverlay} theme={theme} minimal={navMinimal} lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
    {import.meta.env.DEV && <GridOverlay />}
    <SmoothScroll />
  </body>
</html>
