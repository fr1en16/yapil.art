---
import Nav from '../components/Nav.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SiteBackground from '../components/SiteBackground.astro';
import GridOverlay from '../components/GridOverlay.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/inter-tight.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  theme?: 'dark' | 'light';
  noindex?: boolean;
  navOverlay?: boolean;
  navMinimal?: boolean;
  bodyClass?: string;
  lang?: string;
}

const defaultImage = new URL('https://media.yapil.art/social-cover.9512ed9be1051235.webp', Astro.site).href;

const {
  title,
  description,
  image = defaultImage,
  type = 'website',
  jsonLd,
  theme = 'dark',
  noindex = false,
  navOverlay,
  navMinimal = false,
  bodyClass,
  lang = 'ru',
} = Astro.props;
const documentTitle = title.includes('Yapil')
  ? title
  : `${title} — Yapil`;
const normalizedPathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(normalizedPathname, Astro.site);
const resolvedImage = new URL(image, Astro.site).href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/light' || Astro.url.pathname === '/light/';
const isNavOverlay = navOverlay !== undefined ? navOverlay : isHome;

const jsonLdGraph = Array.isArray(jsonLd?.['@graph'])
  ? jsonLd['@graph'] as Record<string, unknown>[]
  : jsonLd
    ? [jsonLd]
    : [];

const hasSchemaType = (type: string) => jsonLdGraph.some((node) => {
  const nodeType = node['@type'];
  return Array.isArray(nodeType) ? nodeType.includes(type) : nodeType === type;
});

const defaultSchemaGraph: Record<string, unknown>[] = [];

if (!hasSchemaType('WebSite')) {
  defaultSchemaGraph.push({
    '@type': 'WebSite',
    '@id': 'https://yapil.art/#website',
    name: 'Yapil',
    url: 'https://yapil.art',
    inLanguage: lang,
    publisher: { '@id': 'https://yapil.art/#organization' },
  });
}

if (!hasSchemaType('Organization') && !hasSchemaType('ProfessionalService')) {
  defaultSchemaGraph.push({
    '@type': ['Organization', 'ProfessionalService'],
    '@id': 'https://yapil.art/#organization',
    name: 'Yapil',
    url: 'https://yapil.art',
    logo: 'https://media.yapil.art/apple-touch-icon.f863e8a7cc523f9f.webp',
    email: 'hi@yapil.art',
    telephone: '+77067436197',
    areaServed: ['KZ', 'UZ', 'RU', 'Worldwide'],
  });
}

if (!hasSchemaType('BreadcrumbList')) {
  defaultSchemaGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: normalizedPathname === '/'
      ? [{ '@type': 'ListItem', position: 1, name: 'Главная', item: canonical.href }]
      : [
          { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://yapil.art' },
          { '@type': 'ListItem', position: 2, name: documentTitle, item: canonical.href },
        ],
  });
}

const schemaJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...defaultSchemaGraph, ...jsonLdGraph],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="Yapil" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content={theme === 'light' ? '#F7F5F2' : '#0B0B0C'} />
    <link rel="preload" href="https://media.yapil.art/fonts/oranienbaum-cyrillic.076ad3ef04f90d2d.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://media.yapil.art/hero-cover/dm-sans.468d56b6b25b05b7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:site_name" content="Yapil" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:type" content={resolvedImage.endsWith('.png') ? 'image/png' : resolvedImage.endsWith('.jpg') || resolvedImage.endsWith('.jpeg') ? 'image/jpeg' : resolvedImage.endsWith('.svg') ? 'image/svg+xml' : 'image/webp'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={documentTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <link rel="icon" type="image/webp" sizes="32x32" href="https://media.yapil.art/favicon-32x32.542324de3abfb085.webp" />
    <link rel="icon" type="image/webp" sizes="16x16" href="https://media.yapil.art/favicon-16x16.500353878eda36d1.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://media.yapil.art/apple-touch-icon.f863e8a7cc523f9f.webp" />
    <link rel="shortcut icon" href="https://media.yapil.art/favicon.fc586ad7fa9972d8.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{documentTitle}</title>
    <ClientRouter fallback="animate" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} />
    <script is:inline>
      window.webAnalyticsBeforeSend = (event) => event.url.includes('/anal') ? null : event;
    </script>
    <Analytics />
  </head>
  <body class:list={[bodyClass, { 'is-home': isHome, 'theme-light': theme === 'light' }]} data-theme={theme}>
    <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to main content' : 'К основному содержанию'}</a>
    <SiteBackground />
    <Nav overlay={isNavOverlay} theme={theme} minimal={navMinimal} lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
    <FloatingWhatsApp lang={lang} pageUrl={Astro.url.href} />
    {import.meta.env.DEV && <GridOverlay />}
    <SmoothScroll />
    <script>
      import { installTypographyRules } from '../scripts/typography';

      installTypographyRules();

      type LenisLike = {
        scrollTo: (target: number, options?: { immediate?: boolean; force?: boolean }) => void;
      };

      const setScrollToTop = () => {
        const pageWindow = window as typeof window & {
          lenis?: LenisLike;
          __lenisInstance?: LenisLike;
        };
        const lenis = pageWindow.__lenisInstance ?? pageWindow.lenis;

        lenis?.scrollTo(0, { immediate: true, force: true });
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        if (document.scrollingElement) document.scrollingElement.scrollTop = 0;
      };

      const resetPageScroll = () => {
        if (window.location.hash) return;

        const currentState = window.history.state;
        if (currentState && typeof currentState === 'object') {
          window.history.replaceState(
            { ...currentState, scrollX: 0, scrollY: 0 },
            '',
            window.location.href,
          );
        }

        setScrollToTop();
        requestAnimationFrame(() => {
          setScrollToTop();
          requestAnimationFrame(setScrollToTop);
        });
      };

      document.addEventListener('astro:after-swap', resetPageScroll);
      document.addEventListener('astro:page-load', resetPageScroll);
    </script>
  </body>
</html>

<style is:global>
  ::view-transition-image-pair(root) {
    isolation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-fill-mode: both;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    animation: yapil-page-out 300ms cubic-bezier(0.4, 0, 0.7, 0.2) both;
  }

  ::view-transition-new(root) {
    animation: yapil-page-in 480ms 70ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html[data-astro-transition='back']::view-transition-old(root) {
    animation-name: yapil-page-out-back;
  }

  html[data-astro-transition='back']::view-transition-new(root) {
    animation-name: yapil-page-in-back;
  }

  html[data-astro-transition-fallback='old'] {
    animation: yapil-fallback-out 180ms cubic-bezier(0.4, 0, 0.7, 0.2) both;
  }

  html[data-astro-transition-fallback='new'] {
    animation: yapil-fallback-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes yapil-page-out {
    to {
      opacity: 0;
      transform: translate3d(0, -5px, 0) scale(0.998);
    }
  }

  @keyframes yapil-page-in {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0) scale(1.002);
    }
  }

  @keyframes yapil-page-out-back {
    to {
      opacity: 0;
      transform: translate3d(0, 5px, 0) scale(0.998);
    }
  }

  @keyframes yapil-page-in-back {
    from {
      opacity: 0;
      transform: translate3d(0, -10px, 0) scale(1.002);
    }
  }

  @keyframes yapil-fallback-out {
    to {
      opacity: 0;
    }
  }

  @keyframes yapil-fallback-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
