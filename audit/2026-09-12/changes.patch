+<script>
+  let cleanup = () => {};
+
+  function initFloatingWhatsApp() {
+    cleanup();
+    const link = document.querySelector<HTMLAnchorElement>('[data-floating-whatsapp]');
+    if (!link) return;
+
+    // These blocks already contain contacts or dense controls and information.
+    const visibleBlocks = new Set<Element>();
+    const observer = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (entry.isIntersecting) visibleBlocks.add(entry.target);
+        else visibleBlocks.delete(entry.target);
+      }
+      link.hidden = visibleBlocks.size > 0;
+    });
+    document.querySelectorAll('main form, main dl, #contacts, footer').forEach((block) => observer.observe(block));
+    cleanup = () => observer.disconnect();
+  }
+
+  initFloatingWhatsApp();
+  document.addEventListener('astro:page-load', initFloatingWhatsApp);
+  document.addEventListener('astro:before-swap', () => cleanup());
+</script>
+
 <style>
+  .floating-whatsapp[hidden] {
+    display: none;
+  }
